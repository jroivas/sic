// Namespaced access (`module::sym`) + a renamed selective import.
import math;
import math::sq as square;
int main() {
    int a = math::sq(5);           // 25
    int b = square(4);             // 16 (renamed selective import)
    int m = math::meaning;         // 42 (exported global, scope form)
    if (a != 25 || b != 16 || m != 42) return 1;
    return math::addv(a, b) - 41;  // 0
}
