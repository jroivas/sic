import shapes;
// A plain `import shapes;` keeps enums namespaced: use `shapes::Enum::Variant`.
int main() {
    int c = (int)shapes::Color::Green;          // 5
    auto sq = shapes::Shape::Square(4);          // construct imported tagged enum
    int a = shapes::Shapes::area(sq);            // 16
    auto ci = shapes::Shapes::circle(2);
    int b = shapes::Shapes::area(ci);            // 12
    return c + a + b - 33;                        // 0
}
