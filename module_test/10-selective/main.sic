import gmath::gadd;            // just gadd, unqualified
import gmath::base as b;       // a global under another name
int main() {
    int s = gadd(10, 5);       // bare OK (selectively imported)
    int m = gmath::gmax(9, 2); // gmax still only namespaced -> qualified
    b += 4;                    // written through the alias
    if (gmath::base != 24) return 1;
    return s + m - b;          // 15+9-24 = 0
}
