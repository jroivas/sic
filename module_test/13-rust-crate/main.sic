import std;
import rsdemo;

int main() {
    rsdemo::Counter c;                         // Counter::new() as constructor
    if (c.name() != "anon") return 1;
    c.add(5);
    if (c.add(2) != 7) return 2;

    rsdemo::Counter d = rsdemo::Counter::named("d");
    d.add(30);
    d.merge(c);                                // &Counter parameter
    if (d.get() != 37) return 3;
    rsdemo::Counter e = d;                     // a copy shares the object
    e.add(3);
    if (d.get() != 40) return 4;
    rsdemo::Counter q = d.split(4) else return 5;
    std::Println("{} {}", q.name(), q.get());  // d/4 10
    match (d.split(0)) { Some(x): return 6; None: {} }
    if (rsdemo::total(q, 1) != 11) return 7;

    std::Println("{}", rsdemo::greet("sic"));
    std::Println("{}", rsdemo::shout("loud"));
    if (rsdemo::len_ref("four") != 4) return 8;
    if (rsdemo::checksum("\x01\x02\xff") != 258) return 9;
    if (rsdemo::reverse_bytes("abc") != "cba") return 10;

    list<i64> xs; xs.add(1); xs.add(2); xs.add(39);
    if (rsdemo::sum(xs) != 42) return 11;
    list<i32> ys; ys.add(4); ys.add(-5);
    rsdemo::double_all(ys);                     // &mut [i32]: written back
    if (ys[0] != 8 || ys[1] != -10) return 12;

    list<string> w = rsdemo::words("  one two  three ");
    if (w.length != 3 || w[2] != "three") return 13;
    list<string> parts = rsdemo::words_ref("a,b");
    std::Println("{}", rsdemo::join(w, "+") + " " + parts[1]);
    list<u64> sq = rsdemo::squares(4);
    if (sq.length != 4 || sq[3] != 16) return 14;

    i64 n = rsdemo::parse_int(" 123 ") else return 15;
    if (n != 123) return 16;
    match (rsdemo::parse_int("x")) {
        Ok(v): return 17;
        Err(msg): std::Println("{}", msg);     // invalid digit found in string
    }
    bool ok = rsdemo::check(true) else return 18;
    match (rsdemo::check(false)) { Ok(v): return 19; Err(msg): std::Println("{}", msg); }
    i32 u = rsdemo::unit_err(4) else return 20;
    if (u != 40) return 21;
    match (rsdemo::unit_err(-1)) { Ok(v): return 22; Err(msg): std::Println("{}", msg); }

    u8char ch = rsdemo::first_char("é!") else return 23;
    if (ch != 233) return 24;
    if (rsdemo::next_char('a') != 'b') return 25;
    match (rsdemo::first_char("")) { Some(x): return 26; None: {} }
    if (rsdemo::half(5.0) != 2.5 || !rsdemo::is_even(10)) return 27;

    // Rust modules are namespaces; `pub use` re-exports are the same item.
    rsdemo::geo::Point p = rsdemo::geo::Point::new(3, 4);
    rsdemo::Point o = rsdemo::zero();                // geo::origin, re-exported
    rsdemo::Point r = rsdemo::Point::new(1, 1).add(p);   // geo::Point::new via the alias
    if (p.dist2() != 25 || o.dist2() != 0 || r.dist2() != 41) return 28;
    if (rsdemo::geo::DIM != 2 || rsdemo::DIM != 2 || rsdemo::NAME != "rsdemo" || rsdemo::SCALE != -2.5) return 29;
    return 0;
}
