// Integer matrix multiply (N x N), i-k-j order, in idiomatic SIC: heap arrays from
// `new T[count]` released with `defer del`, and native fixed-width element (i32) and
// accumulator (i64) types. The flat matrices are heap arrays — the idiomatic SIC
// choice for dense numeric data (boxed containers would cost per-element overhead in
// the ~1e9-iteration inner loop). Prints a checksum (sum of the product).
#include <stdio.h>

#define N 1024

int main() {
    i32 *a = new i32[N * N];
    i32 *b = new i32[N * N];
    i32 *c = new i32[N * N];
    defer del a;
    defer del b;
    defer del c;

    for (i32 i = 0; i < N * N; i++) {
        a[i] = (i * 7 + 1) % 100;
        b[i] = (i * 3 + 2) % 100;
        c[i] = 0;
    }
    for (i32 i = 0; i < N; i++)
        for (i32 k = 0; k < N; k++) {
            i32 aik = a[i * N + k];
            for (i32 j = 0; j < N; j++)
                c[i * N + j] += aik * b[k * N + j];
        }
    i64 sum = 0;
    for (i32 i = 0; i < N * N; i++) sum += c[i];
    printf("%ld\n", sum);
    return 0;
}
