// Integer matrix multiply (N x N), i-k-j order, in idiomatic SIC: heap buffers
// released with `defer`, native fixed-width element (i32) and accumulator (i64)
// types, and no C-style casts. The flat matrices are heap arrays — the idiomatic
// SIC choice for dense numeric data (boxed containers would cost per-element
// overhead in the ~1e9-iteration inner loop). Prints a checksum (sum of the product).
#include <stdio.h>
#include <stdlib.h>

#define N 1024

int main() {
    i32 *a = malloc((i64)N * N * sizeof(i32));
    i32 *b = malloc((i64)N * N * sizeof(i32));
    i32 *c = malloc((i64)N * N * sizeof(i32));
    defer free(a);
    defer free(b);
    defer free(c);

    for (i32 i = 0; i < N * N; i++) {
        a[i] = (i * 7 + 1) % 100;
        b[i] = (i * 3 + 2) % 100;
        c[i] = 0;
    }
    for (i32 i = 0; i < N; i++)
        for (i32 k = 0; k < N; k++) {
            i32 aik = a[i * N + k];
            for (i32 j = 0; j < N; j++)
                c[i * N + j] += aik * b[k * N + j];
        }
    i64 sum = 0;
    for (i32 i = 0; i < N * N; i++) sum += c[i];
    printf("%ld\n", sum);
    return 0;
}
