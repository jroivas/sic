// Recursive Fibonacci in idiomatic SIC: native fixed-width types (i32/i64) and a
// plain recursive function — this benchmark measures call/recursion overhead, so it
// stays recursive on purpose. The argument is read through a `volatile` so the
// compiler cannot fold the whole recursion to a constant. Prints fib(42).
#include <stdio.h>

i64 fib(i32 n) {
    return n < 2 ? n : fib(n - 1) + fib(n - 2);
}

int main() {
    volatile i32 n = 42;
    printf("%ld\n", fib(n));
    return 0;
}
