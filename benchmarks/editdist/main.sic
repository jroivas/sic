// Levenshtein edit distance (two 16K-symbol strings, two-row DP) in idiomatic
// SIC — heap u8 arrays for A and B (symbols), heap i32 arrays for the two DP
// rows (prev/cur). All allocations use `new T[c]` and `defer del`. The classic
// two-row swap avoids full matrix allocation. Prints checksum of final prev[LB].
#include <stdio.h>

const i32 LA = 16000;
const i32 LB = 16000;

static i32 edit_min3(i32 a, i32 b, i32 c) {
    i32 m = a < b ? a : b;
    return m < c ? m : c;
}

int main() {
    u8 *A = new u8[LA];
    u8 *B = new u8[LB];
    i32 *prev = new i32[LB + 1];
    i32 *cur = new i32[LB + 1];
    defer del A;
    defer del B;
    defer del prev;
    defer del cur;

    u32 x = 66661;
    for (i32 i = 0; i < LA; i++) {
        x = x * 1664525 + 1013904223;
        A[i] = (u8)((x / 65536) % 4);
    }
    for (i32 i = 0; i < LB; i++) {
        x = x * 1664525 + 1013904223;
        B[i] = (u8)((x / 65536) % 4);
    }

    for (i32 j = 0; j <= LB; j++) prev[j] = j;

    for (i32 i = 1; i <= LA; i++) {
        cur[0] = i;
        for (i32 j = 1; j <= LB; j++) {
            i32 cost = A[i - 1] == B[j - 1] ? 0 : 1;
            cur[j] = edit_min3(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
        }
        prev <> cur;                     // SIC swap: no temp (see language-basics)
    }

    printf("checksum %u\n", (u32)prev[LB]);
    return 0;
}