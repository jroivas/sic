// 1-D 3-point blur (weighted [1 2 1]/4), many passes, in idiomatic SIC: heap
// arrays via `new f64[N]` released with `defer del`, native `f64`/`i64`. The
// three offsets into the same array (a[i-1], a[i], a[i+1]) mean sic's
// auto-vectorizer bails (one offset per array), so it runs scalar + bounds-checked
// — this is the point of the benchmark. Checksum sums truncated values (bit-stable
// across builds).
#include <stdio.h>

#define N 100000
#define P 3000

int main() {
    f64 *a = new f64[N];
    f64 *b = new f64[N];
    defer del a;
    defer del b;
    for (i32 i = 0; i < N; i++) a[i] = (f64)(i % 251);
    for (i32 p = 0; p < P; p++) {
        for (i32 i = 1; i < N - 1; i++) b[i] = (a[i - 1] + 2.0 * a[i] + a[i + 1]) * 0.25;
        for (i32 i = 1; i < N - 1; i++) a[i] = b[i];
    }
    i64 sum = 0;
    for (i32 i = 0; i < N; i++) sum += (i64)a[i];
    printf("%ld\n", sum);
    return 0;
}
