// Out-of-place matrix transpose (4096x4096, 6 rounds) in idiomatic SIC — two heap
// u32 arrays allocated with `new u32[Ndim*Ndim]` and released with `defer del`.
// Naive transpose swaps rows and columns; src/dst pointers are swapped each round
// so the last round's result is always in `src`. Prints checksum.
#include <stdio.h>

const i32 NDIM = 4096;
const i32 R = 6;

int main() {
    u32 *src = new u32[NDIM * NDIM];
    u32 *dst = new u32[NDIM * NDIM];
    defer del src;
    defer del dst;

    u32 x = 55551;
    for (u64 i = 0; i < NDIM * NDIM; i++) {
        x = x * 1664525 + 1013904223;
        src[i] = x;
    }

    for (i32 r = 0; r < R; r++) {
        for (u64 i = 0; i < NDIM; i++)
            for (u64 j = 0; j < NDIM; j++)
                dst[j * NDIM + i] = src[i * NDIM + j];
        u32 *tmp = src; src = dst; dst = tmp;
    }

    u32 cs = 0;
    for (u64 i = 0; i < NDIM * NDIM; i++)
        cs = cs * 1000003 + src[i];
    printf("checksum %u\n", cs);
    return 0;
}