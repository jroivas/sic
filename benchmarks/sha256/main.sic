// SHA-256 compression (full 64-round, 4M buffer, 16 passes) in idiomatic SIC —
// a pure register/arithmetic benchmark with a 64-entry u32 w[] message schedule
// and the K-constants, all implemented with native u32 wrapping arithmetic.
// Contains rotr32 helper inline. Prints XOR checksum of final hash state.
#include <stdio.h>

const i64 N = 4000000;
const i32 R = 16;

static u32 rotr32(u32 x, u32 n) { return (x >> n) | (x << (32 - n)); }

int main() {
    u8 *buf = new u8[N];
    defer del buf;

    u32 x = 44441;
    for (u64 i = 0; i < N; i++) {
        x = x * 1664525 + 1013904223;
        buf[i] = (u8)((x / 256) & 0xFF);
    }

    static const u32 SHA_K[64] = {
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    };

    u32 cs = 0;
    for (i32 r = 0; r < R; r++) {
        u32 h0 = 0x6a09e667, h1 = 0xbb67ae85, h2 = 0x3c6ef372, h3 = 0xa54ff53a;
        u32 h4 = 0x510e527f, h5 = 0x9b05688c, h6 = 0x1f83d9ab, h7 = 0x5be0cd19;
        u64 nblocks = N / 64;
        u32 w[64];
        for (u64 blk = 0; blk < nblocks; blk++) {
            u64 base = blk * 64;
            for (i32 t = 0; t < 16; t++) {
                u64 o = base + (u64)t * 4;
                w[t] = ((u32)buf[o] << 24) | ((u32)buf[o + 1] << 16) | ((u32)buf[o + 2] << 8) | (u32)buf[o + 3];
            }
            for (i32 t = 16; t < 64; t++) {
                u32 s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
                u32 s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
                w[t] = w[t - 16] + s0 + w[t - 7] + s1;
            }
            u32 a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, hh = h7;
            for (i32 t = 0; t < 64; t++) {
                u32 S1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                u32 ch = (e & f) ^ ((~e) & g);
                u32 t1 = hh + S1 + ch + SHA_K[t] + w[t];
                u32 S0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                u32 maj = (a & b) ^ (a & c) ^ (b & c);
                u32 t2 = S0 + maj;
                hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
            }
            h0 += a; h1 += b; h2 += c; h3 += d; h4 += e; h5 += f; h6 += g; h7 += hh;
        }
        cs = cs * 1000003 + (h0 ^ h1 ^ h2 ^ h3 ^ h4 ^ h5 ^ h6 ^ h7);
    }

    printf("checksum %u\n", cs);
    return 0;
}