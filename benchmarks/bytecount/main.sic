// Count bytes with the high bit set (>= 128) in a large buffer, several passes, in
// idiomatic SIC: a heap `new u8[N]` array released with `defer del`, native
// `u8`/`i64`. The scalar predicate branch per byte is what sic emits (no packed
// compare + mask), where LLVM vectorizes — the point of the benchmark. Integer
// count, exact regardless of order.
#include <stdio.h>

#define N 20000000
#define P 20

int main() {
    u8 *buf = new u8[N];
    defer del buf;
    for (i32 i = 0; i < N; i++) buf[i] = (u8)((i * 131 + 7) & 0xff);
    i64 cnt = 0;
    for (i32 p = 0; p < P; p++)
        for (i32 i = 0; i < N; i++)
            if (buf[i] >= 128) cnt++;
    printf("%ld\n", cnt);
    return 0;
}
