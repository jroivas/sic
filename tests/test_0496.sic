// Loop-BCE hoists the bounds checks of a loop whose body makes a call when every
// name the checks depend on is call-proof: a `const` bound, a non-escaped local
// loop variable and arrays (the dispatch benchmark's shape). Returns 42.
const i64 N = 64;
u32 add(u32 a, u32 b) { return a + b; }
u32 sub(u32 a, u32 b) { return a - b; }
int main() {
    u8 *code = new u8[N];
    u32 *operand = new u32[N];
    defer del code;
    defer del operand;
    for (u64 i = 0; i < N; i++) { code[i] = (u8)(i % 2); operand[i] = (u32)i; }
    u32 (*fns[2])(u32, u32) = {add, sub};
    u32 acc = 0;
    for (u64 i = 0; i < N; i++) acc = fns[code[i]](acc, operand[i]);
    // even i added, odd i subtracted: sum over pairs (2k - (2k+1)) = -32
    return (int)(acc + 32 + 42);
}
