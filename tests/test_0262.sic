// sic std.Fmt (sic.md std): a compile-time `{}` format string → a native OWNED
// string (freed at scope exit). Same grammar as std.Printf. Verified by
// comparing the returned string and its length.
#include <string.h>

int main() {
    string name = "sic";
    int a[3] = { 1, 2, 3 };
    fixed<10,2> p = 1; p = p / 8;                    // 0.13 at 2dp

    string s = std.Fmt("hi {}! {}+{}={} a={} p={} {{x}}", name, 2, 3, 2 + 3, a, p);
    if (s != "hi sic! 2+3=5 a=[1, 2, 3] p=0.13 {x}") return 1;
    if (s.length != 36) return 2;

    // The result is a first-class string: compare, slice, reuse.
    string n = std.Fmt("{}", 12345);
    if (n != "12345" || n.length != 5) return 3;
    if (n[1:3] != "23") return 4;

    // A concatenation of two Fmt results.
    string j = std.Fmt("[{}]", 1) + std.Fmt("[{}]", 2);
    if (j != "[1][2]") return 5;

    return 42;
}
