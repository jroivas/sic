// sic `new` container handles are owned by the binding and freed at scope exit
// (sic.md §"Dict"/§"List"/§"Set") — a `new`-allocated dict/list/set no longer
// leaks. `new list<T>` is now supported alongside `new dict`/`new set`.
int main() {
    // `new dict` (no star): the handle is owned and auto-freed at scope exit.
    dict<int, int> d = new dict<int, int>;
    d[1] = 10; d[2] = 20;
    if (d.size != 2 || d[1] != 10) return 1;

    // `new list<T>`.
    list<int> l = new list<int>;
    l.add(100); l.add(200);
    if (l.size != 2 || l[1] != 200) return 2;

    // `new set<T>`.
    set<int> s = new set<int>;
    s.add(5); s.add(5); s.add(7);
    if (s.size != 2) return 3;

    // pointer-declared form (`dict *p`): a pointer-to-handle collapses to the
    // handle itself, so `dict *p` and `dict d` behave identically — subscript,
    // methods, `.size`, and iteration all work directly on `p`, and it is freed.
    dict<int, int> a;
    dict<int, int> *p = new dict<int, int>;
    a[5] = 10;
    p[5] = 10;                          // same as `a[5]` — no deref needed
    p[6] = 20;
    if (a[5] != 10 || p[5] != 10) return 4;
    if (p.size != 2) return 5;
    del p[5];
    if (p.size != 1 || p[5] != 0) return 6;

    list<int> *lp = new list<int>;
    lp.add(1); lp.add(2);
    int sum = 0;
    for (int v : lp.values) sum += v;
    if (sum != 3) return 7;

    return 42;
}
