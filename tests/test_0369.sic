// A bare (non-`{}`) loop body must get its own per-iteration scope, so
// temporaries it creates (string concat, `.keys`/`.values` projections, …) are
// released each iteration rather than accumulated in the loop scope and freed
// once at loop exit (which leaked every iteration but the last — see the
// valgrind check accompanying this fix). This pins the CORRECTNESS of the extra
// scope, including break/continue running the per-iteration cleanups. Returns 42.
int sumList(list<int> l) { int s = 0; for (int v : l.values) s += v; return s; }

int main() {
    // bare-body for with a string self-concat temp each iteration
    string s = "";
    for (int i = 0; i < 50; i++) s = s + "x";
    if (s.length != 50) return 1;

    // bare-body while with a concat temp
    string t = "";
    int i = 0;
    while (i < 10) t = t + "ab", i++;
    if (t.length != 20) return 2;

    // bare-body do-while
    string u = "";
    int j = 0;
    do u = u + "z", j++; while (j < 5);
    if (u.length != 5) return 3;

    // bare-body loop that materializes a container projection each iteration
    dict<int, int> d;
    d[1] = 10; d[2] = 20; d[3] = 30;
    int total = 0;
    for (int k = 0; k < 4; k++)
        for (int v : d.values) total += v;   // bare inner body, temp each iter
    if (total != 240) return 4;              // 60 * 4

    // break/continue in a bare-ish body still clean up per iteration
    int acc = 0;
    for (int a = 0; a < 100; a++) {
        list<int> tmp;
        for (int b = 0; b <= a; b++) tmp.add(b);
        if (a == 5) continue;                 // tmp released on continue
        if (a == 8) break;                    // tmp released on break
        acc += sumList(tmp);
    }
    // a=0..7 except 5: sum of 0..a = a(a+1)/2 → 0,1,3,6,10,(skip),21,28 = 69
    if (acc != 69) return 5;

    return 42;
}
