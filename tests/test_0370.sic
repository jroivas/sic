// sic auto-vectorization (sic.md §"Scopes"): a unit-stride counting loop whose
// body is one element-wise array assignment is rewritten to process a SIMD vector
// of elements per step, plus a scalar remainder. This pins CORRECTNESS across
// element widths, the remainder (length not a multiple of the lane count), the
// read-modify-write and plain-store forms, and the same-array (same-offset) and
// distinct-array cases. Returns 42.
#include <stdio.h>

int main() {
    // i32 SAXPY, length 1023 (remainder 3 for a 4-lane vector)
    i32 n = 1023;
    i32 *c = new i32[n]; i32 *b = new i32[n]; defer del c; defer del b;
    for (i32 j = 0; j < n; j++) { c[j] = j; b[j] = 2; }
    i32 s = 5;
    for (i32 j = 0; j < n; j++) c[j] += s * b[j];          // c[j] = j + 10
    i64 sum = 0; for (i32 j = 0; j < n; j++) sum += c[j];
    if (sum != (i64)(n - 1) * n / 2 + 10 * n) return 1;     // 522753 + 10230 = 532983

    // i16 (8 lanes) plain copy
    i16 *d = new i16[100]; i16 *e = new i16[100]; defer del d; defer del e;
    for (i32 j = 0; j < 100; j++) { d[j] = 0; e[j] = (i16)(j % 7); }
    for (i32 j = 0; j < 100; j++) d[j] = e[j];
    i64 ds = 0, es = 0;
    for (i32 j = 0; j < 100; j++) { ds += d[j]; es += e[j]; }
    if (ds != es) return 2;

    // i64 (2 lanes) add of two distinct arrays
    i64 *p = new i64[50]; i64 *q = new i64[50]; i64 *r = new i64[50];
    defer del p; defer del q; defer del r;
    for (i32 j = 0; j < 50; j++) { p[j] = j; q[j] = j * 2; r[j] = 0; }
    for (i32 j = 0; j < 50; j++) r[j] = p[j] + q[j];         // 3j
    i64 rs = 0; for (i32 j = 0; j < 50; j++) rs += r[j];
    if (rs != 3 * (49 * 50 / 2)) return 3;                   // 3675

    // same array, same offset (safe to vectorize): c2[j] = c2[j] * 3
    i32 *c2 = new i32[64]; defer del c2;
    for (i32 j = 0; j < 64; j++) c2[j] = j;
    for (i32 j = 0; j < 64; j++) c2[j] = c2[j] * 3;
    i64 c2s = 0; for (i32 j = 0; j < 64; j++) c2s += c2[j];
    if (c2s != 3 * (63 * 64 / 2)) return 4;                  // 6048

    // bitwise element-wise (xor) and an invariant offset base
    u32 *x = new u32[130]; u32 *y = new u32[130]; defer del x; defer del y;
    for (i32 j = 0; j < 130; j++) { x[j] = (u32)j; y[j] = 0xFFu; }
    i32 off = 2;
    for (i32 j = 0; j < 128; j++) x[off + j] = x[off + j] ^ y[off + j];
    // x[2..129] xor 0xFF; x[0],x[1] unchanged
    if (x[0] != 0u || x[1] != 1u) return 5;
    if (x[2] != (2u ^ 0xFFu) || x[129] != (129u ^ 0xFFu)) return 6;

    printf("autovec: OK\n");
    return 42;
}
