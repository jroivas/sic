// sic generic functions (sic.md §"Generics"): monomorphized per call, with type
// parameters inferred from arguments (including container element types) or given
// explicitly via turbofish. Returns 42.
T maxof<T>(T a, T b) { return a > b ? a : b; }
T2 pick2<T1, T2>(T1 a, T2 b) { return b; }
T sumlist<T>(list<T> xs) { T acc = 0; for (tuple iv : xs) acc += (T)iv[1]; return acc; }
V lookup<K, V>(dict<K, V> m, K key) { return m[key]; }
int setcount<T>(set<T> s) { return (int)s.size; }

int main() {
    int acc = 0;

    // inference over scalars, and turbofish
    acc += maxof(10, 7);            // 10
    acc += (int)maxof(2.5, 4.5);    // 4
    acc += maxof<int>(3, 9);        // 9  (explicit)

    // multiple type parameters
    acc += (int)pick2(1, 6);        // 6  (returns the 2nd)

    // inference over a list<T> element type
    list<int> xs; xs.add(4); xs.add(4);
    acc += sumlist(xs);             // 8

    // inference over dict<K,V>
    dict<int, int> m; m[1] = 3;
    acc += (int)lookup(m, 1);       // 3

    // inference over set<T>
    set<int> s; s.add(1); s.add(2);
    acc += setcount(s);             // 2

    // acc = 10+4+9+6+8+3+2 = 42
    return acc;
}
