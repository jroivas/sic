// sic arbitrary-precision + exact-rational numerics (sic.md §"Integer sizes"):
// `bigint` (arbitrary precision) and `fixed` (an exact rational num/den). Returns 42.
int main() {
    // bigint: exact beyond 64 bits.
    bigint big = 1;
    for (int i = 0; i < 40; i = i + 1) big = big * 2;   // 2^40
    bigint half = big / 2;                               // 2^39
    bigint diff = big - half - half;                     // 0 (exact)
    int ratio = (int)(big / half);                       // 2

    // fixed: 1/3 is exact, so (1/3)*3 == 1 (no float drift)
    fixed third = 1;
    third = third / 3;
    int one_i = (int)(third * 3);                        // 1

    // 0.1 * 10 is exactly 1 in an exact rational
    fixed tenth = 1;
    tenth = tenth / 10;
    int ten_tenths = (int)(tenth * 10);                  // 1

    int acc = (int)diff + one_i + ten_tenths + ratio;    // 0 + 1 + 1 + 2 = 4
    return acc * 10 + 2;                                  // 42
}
