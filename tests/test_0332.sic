// sic lambdas (sic.md §"Lambdas"): C++-style captureless lambdas lift to a plain
// function and evaluate to a function pointer — the `=>` expression body, an
// explicit `-> ret`, assignment to a function-pointer variable, direct calls, and
// C-callback interop (qsort) all work. Returns 42.
#include <stdlib.h>

int apply(int (*f)(int), int x) { return f(x); }

int main() {
    // Block body, return type inferred.
    auto sq = [](int x) { return x * x; };
    if (sq(6) != 36) return 1;

    // `=> expr` sugar.
    auto add = [](int a, int b) => a + b;
    if (add(20, 22) != 42) return 2;

    // Explicit return type; called inline.
    if (([](int x) -> int { return x + 1; })(9) != 10) return 3;

    // Assign to an explicit C function-pointer type and call through it.
    int (*dec)(int) = [](int x) { return x - 1; };
    if (dec(8) != 7) return 4;

    // Pass a lambda as a function-pointer argument.
    if (apply([](int x) { return x * 3; }, 5) != 15) return 5;

    // Interop: hand a lambda straight to a C API expecting a callback.
    int a[5] = { 5, 2, 8, 1, 3 };
    qsort(a, 5, sizeof(int), [](const void *x, const void *y) {
        return *(const int *)x - *(const int *)y;
    });
    if (a[0] != 1 || a[4] != 8) return 6;

    return 42;
}
