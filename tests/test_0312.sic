// sic range-`for` over a `list<T>` (sic.md §"List"/§"Iterators"): a bare list
// yields `tuple(index, value)`; `.values` yields each element directly.
int main() {
    list<int> nums;
    nums.add(10); nums.add(20); nums.add(12);
    int sum = 0;
    for (int x : nums.values) sum += x;   // 42
    if (sum != 42) return 1;

    // bare iteration binds a `tuple(index, value)`.
    int isum = 0, vsum = 0;
    for (tuple iv : nums) { isum += (int)iv[0]; vsum += (int)iv[1]; }
    if (isum != 3) return 4;               // 0 + 1 + 2
    if (vsum != 42) return 5;

    // element type may be a `string`; iterate `.values` and total the lengths.
    list<string> words;
    words.add("ab"); words.add("cde");    // 2 + 3 = 5
    int chars = 0;
    for (string w : words.values) chars += (int)w.size;
    if (chars != 5) return 2;

    // break/continue work because the loop desugars to a counted `for`.
    list<int> more;
    for (int i = 0; i < 100; i++) more.add(i);
    int seen = 0;
    for (int v : more.values) {
        if (v == 5) break;
        if (v % 2 == 0) continue;
        seen += v;                        // 1 + 3 = 4
    }
    if (seen != 4) return 3;

    return sum;                           // 42
}
