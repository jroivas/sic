// sic std.Printf (sic.md std): a compile-time `{}` format string (Python/Rust
// style; `{{`/`}}` are literal braces), each placeholder substituted by the next
// argument printed by its static type. Output captured + compared exactly.
#include <stdio.h>
#include <string.h>
#include <unistd.h>

int main() {
    int fd[2];
    if (pipe(fd) != 0) return 1;
    int saved = dup(1);
    dup2(fd[1], 1);

    string name = "sic";
    int a[3] = { 10, 20, 30 };
    fixed<10,2> p = 1; p = p / 8;                    // 0.125 -> 0.13 at 2dp
    std.Printf("hi {}! {}+{}={} arr={} p={} {{lit}}\n",
               name, 2, 3, 2 + 3, a, p);

    fflush(stdout);
    dup2(saved, 1);
    close(fd[1]);

    char buf[256]; int n = (int)read(fd[0], buf, sizeof buf - 1);
    buf[n < 0 ? 0 : n] = 0;

    const char* want = "hi sic! 2+3=5 arr=[10, 20, 30] p=0.13 {lit}\n";
    if (strcmp(buf, want) != 0) { fprintf(stderr, "got [%s]\n", buf); return 2; }
    return 42;
}
