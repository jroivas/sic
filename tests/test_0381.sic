// Scalar zero-initialization is a `Store 0` (not a `memset`), so an uninitialized
// scalar local still promotes to a register — which lets the backend drop the
// zero-init and any dead reassignment (sic.md §"Initialized variables"). This
// checks the VALUES are unchanged: every default-zero scalar reads 0, a struct
// still zero-fills, and a chain of dead stores keeps only the last. (The
// optimization itself — no memset / no dead stores in the object — is verified out
// of band; here we pin correctness across the scalar types the change touches.)
// Returns 42.
#include <stdio.h>

struct P { i32 x; i64 y; };

int main() {
    // default zero-init across the promotable scalar types + an aggregate
    i32 i; i64 w; u8 c; u32 u; f64 f; f32 g; bool b; i32 *p; struct P s;
    if (i != 0 || w != 0 || c != 0 || u != 0) return 1;
    if (f != 0.0 || (f64)g != 0.0) return 2;
    if (b) return 3;
    if (p != 0) return 4;
    if (s.x != 0 || s.y != 0) return 5;          // aggregate still zero-filled

    // dead-store chain: only the last assignment survives
    i32 a;
    a = 5;
    a = 6;
    a = 10;
    if (a != 10) return 6;

    // reassign a zero-init'd scalar before first read (zero-init is dead)
    i32 n;
    n = 7;
    if (n != 7) return 7;

    return 42;
}
