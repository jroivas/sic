// sic tail-call optimization (sic.md §"Scopes"): a self-recursive `return f(args)`
// becomes a jump back to the function entry with the parameters reassigned, so deep
// tail recursion runs as a loop (no stack overflow) and stays correct. Exercises the
// tricky cases: branching tail calls, argument order that swaps parameters, a tail
// call nested inside a loop (the back-edge must jump to the function top, not
// `continue` the inner loop), and a mix of tail and non-tail returns. Returns 42.

// two tail calls in different branches
long collatz(long n, long steps) {
    if (n == 1) return steps;
    if (n % 2 == 0) return collatz(n / 2, steps + 1);
    return collatz(3 * n + 1, steps + 1);
}

// arguments reference both parameters → temps must snapshot before reassigning
long gcd(long a, long b) {
    if (b == 0) return a;
    return gcd(b, a % b);
}

// tail call nested inside a loop: the rewrite must jump to the function entry,
// re-running the loop from scratch, NOT continue this `for`
long countdown(long n, long acc) {
    for (long i = 0; i < 1; i++) {
        if (n == 0) return acc;
        return countdown(n - 1, acc + 1);
    }
    return acc;                       // unreachable, but a non-tail return too
}

int main() {
    if (collatz(27, 0) != 111) return 1;      // 27 reaches 1 in 111 steps
    if (gcd(1071, 462) != 21) return 2;        // gcd = 21
    if (countdown(3000000, 0) != 3000000) return 3;  // deep + in-loop tail call, no overflow
    return 42;
}
