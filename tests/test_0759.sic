// A temporary made in one arm of `?:`, or on the right of the elvis `?:`, is
// released in that arm. Its release was registered at the enclosing scope, so
// when the other arm ran it was released uninitialized: a string temporary
// crashed, and a managed struct's destructor ran on garbage. Returns 42.
import std;
import std::*;

// A heap string (a concatenation), without calling into libstd.
string num(int i) { char b[2]; b[0] = '0' + i; b[1] = 0; string d = b; return "" + d; }

int dtors = 0;
struct P { string n; ~P() { dtors++; } };

string mk(int i) { return "x" + num(i); }
int len(string s) { return s.size; }
P mkp() { P p; p.n = mk(9); return p; }
int plen(P p) { return p.n.size; }
Option<string> os(int c) { if (c) return Some(mk(1)); return None; }

int main(int argc, char **argv) {
    int no = argc - 1;      // 0, not a constant
    int yes = argc;         // 1
    int r = 0;
    if ((no ? len(mk(3)) : 0) == 0) r += 1;
    if ((yes ? 0 : mk(3).size) == 0) r += 1;
    if ((no ? plen(mkp()) : 0) == 0 && dtors == 0) r += 1;
    if ((yes ?: len(mk(6))) == 1) r += 1;
    for (int i = 0; i < 3; i++) { if ((no ? len(mk(i)) : i) == i) r += 1; }
    // The Option elvis: the default's temporary, and the call's Option.
    string a = os(yes) ?: mk(5);
    string b = os(no) ?: mk(5);
    if (a == "x1" && b == "x5") r += 1;
    return r == 8 ? 42 : r;
}
