// sic generic enums with an aggregate payload + Option `?.` (sic.md §"Match"):
// Option<Point> constructs/matches correctly, and `op?.field` reaches into the
// present payload. Verified by exit code.
enum Option<T> { Some(T), None };
typedef struct { int x; int y; } Point;

int main() {
    Point pt = { 7, 8 };
    Option<Point> op = Option::Some(pt);
    Option<Point> no = None;
    int acc = 0;
    match (op) { Some(q): acc += q.x + q.y; None: acc -= 1; }   // +15
    acc += op?.x;                 // +7  (present payload field)
    acc += op?.y;                 // +8
    acc += no?.x ?: 100;          // +100 (None → field zero → ?: default)
    // 15 + 7 + 8 + 100 = 130
    if (acc != 130) return acc;
    return 42;
}
