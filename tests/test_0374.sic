// Auto-vectorization of stencils (sic.md §"Scopes"): a loop whose body reads one
// array at several unit-stride offsets (a[i-1], a[i], a[i+1]) while writing a
// DIFFERENT array vectorizes — the read array is never written, so its loads are
// order-independent, and a runtime alias guard falls back to scalar if the write
// array actually aliases it. Exercises `i-1` (Sub) offsets and float-literal
// broadcasts (`2.0`, `0.25`). A SELF-referential stencil (write == a read at a
// different offset) is a loop-carried dependence and must NOT vectorize (stays
// scalar, still correct). Returns 42.
#include <stdio.h>

int main() {
    i32 n = 100;

    // integer 3-point sum: b[i] = a[i-1] + a[i] + a[i+1] = 3i for a[i] = i
    i32 *a = new i32[n]; i32 *b = new i32[n]; defer del a; defer del b;
    for (i32 i = 0; i < n; i++) { a[i] = i; b[i] = -1; }
    for (i32 i = 1; i < n - 1; i++) b[i] = a[i - 1] + a[i] + a[i + 1];
    for (i32 i = 1; i < n - 1; i++) if (b[i] != 3 * i) return 1;
    if (b[0] != -1 || b[n - 1] != -1) return 2;         // ends untouched

    // float weighted blur: y[i] = (x[i-1] + 2·x[i] + x[i+1])·¼ = i for x[i] = i
    f64 *x = new f64[n]; f64 *y = new f64[n]; defer del x; defer del y;
    for (i32 i = 0; i < n; i++) { x[i] = (f64)i; y[i] = 0.0; }
    for (i32 i = 1; i < n - 1; i++) y[i] = (x[i - 1] + 2.0 * x[i] + x[i + 1]) * 0.25;
    for (i32 i = 1; i < n - 1; i++) if ((i64)y[i] != i) return 3;

    // self-referential (loop-carried): must stay scalar and remain correct.
    i32 *c = new i32[n]; defer del c;
    c[0] = 0;
    for (i32 i = 1; i < n; i++) c[i] = c[i - 1] + 1;    // c[i] = i (sequential)
    for (i32 i = 0; i < n; i++) if (c[i] != i) return 4;

    return 42;
}
