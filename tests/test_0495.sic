// Loop-BCE with a call: the bound is a local whose address escaped BEFORE the
// loop; the callee grows it through the pointer. Not call-proof → the
// per-access check stays and aborts (134).
i64 *g_p;
void grow() { *g_p = 10; }
int main() {
    i64 n = 2;
    g_p = &n;
    i32 *a = new i32[4];
    for (i64 i = 0; i < n; i++) {
        a[i] = 1;
        grow();
    }
    del a;
    return 0;
}
