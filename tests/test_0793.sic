// SIC bounds (sic.md §"Bounds"): an element-wise loop over arrays (the
// shape the vectorizer rewrites) keeps each access checked: the vector loop
// had no check for an array without a `new` header. `a[8]` stops the program.
// Exit 134 (abort).
int main() {
    int a[8];
    int b[16];
    int n = 12;
    for (int i = 0; i < 16; i++) b[i] = i;
    int *p = b;
    for (int i = 0; i < n; i++) a[i] = p[i] + 1;
    return a[3];
}
