// sic strict enum typing (sic.md §"Enums"): the flip side of test_0270..0272 —
// legitimate enum use is unaffected. enum→int is implicit; same-enum flows, casts,
// comparisons and switch all work. Returns 0 on success.
enum Color { RED, GREEN = 5, BLUE };   // 0, 5, 6
typedef enum { LO, HI } Level;         // anonymous typedef enum

enum Color pick(enum Color c) { return c; }   // same-enum param + return

int main() {
    // Construct + pass a same-enum value; enum constants are of their enum type.
    enum Color a = pick(BLUE);
    if (a != BLUE) return 1;

    // An enum *value* widens to int implicitly; a bare constant in a non-enum
    // context is ambiguous, so name it `Color::GREEN` (sic.md §"Enums").
    int n = Color::GREEN;
    if (n != 5) return 2;
    int m = a;                         // enum value → int is still implicit
    if (m != 6) return 2;

    // Compare against an int literal and against a constant.
    if (a == 5) return 3;             // BLUE is 6, so this must NOT hit
    if (!(a == BLUE)) return 4;

    // Explicit cast is the escape hatch, both directions.
    enum Color b = (enum Color)6;     // int → enum via cast
    if (b != BLUE) return 5;

    // Iterate with an explicit cast on the arithmetic.
    int count = 0;
    for (enum Color e = RED; (int)e <= (int)Color::BLUE; e = (enum Color)((int)e + 1)) {
        count++;
    }
    if (count != 7) return 6;          // 0..6 inclusive

    // switch dispatches on the enum's value.
    switch (a) {
        case RED:  return 7;
        case BLUE: break;
        default:   return 8;
    }

    // Anonymous typedef enum behaves the same.
    Level lv = HI;
    if ((int)lv != 1) return 9;

    return 0;
}
