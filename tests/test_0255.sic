// sic none/null-safe access `base?.field` (sic.md §"Match"): if the base is a
// non-null pointer (or present Option), the field; else a zero value. Chains
// via zero-propagation and pairs with `?:`. Verified by exit code.
struct Node { int value; struct Node* next; };
int main() {
    struct Node c = { 3, 0 };
    struct Node b = { 2, &c };
    struct Node a = { 1, &b };
    struct Node* p = &a;
    int acc = 0;
    acc += p?.value;                                  // 1
    acc += p?.next?.value;                            // 2
    acc += p?.next?.next?.value;                      // 3
    acc += p?.next?.next?.next?.value ?: 100;         // +100 (chain hits null)
    struct Node* z = 0;
    acc += z?.value ?: 40;                            // +40 (null base)
    acc += z?.next?.next?.value ?: 50;                // +50 (null base, deep chain)
    // 1 + 2 + 3 + 100 + 40 + 50 = 196
    if (acc != 196) return acc;
    return 42;
}
