// `s.is_empty()`: true when the string has no bytes — a size check, for any
// string: a literal, a local, a slice, a trimmed view, a parameter, a call's result.
string make(int n) { string s = ""; for (int i = 0; i < n; i++) s = s + "x"; return s; }
bool blank(string s) { return s.trim().is_empty(); }

int main() {
    string e = "";
    string w = "word";
    if (!e.is_empty() || w.is_empty()) return 1;
    if (!"".is_empty() || "x".is_empty()) return 2;
    if (!w[2:2].is_empty() || w[1:3].is_empty()) return 3;
    if (!blank("   ") || blank(" a ")) return 4;
    if (!make(0).is_empty() || make(3).is_empty()) return 5;
    string z;                          // a zero-initialized string is empty
    if (!z.is_empty()) return 6;
    int n = 0;
    while (!w.is_empty()) { w = w[1:]; n++; }
    return n + 38;                     // 4 + 38
}
