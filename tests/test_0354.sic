// Regression guard for the -O2 const-fold miscompile (sic.md §"Built-in fixed point"):
// AST-level constant folding must NOT fold integer division `1/3` to 0 before the
// numeric context promotes the literals — that is left to the typed `ir-fold` pass.
// Compiled at -O2 (see .flags) so the optimizer runs. Returns 42.
int main() {
    float  b = 1 / 3;              // 0.333…, not 0
    double d = 1 / 3;
    fixed  c = 7 / 2;             // exact 3.5
    if (!(b > 0.33f && b < 0.34f)) return 1;
    if (!(d > 0.33 && d < 0.34)) return 2;
    if ((int)(c * 2) != 7) return 3;
    int i = 7 / 2;               // plain int division still 3
    if (i != 3) return 4;
    return 42;
}
