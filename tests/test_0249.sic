// sic numeric-context literal promotion (sic.md §"Built-in fixed point"): in
// `T v = <expr>` with a float/double/fixed target, bare integer literals in an
// arithmetic position adopt the target type, so `1/3` is not integer-divided to
// 0. Explicit suffix/cast (`1U`, `(int)1`) overrides. Verified by exit code.
#include <string.h>
int main() {
    float  b = 1 / 3;
    double d = 1 / 3;
    fixed  c = 1 / 3;
    if (!(b > 0.33f && b < 0.34f)) return 1;
    if (!(d > 0.33 && d < 0.34)) return 2;
    if (strcmp(c.str, "0.333333333333333333") != 0) return 3;

    float a = 1;                        // same as 1.0
    if (a != 1.0f) return 4;

    fixed  f2 = 7 / 2;                  // exact 3.5
    double g  = 7 / 2;                  // 3.5 (not 3)
    if (strcmp((c*0 + f2).str, "3.500000000000000000") != 0) return 5;
    if (g != 3.5) return 6;

    // explicit type anchors → standard integer division (0)
    float u = 1U / 3;
    float k = (int)1 / 3;
    if (u != 0.0f) return 7;
    if (k != 0.0f) return 8;

    // an array index inside the RHS stays an integer index
    int arr[4] = {10, 20, 30, 40};
    double e = arr[1] + 1;              // 21.0, index 1 preserved
    if (e != 21.0) return 9;

    return 42;
}
