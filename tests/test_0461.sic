/* An enum from a C header #include'd by SIC is still C: its members are plain
 * integer constants (socket(AF_INET, SOCK_STREAM, 0) was rejected, demanding
 * glibc's internal `__socket_type::SOCK_STREAM`). The qualified form still
 * works. Returns 42. */
#include <sys/socket.h>
#include <unistd.h>

int main() {
    int fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) return 1;
    close(fd);
    if (SOCK_DGRAM != __socket_type::SOCK_DGRAM) return 2;
    int t = SOCK_STREAM;
    return t == 1 ? 42 : 3;
}
