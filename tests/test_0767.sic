// A `bigint` or `fixed` list or dict element is the container's own copy: it
// was the source's block, so it was freed under the container when the
// source went (a use after free), and a number stored into a `fixed` element
// (`d[1] = 2.5`) kept the double's bits as if they were the value's address.
// A `fixed` element type also kept its digits (it came back as `any`).
// Returns 42.
list<bigint> fill() {
    list<bigint> l;
    { bigint v = 12345678901234567890; l.add(v); }
    bigint w = 5;
    l.add(w * 3);
    l.add(7);
    return l;
}

int main() {
    int r = 0;
    list<bigint> l = fill();
    bigint big = 12345678901234567890;
    if (l[0] == big && l[1] == 15 && l[2] == 7) r += 1;
    l[1] = l[0];
    l[0] = 4;
    list<bigint> m = l.clone();
    if (l[0] == 4 && l[1] == big && m[1] == big) r += 1;
    bigint p = l.pop();
    if (p == 7 && l.length == 2) r += 1;
    dict<int, fixed<6,1> > d;
    d[1] = 2.5;
    fixed<6,1> v = 1.5;
    d[2] = v;
    d[3] = d[1] + v;
    fixed<6,1> four = 4;
    if (d[3] == four && d[2] == v) r += 1;
    list<fixed<10,2> > fl;
    fixed<10,2> a = 1.25;
    fl.add(a);
    fl.add(3);
    fixed<10,2> sum = 0;
    for (fixed<10,2> f : fl.values) sum = sum + f;
    fixed<10,2> want = 4.25;
    if (sum == want) r += 1;
    return r == 5 ? 42 : r;
}
