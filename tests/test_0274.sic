// sic range-`for` over arrays (sic.md §"Iterators"): `for (auto x : arr)` yields
// each element; break/continue and nesting behave like a normal loop.
int main() {
    int a[5] = {1, 2, 3, 4, 5};
    int sum = 0;
    for (auto x : a) { sum += x; }
    if (sum != 15) return 1;

    // break
    int s2 = 0;
    for (auto x : a) { if (x > 3) break; s2 += x; }
    if (s2 != 6) return 2;                 // 1+2+3

    // continue
    int odd = 0;
    for (auto x : a) { if (x % 2 == 0) continue; odd += x; }
    if (odd != 9) return 3;                // 1+3+5

    // nested
    int b[2] = {10, 20};
    int prod = 0;
    for (auto x : a) { for (auto y : b) { prod += x * y; } }
    if (prod != 15 * 30) return 4;

    return 0;
}
