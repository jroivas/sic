// sic-cpp — C preprocessor in idiomatic SIC.
//
// Usage: sic-cpp [options] [infile [outfile]]     (a drop-in for `cpp`)
//   -D name[=def] / -U name (in order), -I dir, -iquote / -isystem / -idirafter
//   dir, -include / -imacros file, -nostdinc, -undef, -ffreestanding, -o file,
//   -P (no linemarkers), -M / -MM / -MD / -MMD / -MG / -MP / -MF / -MT / -MQ,
//   -dM, -v. Compiler-only flags (-W*, -f*, -m*, -O*, -g*, -E, -std=) are
//   accepted and ignored. sic-cpp-specific: --compact drops lines with no
//   visible content (gcc's layout is the default).
//   It presents as the sic compiler (clang 15 / gcc 4.2 identity); include
//   paths, target macros and `__has_*` answers come from sic itself (see
//   "System include paths").

import std;

// ── Structs ────────────────────────────────────────────────────────────────

struct Preprocessor {
    // Macro table: name → encoding ("O|body" or "F|params|body")
    dict<string, string> macros;
    // Conditional compilation stack (fixed depth 128)
    i32 cond_stack[128];
    i32 cond_depth;
    // Include search paths
    list<string> include_dirs;
    // User -D and -U flags
    list<string> user_defines;
    list<string> user_undefs;
    // Current source tracking
    string current_file;
    i32 current_line;
    // Output lines
    list<string> output_lines;
    // Host C compiler consulted for `__has_attribute` & co ("" = none), and
    // its cached answers keyed by the query text.
    string cc;
    dict<string, string> has_cache;
    // The `__has_*` answers came from sic (SIC_CPP_INFO): has_cache is complete,
    // an unlisted query answers 0.
    i32 info_mode;
    // `#pragma once` files, and the `#pragma push_macro` stack ("name\x02enc").
    list<string> once_files;
    list<string> pushed_macros;
    // Linemarkers (`# N "file" flags`, gcc's default output; off with -P).
    // `out_file`/`out_line` is where the NEXT output line sits as far as the
    // reader knows; `cur_sys` = the current file is a system header (flags 3 4);
    // `user_dirs` = how many leading include dirs are -I (non-system) dirs.
    i32 markers;
    string out_file;
    i32 out_line;
    i32 cur_sys;
    i32 user_dirs;
    i32 force_marker;
    // Whether the last printed TOKEN came from a system header (gcc re-marks
    // the position when that flips).
    i32 prev_sys_tok;
    // Include guards (path → guard macro), detected on first inclusion: a header
    // whose guard is defined is not re-entered at all (gcc's multiple-include
    // optimization — no markers, no work).
    dict<string, string> guards;
    // Search-list index the current file was found at (-1: not via the search
    // path — the main file, an absolute path, or `"x"` from the includer's
    // directory). `#include_next` continues after it, or from the start if -1.
    i32 cur_dir_idx;
    // `-iquote` dirs: searched for `#include "x"` only, after the includer's dir.
    list<string> quote_dirs;
    // Dependency tracking (-M family): every file read, in first-seen order,
    // with whether it is a system header (-MM leaves those out). -MG: a missing
    // header is a dependency instead of an error.
    list<string> deps;
    list<i32> deps_sys;
    i32 missing_ok;
    // The current logical line's text (for diagnostics' column).
    string cur_text;
    // Output settings (see `finish`).
    string out_path;          // -o / second operand; "" = stdout
    i32 compact;              // --compact: drop content-less lines
    i32 dump_macros;          // -dM
    i32 dep_only;             // -M / -MM: write the rule instead of the text
    i32 dep_side;             // -MD / -MMD: also write a .d file
    i32 dep_no_sys;           // -MM / -MMD: leave system headers out
    i32 dep_phony;            // -MP
    string dep_file;          // -MF (or derived)
    list<string> dep_targets; // -MT / -MQ (MQ already escaped)
    string input_name;        // as given (for the default target)
    i32 discard;              // -imacros: run the file, keep only its macros
    i32 dump_defines;         // -dD: also output #define/#undef directives
    i32 dump_names;           // -dN: … with macro names only
    i32 dump_includes;        // -dI: also output #include directives
    i32 errors;               // diagnostics that make the exit status 1
    list<string> embed_dirs;  // --embed-dir
}


// ── File I/O using std::File (except stdin) ────────────────────────────────

// Read a regular file into a string.  Returns "" on failure.
string read_file(string path) {
    auto status = std::Open(path, std::OpenMode::Read);
    match (status) {
        std::File::FileStatus::Opened(f): {
            auto res = std::Size(f);
            u64 size;
            if (!(size = std::FileStatus::Size(res)))
                return "";
            if (size == 0)
                return "";
            auto buf = std::Buffer::Create(size);
            if (!buf) { del f; return ""; }
            auto rs = std::Read(f, size, buf);
            string result = "";
            match (rs) {
                std::FileStatus::Read(cnt):
                    result = std::Buffer::Value(buf).dup;
                _:
                    std::Println("Could not read file"),
                    result = "";
            }
            del buf;
            del f;
            return result;
        }
        _: return "";
    }
}

// Check if a file exists (for #include search).
i32 file_exists(string path) {
    auto status = std::Open(path, std::OpenMode::Read);
    match (status) {
        std::FileStatus::Opened(f): { del f; return 1; }
        _: return 0;
    }
}

// ── System include paths ────────────────────────────────────────────────────
//
// Detected at startup, without hard-coding any C library, version or arch:
//   0. From sic: SIC_CPP_INFO when sic runs us, else `sic -print-cpp-info` (sic
//      on PATH, else the one in this sic repository). Needs no other toolchain.
//   1. With no sic, ask the host C compiler (`$SIC_HOST_CC`, `$CC` unless sic,
//      else cc/gcc/clang) for its `#include <...>` search list
//      (`cc -xc -E -v /dev/null`), including the compiler's private header
//      directory (stddef.h/stdarg.h) and the multiarch directory.
//   2. With neither, probe the filesystem: the compiler-builtin header dir of
//      the HOST triple (gcc or clang, newest version), `/usr/local/include`, the
//      multiarch `/usr/include/<triple>` (any subdir holding `bits/` or `asm/`),
//      and `/usr/include`.

extern void *popen(char *cmd, char *mode);
extern int pclose(void *f);
extern char *fgets(char *s, int n, void *f);
extern char *getenv(char *name);
extern int setenv(char *name, char *value, int overwrite);
extern char *realpath(char *path, char *resolved);
// POSIX glob_t: glibc and musl agree on the first three fields; the tail is padding.
struct __attribute__((order_c)) GlobT { u64 pathc; char **pathv; u64 offs; u8 reserved[128]; }
extern int glob(char *pattern, int flags, void *errfunc, GlobT *g);
extern void globfree(GlobT *g);

// Run a shell command and return its output lines (trailing whitespace trimmed).
list<string> run_lines(string cmd) {
    list<string> lines;
    void *f = popen(cmd.str, "r");
    if (!f) return lines;
    char buf[4096];
    while (fgets(buf, 4096, f)) lines.add(((string)(char*)buf).rtrim().dup);
    pclose(f);
    return lines;
}

// Paths matching a glob pattern (sorted, as glob returns them).
list<string> glob_paths(string pattern) {
    list<string> out;
    GlobT g;
    if (glob(pattern.str, 0, (void*)0, &g) == 0) {
        for (u64 i = 0; i < g.pathc; i++) out.add(((string)g.pathv[i]).dup);
        globfree(&g);
    }
    return out;
}

// Split on every `sep` character.
list<string> split_all(string s, i32 sep) {
    list<string> parts;
    string rest = s;
    while (true) {
        i32 n = 0;
        while (n < rest.size && rest[n] != sep) n++;
        parts.add(rest[0:n].dup);
        if (n >= rest.size) break;
        rest = rest[n+1:];
    }
    return parts;
}

// Compare dotted version strings numerically ("12.2.0" < "15").
i32 ver_cmp(string a, string b) {
    list<string> pa = split_all(a, '.');
    list<string> pb = split_all(b, '.');
    i32 n = pa.length > pb.length ? pa.length : pb.length;
    for (i32 i = 0; i < n; i++) {
        i32 x = 0, y = 0;
        if (i < pa.length) for (i32 k = 0; k < pa[i].size && std::IsDigit(pa[i][k]); k++) x = x * 10 + (pa[i][k] - '0');
        if (i < pb.length) for (i32 k = 0; k < pb[i].size && std::IsDigit(pb[i][k]); k++) y = y * 10 + (pb[i][k] - '0');
        if (x != y) return x < y ? -1 : 1;
    }
    return 0;
}

// Directory part of a path ("" when it has no '/').
string dir_of(string path) {
    i32 i = path.size - 1;
    while (i >= 0 && path[i] != '/') i--;
    return i < 0 ? "" : path[0:i];
}

// sic describes everything sic-cpp needs (system include dirs, target macros,
// `__has_*` answers) — no other toolchain required. Run by sic, sic-cpp gets it
// in SIC_CPP_INFO; run standalone, it asks sic (`sic -print-cpp-info`) with
// SIC_RECURSION=1 set. A sic seeing SIC_RECURSION never starts a preprocessor,
// and a sic-cpp seeing it without SIC_CPP_INFO never starts sic: with `CC=sic`
// the two used to start each other without end.
string RECURSION_ENV = "SIC_RECURSION";
string INFO_ENV = "SIC_CPP_INFO";

// Whether `text` is sic's info format (`include`/`define`/`has` records).
i32 is_info(string text) {
    return text.starts_with("include ") || text.starts_with("define ") || text.starts_with("has ") ? 1 : 0;
}

// sic's info text: from SIC_CPP_INFO, else from the sic on PATH or of the sic
// repository this sic-cpp was built in. "" when no sic answers (then a host C
// compiler / the filesystem probe is used). Exits on recursion.
string sic_info() {
    char *env = getenv(INFO_ENV.str);
    if (env) return ((string)env).dup;
    if (getenv(RECURSION_ENV.str)) {
        std::Println("sic-cpp: fatal error: {} is set but {} is not: refusing to start sic "
                     "(sic and sic-cpp would call each other recursively)", RECURSION_ENV, INFO_ENV, target = 2);
        std::Exit(1);
    }
    setenv(RECURSION_ENV.str, "1", 1);
    list<string> cands;
    list<string> onpath = run_lines("command -v sic 2>/dev/null");
    if (onpath.length > 0) cands.add(onpath[0]);
    char buf[4096];
    if (realpath("/proc/self/exe", buf)) {
        string root = dir_of(dir_of((string)(char*)buf));   // <repo>/sic-cpp/sic-cpp -> <repo>
        cands.add(root + "/siccomp/target/release/sic");
        cands.add(root + "/siccomp/target/debug/sic");
    }
    for (i32 i = 0; i < cands.length; i++) {
        if (!file_exists(cands[i])) continue;
        list<string> out = run_lines("'" + cands[i] + "' -print-cpp-info 2>/dev/null");
        string text = "";
        for (i32 k = 0; k < out.length; k++) text = text + out[k] + "\n";
        if (is_info(text)) return text;
    }
    return "";
}

// The `kind` records of an info text: `include DIR` -> "DIR", `define N V` ->
// "N V", `has K a b` -> "K a b".
list<string> info_records(string info, string kind) {
    list<string> out;
    list<string> lines = split_all(info, '\n');
    string pre = kind + " ";
    for (i32 i = 0; i < lines.length; i++) {
        if (lines[i].starts_with(pre)) out.add(lines[i][pre.size:].dup);
        else if (lines[i] == kind) out.add("");
    }
    return out;
}

// True if the program `prog` (searched on PATH) is sic itself.
i32 is_sic_program(string prog) {
    list<string> r = run_lines("p=$(command -v " + prog + " 2>/dev/null) && readlink -f \"$p\"");
    if (r.length == 0) return 0;
    string path = r[0];
    i32 i = path.size - 1;
    while (i >= 0 && path[i] != '/') i--;
    string base = path[i+1:];
    return base == "sic" || base.starts_with("sic-") ? 1 : 0;
}

// `cmd`'s program part (`CC="gcc -m32"` -> gcc), "" if it is not on PATH.
string usable_program(string cmd) {
    string e = cmd.trim();
    i32 n = 0;
    while (n < e.size && !std::IsSpace(e[n])) n++;
    if (n == 0 || run_lines("command -v " + e[0:n] + " 2>/dev/null").length == 0) return "";
    return e[0:n].dup;
}

// The host C compiler to consult when no sic answers: `$SIC_HOST_CC`, else
// `$CC` unless that is sic, else the first of cc/gcc/clang on PATH. "" when
// none is available (then the filesystem probe is used).
string find_compiler() {
    char *host = getenv("SIC_HOST_CC");
    if (host && usable_program((string)host).size > 0) return ((string)host).trim().dup;
    char *env = getenv("CC");
    if (env) {
        string prog = usable_program((string)env);
        if (prog.size > 0 && !is_sic_program(prog)) return ((string)env).trim().dup;
    }
    list<string> names;
    names.add("cc"); names.add("gcc"); names.add("clang");
    for (i32 i = 0; i < names.length; i++) {
        string c = names[i];
        if (run_lines("command -v " + c + " 2>/dev/null").length > 0 && !is_sic_program(c)) return c;
    }
    return "";
}

// 1. The compiler's own `#include <...>` search list (empty if it gave none).
list<string> compiler_include_dirs(string cc) {
    list<string> dirs;
    if (cc.size == 0) return dirs;
    list<string> out = run_lines(cc + " -xc -E -v /dev/null 2>&1");
    i32 in_list = 0;
    for (i32 i = 0; i < out.length; i++) {
        string l = out[i];
        if (l.starts_with("#include <...> search starts here")) { in_list = 1; continue; }
        if (l.starts_with("End of search list")) break;
        if (in_list) {
            string d = l.trim();
            // macOS clang appends " (framework directory)" — not a header dir.
            if (d.size > 0 && !d.ends_with("(framework directory)")) dirs.add(d.dup);
        }
    }
    return dirs;
}

// The compiler's predefined macros (`-dM -E`) as `#define` lines: they describe
// the target ABI (__x86_64__/__aarch64__, __LP64__, __SIZEOF_*__, byte order, …)
// that system headers branch on.
list<string> compiler_predefines(string cc) {
    list<string> defs;
    if (cc.size == 0) return defs;
    list<string> out = run_lines(cc + " -xc -dM -E /dev/null 2>/dev/null");
    for (i32 i = 0; i < out.length; i++) if (out[i].starts_with("#define ")) defs.add(out[i]);
    return defs;
}

// 2. Filesystem probe for systems without a usable compiler.
list<string> probed_include_dirs() {
    list<string> dirs;
    list<string> um = run_lines("uname -m 2>/dev/null");
    string machine = um.length > 0 ? um[0] : "";

    // Multiarch dir: /usr/include/<triple> holding bits/ (glibc) or asm/ (kernel).
    string multiarch = "";
    list<string> cands = glob_paths("/usr/include/*-*/bits");
    list<string> more = glob_paths("/usr/include/*-*/asm");
    for (i32 i = 0; i < more.length; i++) cands.add(more[i]);
    for (i32 i = 0; i < cands.length; i++) {
        string d = dir_of(cands[i]);
        string triple = d[13:];   // after "/usr/include/"
        if (multiarch.size == 0 || (machine.size > 0 && triple.starts_with(machine) && !multiarch[13:].starts_with(machine)))
            multiarch = d.dup;
    }
    string host = multiarch.size > 0 ? multiarch[13:] : "";

    // Compiler-builtin headers: gcc's per-triple/per-version dir, else clang's
    // resource dir (target-independent). Prefer the exact multiarch triple, then
    // any triple for this machine; newest version wins.
    string builtin = "", best_ver = "";
    i32 best_rank = 0;
    list<string> gcc = glob_paths("/usr/lib/gcc/*/*/include/stddef.h");
    list<string> g64 = glob_paths("/usr/lib64/gcc/*/*/include/stddef.h");
    list<string> gloc = glob_paths("/usr/local/lib/gcc/*/*/include/stddef.h");
    for (i32 i = 0; i < g64.length; i++) gcc.add(g64[i]);
    for (i32 i = 0; i < gloc.length; i++) gcc.add(gloc[i]);
    for (i32 i = 0; i < gcc.length; i++) {
        string inc = dir_of(gcc[i]);            // …/gcc/<triple>/<ver>/include
        string verdir = dir_of(inc);
        string ver = verdir[dir_of(verdir).size + 1:];
        string tdir = dir_of(verdir);
        string triple = tdir[dir_of(tdir).size + 1:];
        i32 rank = 0;
        if (host.size > 0 && triple == host) rank = 3;
        else if (machine.size > 0 && triple.starts_with(machine + "-") && triple.contains("linux")) rank = 2;
        else if (machine.size > 0 && triple.starts_with(machine + "-")) rank = 1;
        if (rank == 0) continue;               // a cross toolchain for another target
        if (rank > best_rank || (rank == best_rank && ver_cmp(ver, best_ver) > 0)) {
            best_rank = rank; best_ver = ver.dup; builtin = inc.dup;
        }
    }
    if (builtin.size == 0) {
        list<string> cl = glob_paths("/usr/lib/clang/*/include/stddef.h");
        list<string> cl2 = glob_paths("/usr/lib/llvm*/lib/clang/*/include/stddef.h");
        list<string> cl3 = glob_paths("/usr/lib64/clang/*/include/stddef.h");
        for (i32 i = 0; i < cl2.length; i++) cl.add(cl2[i]);
        for (i32 i = 0; i < cl3.length; i++) cl.add(cl3[i]);
        for (i32 i = 0; i < cl.length; i++) {
            string inc = dir_of(cl[i]);         // …/clang/<ver>/include
            string verdir = dir_of(inc);
            string ver = verdir[dir_of(verdir).size + 1:];
            if (builtin.size == 0 || ver_cmp(ver, best_ver) > 0) { best_ver = ver.dup; builtin = inc.dup; }
        }
    }

    if (builtin.size > 0) dirs.add(builtin);
    if (glob_paths("/usr/local/include").length > 0) dirs.add("/usr/local/include");
    if (multiarch.size > 0) dirs.add(multiarch);
    if (glob_paths("/usr/include").length > 0) dirs.add("/usr/include");
    return dirs;
}

// The host triple, from the multiarch include directory (`/usr/include/<triple>`
// holding `bits/` or `asm/`), else "" — used only by the no-compiler fallback.
string probed_triple() {
    list<string> um = run_lines("uname -m 2>/dev/null");
    string machine = um.length > 0 ? um[0] : "";
    list<string> cands = glob_paths("/usr/include/*-*/bits");
    list<string> more = glob_paths("/usr/include/*-*/asm");
    for (i32 i = 0; i < more.length; i++) cands.add(more[i]);
    string best = "";
    for (i32 i = 0; i < cands.length; i++) {
        string t = dir_of(cands[i])[13:];
        if (best.size == 0 || (machine.size > 0 && t.starts_with(machine) && !best.starts_with(machine))) best = t.dup;
    }
    if (best.size == 0 && machine.size > 0) best = machine + "-unknown";
    return best;
}

// Last-resort target macros when no compiler can be asked: the data model from
// sic-cpp's OWN types (it runs on the target), byte order from memory, and the
// architecture/OS from the host triple (`x86_64-linux-gnu` → `__x86_64__`,
// `__linux__`, `__gnu_linux__`, `__unix__`). Generic by construction.
void fallback_predefines(Preprocessor *pp) {
    pp->macros["__CHAR_BIT__"] = "O|8";
    pp->macros["__SIZEOF_SHORT__"] = "O|" + std::Fmt("{}", sizeof(short));
    pp->macros["__SIZEOF_INT__"] = "O|" + std::Fmt("{}", sizeof(int));
    pp->macros["__SIZEOF_LONG__"] = "O|" + std::Fmt("{}", sizeof(long));
    pp->macros["__SIZEOF_LONG_LONG__"] = "O|" + std::Fmt("{}", sizeof(long long));
    pp->macros["__SIZEOF_POINTER__"] = "O|" + std::Fmt("{}", sizeof(void*));
    pp->macros["__SIZEOF_FLOAT__"] = "O|4";
    pp->macros["__SIZEOF_DOUBLE__"] = "O|8";
    if (sizeof(long) == 8 && sizeof(void*) == 8) { pp->macros["__LP64__"] = "O|1"; pp->macros["_LP64"] = "O|1"; }
    else if (sizeof(long) == 4 && sizeof(void*) == 4) { pp->macros["__ILP32__"] = "O|1"; pp->macros["_ILP32"] = "O|1"; }
    pp->macros["__ORDER_LITTLE_ENDIAN__"] = "O|1234";
    pp->macros["__ORDER_BIG_ENDIAN__"] = "O|4321";
    pp->macros["__ORDER_PDP_ENDIAN__"] = "O|3412";
    u32 probe = 1;
    u8 *pb = (u8*)&probe;
    pp->macros["__BYTE_ORDER__"] = pb[0] == 1 ? "O|__ORDER_LITTLE_ENDIAN__" : "O|__ORDER_BIG_ENDIAN__";
    pp->macros["__USER_LABEL_PREFIX__"] = "O|";
    string triple = probed_triple();
    if (triple.size == 0) return;
    list<string> parts = split_all(triple, '-');
    string arch = parts[0];
    if (arch == "amd64") arch = "x86_64";
    if (arch == "i486" || arch == "i586" || arch == "i686") { pp->macros["__" + arch + "__"] = "O|1"; arch = "i386"; }
    if (arch.starts_with("arm") && arch != "arm64") arch = "arm";
    if (arch == "arm64") arch = "aarch64";
    pp->macros["__" + arch + "__"] = "O|1";
    if (arch == "x86_64") { pp->macros["__x86_64"] = "O|1"; pp->macros["__amd64__"] = "O|1"; pp->macros["__amd64"] = "O|1"; }
    if (arch.starts_with("riscv")) {
        pp->macros["__riscv"] = "O|1";
        pp->macros["__riscv_xlen"] = "O|" + std::Fmt("{}", sizeof(void*) * 8);
    }
    if (triple.contains("linux")) {
        pp->macros["__linux__"] = "O|1"; pp->macros["__linux"] = "O|1";
        pp->macros["__unix__"] = "O|1"; pp->macros["__unix"] = "O|1";
        pp->macros["__ELF__"] = "O|1";
        if (triple.contains("gnu")) pp->macros["__gnu_linux__"] = "O|1";
    }
    if (triple.contains("freebsd")) { pp->macros["__FreeBSD__"] = "O|1"; pp->macros["__unix__"] = "O|1"; pp->macros["__ELF__"] = "O|1"; }
    if (triple.contains("darwin") || triple.contains("apple")) { pp->macros["__APPLE__"] = "O|1"; pp->macros["__MACH__"] = "O|1"; }
}

// Which host predefines to adopt — the same policy as the sic compiler, so code
// preprocessed by sic-cpp sees what sic itself would:
//  * value-only numeric/type macros (`__SIZEOF_*__`, `*_MAX__`, `*_TYPE__`,
//    `__CHAR_BIT__`, byte order, float properties, `__GCC_ATOMIC_*` atomic ABI,
//    …) — always;
//  * target/OS/ABI identification (`__x86_64__`, `__aarch64__`, `__riscv*`,
//    `__linux__`, `__APPLE__`, `__LP64__`, `__ELF__`, …) — unless `-undef`;
//  * NOT compiler feature flags (`__OPTIMIZE__`, `__GNUC_*`, `__SSE2__`,
//    `__GCC_HAVE_*`, …), which would steer headers into code paths that assume
//    a full GCC/Clang frontend.
// The target set is recognised by NAME, so any arch/OS/libc is handled.
i32 keep_predefine(string name, i32 undef, i32 strict) {
    // Non-reserved spellings (`linux`, `unix`, `i386`) exist only in GNU modes.
    if (strict && name.size > 0 && name[0] != '_') return 0;
    if (name == "__CHAR_BIT__" || name == "__BYTE_ORDER__" || name == "__FLOAT_WORD_ORDER__"
        || name.starts_with("__ORDER_") || name.starts_with("__SIZEOF_") || name.starts_with("__ATOMIC_")
        || name.ends_with("_MAX__") || name.ends_with("_MIN__") || name.ends_with("_WIDTH__")
        || name.ends_with("_TYPE__") || name.starts_with("__FLT") || name.starts_with("__DBL_")
        || name.starts_with("__LDBL_") || name.starts_with("__DEC")
        || name == "__USER_LABEL_PREFIX__" || name == "__REGISTER_PREFIX__"
        // Target atomic ABI (lock-free levels, atomic_flag's set value).
        || name.starts_with("__GCC_ATOMIC_"))
        return 1;
    if (undef) return 0;
    // OS / object format / data model.
    if (name == "__linux__" || name == "__linux" || name == "linux" || name == "__gnu_linux__"
        || name == "__unix__" || name == "__unix" || name == "unix" || name == "__ELF__"
        || name == "__APPLE__" || name == "__MACH__" || name == "__FreeBSD__" || name == "__NetBSD__"
        || name == "__OpenBSD__" || name == "__DragonFly__" || name == "__sun" || name == "__sun__"
        || name == "__svr4__" || name == "__CYGWIN__" || name == "_WIN32" || name == "_WIN64"
        || name == "__MINGW32__" || name == "__MINGW64__" || name == "__ANDROID__" || name == "__HAIKU__"
        || name == "__EMSCRIPTEN__" || name == "__wasi__" || name == "__Fuchsia__"
        || name == "__LP64__" || name == "_LP64" || name == "__ILP32__" || name == "_ILP32")
        return 1;
    // CPU architecture families (and their variant/ABI macros).
    if (name.starts_with("__x86_64") || name.starts_with("__amd64") || name.starts_with("__i386")
        || name.starts_with("__i486") || name.starts_with("__i586") || name.starts_with("__i686")
        || name.starts_with("__aarch64") || name.starts_with("__AARCH64") || name.starts_with("__arm")
        || name.starts_with("__ARM_") || name.starts_with("__ARMEL") || name.starts_with("__ARMEB")
        || name.starts_with("__thumb") || name.starts_with("__riscv") || name.starts_with("__powerpc")
        || name.starts_with("__PPC") || name.starts_with("__ppc") || name.starts_with("_ARCH_PPC")
        || name.starts_with("__mips") || name.starts_with("_MIPS") || name.starts_with("__s390")
        || name.starts_with("__sparc") || name.starts_with("__loongarch") || name.starts_with("__wasm")
        || name.starts_with("__ia64") || name.starts_with("__alpha") || name.starts_with("__m68k")
        || name.starts_with("__hppa") || name == "__sh__" || name.starts_with("__SH")
        || name.starts_with("__or1k") || name.starts_with("__xtensa") || name.starts_with("__nios2")
        || name.starts_with("__csky") || name.starts_with("__arc__") || name.starts_with("__bpf"))
        return 1;
    return 0;
}

// The system include list: the compiler's own if it answers, else the probe.
list<string> system_include_dirs(string cc) {
    list<string> dirs = compiler_include_dirs(cc);
    if (dirs.length == 0) dirs = probed_include_dirs();
    return dirs;
}

// Append `d` unless already present (gcc drops a duplicate search dir).
void add_dir(list<string> *dirs, string d) {
    for (i32 i = 0; i < dirs->length; i++) if ((*dirs)[i] == d) return;
    dirs->add(d);
}

// Append the entries of a colon-separated environment path list (CPATH etc.).
void add_env_dirs(list<string> *dirs, string var) {
    char *v = getenv(var.str);
    if (!v) return;
    list<string> parts = split_all((string)v, ':');
    for (i32 i = 0; i < parts.length; i++) if (parts[i].size > 0) add_dir(dirs, parts[i]);
}

// `n` spaces (for output indentation / blanked-out comments).
string spaces(i32 n) {
    string blank = "                                                                ";
    string out = "";
    while (n > blank.size) { out = out + blank; n -= blank.size; }
    return out + blank[0:n];
}

// ── Comment stripping ───────────────────────────────────────────────────────

// -C (1) / -CC (2): keep comments in the output instead of stripping them.
// Global because the tokenizer has no preprocessor handle.
i32 g_keep_comments = 0;

// Whether `line` ends inside an unterminated block comment (literals skipped).
i32 open_block_comment(string line) {
    i32 i = 0;
    while (i < line.size) {
        i32 c = line[i];
        if (c == '"' || c == '\'') {
            i32 q = c; i++;
            while (i < line.size && line[i] != q) { if (line[i] == '\\') i++; i++; }
            i++; continue;
        }
        if (c == '/' && i + 1 < line.size && line[i+1] == '/') return 0;
        if (c == '/' && i + 1 < line.size && line[i+1] == '*') {
            i += 2;
            while (i + 1 < line.size && !(line[i] == '*' && line[i+1] == '/')) i++;
            if (i + 1 >= line.size) return 1;
            i += 2; continue;
        }
        i++;
    }
    return 0;
}

// -CC: inside a macro body a `//` comment would swallow the rest of the line
// the macro is expanded into, so it becomes a block comment (as gcc does).
string line_comments_to_block(string text) {
    string out = "";
    i32 i = 0;
    while (i < text.size) {
        i32 c = text[i];
        if (c == '"' || c == '\'') {
            i32 st = i; i++;
            while (i < text.size && text[i] != c) { if (text[i] == '\\') i++; i++; }
            if (i < text.size) i++;
            out = out + text[st:i]; continue;
        }
        if (c == '/' && i + 1 < text.size && text[i+1] == '*') {
            i32 st = i; i += 2;
            while (i + 1 < text.size && !(text[i] == '*' && text[i+1] == '/')) i++;
            i = i + 2 <= text.size ? i + 2 : text.size;
            out = out + text[st:i]; continue;
        }
        if (c == '/' && i + 1 < text.size && text[i+1] == '/') {
            out = out + "/*" + text[i+2:].rtrim() + " */";
            return out;
        }
        out = out + text[i:i+1]; i++;
    }
    return out;
}

// Replace C comments with whitespace over the WHOLE source before line-splitting,
// so a `/* … */` spanning multiple lines is handled (the per-line tokenizer can't
// see across lines). A block comment becomes a single space, but its embedded
// newlines are preserved so line numbering and directive boundaries survive; a
// `//` line comment is dropped to end of line. String and character literals are
// copied verbatim so `"a/*b"` / `'/'` are not mistaken for comments.
// Whether the logical line starting at s[i] is a directive (first non-blank `#`).
i32 directive_starts(string s, i32 i) {
    while (i < s.size && (s[i] == ' ' || s[i] == '\t')) i++;
    return i < s.size && s[i] == '#' ? 1 : 0;
}

string strip_comments(string s) {
    // Each comment is replaced by SPACES of the same width (its newlines kept),
    // so line numbers, directive boundaries and token columns all survive — gcc
    // indents `-P` output by the first token's source column, and a comment
    // before it counts. Verbatim text is copied as whole slices, one
    // concatenation per comment line (linear in the file size).
    // Comments go before directives are split into lines (C11 5.1.1.2 phase 3):
    // a block comment spanning lines inside a directive does not end it (glib's
    // `#define G_C_STD_CHECK_VERSION(version) ( … /* …\n … */ \` ), so there its
    // newlines become line splices — the directive stays one logical line and
    // the physical line count is kept.
    string out = "";
    i32 run = 0;   // start of the pending verbatim run
    i32 i = 0;
    i32 dir = directive_starts(s, 0);   // is the current logical line a directive?
    while (i < s.size) {
        i32 c = s[i];
        if (c == '\n') {
            if (i == 0 || s[i-1] != '\\') dir = directive_starts(s, i + 1);
            i++;
            continue;
        }
        if (c == '/' && i + 1 < s.size && s[i+1] == '*') {
            out = out + s[run:i];
            i32 col = i;   // start of the current blanked segment
            i += 2;
            while (i + 1 < s.size && !(s[i] == '*' && s[i+1] == '/')) {
                if (s[i] == '\n') { out = out + spaces(i - col) + (dir ? "\\\n" : "\n"); col = i + 1; }
                i++;
            }
            i = i + 2 <= s.size ? i + 2 : s.size;   // skip the closing */
            out = out + spaces(i - col);
            run = i;
            continue;
        }
        if (c == '/' && i + 1 < s.size && s[i+1] == '/') {
            // A line comment runs to the end of the LOGICAL line: a backslash-
            // newline continues it (phase 2 splices before phase 3); each spliced
            // newline is kept so the line count survives.
            out = out + s[run:i];
            while (i < s.size && !(s[i] == '\n' && s[i-1] != '\\')) {
                if (s[i] == '\n') out = out + "\n";
                i++;
            }
            run = i;   // the newline itself stays in the next run
            continue;
        }
        if (c == '"' || c == '\'') {
            // A literal is part of the verbatim run; just skip over it.
            i32 q = c; i++;
            while (i < s.size && s[i] != q) { if (s[i] == '\\' && i + 1 < s.size) i++; i++; }
            if (i < s.size) i++;
            continue;
        }
        i++;
    }
    return out + s[run:s.size];
}

// ── Tokenizer ──────────────────────────────────────────────────────────────

// A painted identifier (C11 6.10.3.4p2: a macro's own name met while that
// macro is being replaced) is the token "\x04name": never expanded again, in
// any later pass — `strchr(S,C)` → `…(strchr (S, C))` must keep the inner
// `strchr` (it used to be re-expanded each pass, growing exponentially). The
// mark survives the text round-trips of argument substitution and is removed
// from the output, from stringized text and from pasted tokens.
// "\x05name" marks a PENDING function-like macro name: one met at the very end
// of a replacement/argument (no `(` follows in its own context). Whether it is
// invoked is decided by what follows that context (see emit_rescan).
string unpaint(string s) {
    if (!s.contains("\x04") && !s.contains("\x05")) return s;
    string out = "";
    for (i32 i = 0; i < s.size; i++) if (s[i] != 4 && s[i] != 5) out = out + s[i:i+1];
    return out;
}

list<string> tokenize(string input) {
    list<string> tokens;
    i32 i = 0;
    while (i < input.size) {
        i32 ch = input[i];
        if ((ch == 4 || ch == 5) && i + 1 < input.size && is_ident_start(input[i+1])) {
            i32 start = i;
            i++;
            while (i < input.size && is_ident(input[i])) i++;
            tokens.add(input[start:i]); continue;
        }
        if (std::IsSpace(ch)) {
            tokens.add(" ");
            while (i < input.size && std::IsSpace(input[i])) i++;
            continue;
        }
        if (ch == '/' && i + 1 < input.size && input[i+1] == '*') {
            i32 st = i;
            i += 2;
            while (i + 1 < input.size && !(input[i] == '*' && input[i+1] == '/')) i++;
            i += 2;
            if (i > input.size) i = input.size;
            // -C/-CC: the comment is output as a token; otherwise it is a space.
            if (g_keep_comments) tokens.add(input[st:i]); else tokens.add(" ");
            continue;
        }
        if (ch == '/' && i + 1 < input.size && input[i+1] == '/') {
            i32 st = i;
            while (i < input.size && input[i] != '\n') i++;
            if (g_keep_comments) tokens.add(input[st:i].rtrim());
            continue;
        }
        if (is_ident_start(ch)) {
            i32 start = i;
            while (i < input.size && is_ident(input[i])) i++;
            tokens.add(input[start:i]); continue;
        }
        if (ch >= '0' && ch <= '9') {
            i32 start = i;
            if (ch == '0' && i+1 < input.size && (input[i+1] == 'x' || input[i+1] == 'X')) i += 2;
            else if (ch == '0' && i+1 < input.size && (input[i+1] == 'b' || input[i+1] == 'B')) i += 2;
            while (i < input.size && (is_ident(input[i]) || input[i] == '.')) i++;
            tokens.add(input[start:i]); continue;
        }
        if (ch == '"') {
            i32 start = i; i++;
            while (i < input.size && input[i] != '"') { if (input[i] == '\\') i++; i++; }
            if (i < input.size && input[i] == '"') i++;
            tokens.add(input[start:i]); continue;
        }
        if (ch == '\'') {
            i32 start = i; i++;
            while (i < input.size && input[i] != '\'') { if (input[i] == '\\') i++; i++; }
            if (i < input.size && input[i] == '\'') i++;
            tokens.add(input[start:i]); continue;
        }
        // Multi-char punctuators
        if (ch == '<' && i+1 < input.size && input[i+1] == '<') { tokens.add("<<"); i+=2; continue; }
        if (ch == '>' && i+1 < input.size && input[i+1] == '>') { tokens.add(">>"); i+=2; continue; }
        if (ch == '=' && i+1 < input.size && input[i+1] == '=') { tokens.add("=="); i+=2; continue; }
        if (ch == '!' && i+1 < input.size && input[i+1] == '=') { tokens.add("!="); i+=2; continue; }
        if (ch == '<' && i+1 < input.size && input[i+1] == '=') { tokens.add("<="); i+=2; continue; }
        if (ch == '>' && i+1 < input.size && input[i+1] == '=') { tokens.add(">="); i+=2; continue; }
        if (ch == '&' && i+1 < input.size && input[i+1] == '&') { tokens.add("&&"); i+=2; continue; }
        if (ch == '|' && i+1 < input.size && input[i+1] == '|') { tokens.add("||"); i+=2; continue; }
        if (ch == '+' && i+1 < input.size && input[i+1] == '+') { tokens.add("++"); i+=2; continue; }
        if (ch == '-' && i+1 < input.size && input[i+1] == '-') { tokens.add("--"); i+=2; continue; }
        if (ch == '-' && i+1 < input.size && input[i+1] == '>') { tokens.add("->"); i+=2; continue; }
        if (ch == '#' && i+1 < input.size && input[i+1] == '#') { tokens.add("##"); i+=2; continue; }
        if (ch == '.' && i+1 < input.size && i+2 < input.size
            && input[i+1] == '.' && input[i+2] == '.') { tokens.add("..."); i+=3; continue; }
        tokens.add(input[i:i+1]); i++;
    }
    return tokens;
}

// ── Expression evaluator ──────────────────────────────────────────────────

// The evaluator is a recursive-descent parser over a shrinking VIEW of the
// expression: each function takes `string *r`, the remaining text to parse, and
// consumes from its front by re-slicing (`*r = (*r)[n:]`) — no copies, no indices.
// `peek`/`peek2` read the front without consuming; `skip_ws` drops leading space.

// C-identifier rules (parser-specific, so not in std).
i32 is_ident_start(i32 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
i32 is_ident(i32 c) { return is_ident_start(c) || (c >= '0' && c <= '9'); }

i32 peek(string r)  { return r.size > 0 ? r[0] : 0; }
i32 peek2(string r) { return r.size > 1 ? r[1] : 0; }
void skip_ws(string *r) { *r = (*r).ltrim(); }

i32 eval_expr(string *r, dict<string, string> *macros);

i32 eval_primary(string *r, dict<string, string> *macros) {
    skip_ws(r);
    if ((*r).size == 0) return 0;

    // defined NAME / defined(NAME) — a leftover fallback (pp_if pre-substitutes).
    if ((*r).starts_with("defined") && !is_ident(peek((*r)[7:]))) {
        *r = (*r)[7:];
        skip_ws(r);
        i32 paren = peek(*r) == '(';
        if (paren) *r = (*r)[1:];
        skip_ws(r);
        i32 n = 0;
        while (n < (*r).size && is_ident((*r)[n])) n++;
        string name = (*r)[0:n];
        *r = (*r)[n:];
        skip_ws(r);
        if (paren && peek(*r) == ')') *r = (*r)[1:];
        return (*macros)[name].size >= 2 ? 1 : 0;
    }

    i32 c = peek(*r);
    if (c == '(') {
        *r = (*r)[1:];
        i32 val = eval_expr(r, macros);
        skip_ws(r);
        if (peek(*r) == ')') *r = (*r)[1:];
        return val;
    }
    if (c == '+') { *r = (*r)[1:]; return eval_primary(r, macros); }
    if (c == '-') { *r = (*r)[1:]; return -eval_primary(r, macros); }
    if (c == '~') { *r = (*r)[1:]; return ~eval_primary(r, macros); }
    if (c == '!') { *r = (*r)[1:]; return eval_primary(r, macros) ? 0 : 1; }

    // Number literal
    if (c >= '0' && c <= '9') {
        i32 val = 0, radix = 10;
        if (c == '0' && (peek2(*r) == 'x' || peek2(*r) == 'X')) { radix = 16; *r = (*r)[2:]; }
        else if (c == '0' && (peek2(*r) == 'b' || peek2(*r) == 'B')) { radix = 2; *r = (*r)[2:]; }
        else if (c == '0') { radix = 8; *r = (*r)[1:]; }
        while ((*r).size > 0) {
            i32 ch = (*r)[0];
            i32 d = -1;
            if (ch >= '0' && ch <= '9') d = ch - '0';
            else if (radix == 16 && ch >= 'a' && ch <= 'f') d = ch - 'a' + 10;
            else if (radix == 16 && ch >= 'A' && ch <= 'F') d = ch - 'A' + 10;
            else break;
            if (d >= radix) break;
            val = val * radix + d;
            *r = (*r)[1:];
        }
        while (peek(*r) == 'U' || peek(*r) == 'u' || peek(*r) == 'L' || peek(*r) == 'l') *r = (*r)[1:];
        return val;
    }

    // Char constant
    if (c == '\'') {
        *r = (*r)[1:];
        i32 val = 0;
        if (peek(*r) == '\\') {
            *r = (*r)[1:];
            i32 e = peek(*r);
            if (e == 'n') val = 10;
            else if (e == 't') val = 9;
            else if (e == 'r') val = 13;
            else if (e == '0') val = 0;
            else val = e;
            if ((*r).size > 0) *r = (*r)[1:];
        } else if ((*r).size > 0) { val = (*r)[0]; *r = (*r)[1:]; }
        while ((*r).size > 0 && (*r)[0] != '\'') *r = (*r)[1:];
        if (peek(*r) == '\'') *r = (*r)[1:];
        return val;
    }

    // Unknown identifier → 0 (per C, an undefined macro in #if is 0).
    while ((*r).size > 0 && is_ident((*r)[0])) *r = (*r)[1:];
    return 0;
}

i32 eval_mul(string *r, dict<string, string> *m) {
    i32 val = eval_primary(r, m);
    skip_ws(r);
    while (peek(*r) == '*' || peek(*r) == '/' || peek(*r) == '%') {
        i32 op = peek(*r); *r = (*r)[1:];
        i32 rhs = eval_primary(r, m);
        if (op == '*') val *= rhs; else if (op == '/') val = rhs ? val / rhs : 0; else val = rhs ? val % rhs : 0;
        skip_ws(r);
    }
    return val;
}

i32 eval_add(string *r, dict<string, string> *m) {
    i32 val = eval_mul(r, m);
    skip_ws(r);
    while (peek(*r) == '+' || peek(*r) == '-') {
        i32 op = peek(*r); *r = (*r)[1:];
        i32 rhs = eval_mul(r, m);
        if (op == '+') val += rhs; else val -= rhs;
        skip_ws(r);
    }
    return val;
}

i32 eval_shift(string *r, dict<string, string> *m) {
    i32 val = eval_add(r, m);
    skip_ws(r);
    while ((peek(*r) == '<' && peek2(*r) == '<') || (peek(*r) == '>' && peek2(*r) == '>')) {
        i32 op = peek(*r); *r = (*r)[2:];
        i32 rhs = eval_add(r, m);
        if (op == '<') val <<= rhs; else val >>= rhs;
        skip_ws(r);
    }
    return val;
}

i32 eval_rel(string *r, dict<string, string> *m) {
    i32 val = eval_shift(r, m);
    skip_ws(r);
    while (true) {
        i32 c = peek(*r);
        if (c == '<' && peek2(*r) == '=') { *r = (*r)[2:]; val = val <= eval_shift(r, m) ? 1 : 0; }
        else if (c == '>' && peek2(*r) == '=') { *r = (*r)[2:]; val = val >= eval_shift(r, m) ? 1 : 0; }
        else if (c == '<') { *r = (*r)[1:]; val = val < eval_shift(r, m) ? 1 : 0; }
        else if (c == '>') { *r = (*r)[1:]; val = val > eval_shift(r, m) ? 1 : 0; }
        else break;
        skip_ws(r);
    }
    return val;
}

i32 eval_eq(string *r, dict<string, string> *m) {
    i32 val = eval_rel(r, m);
    skip_ws(r);
    while ((peek(*r) == '=' && peek2(*r) == '=') || (peek(*r) == '!' && peek2(*r) == '=')) {
        i32 ne = peek(*r) == '!'; *r = (*r)[2:];
        i32 rhs = eval_rel(r, m);
        val = (ne ? val != rhs : val == rhs) ? 1 : 0;
        skip_ws(r);
    }
    return val;
}

i32 eval_and(string *r, dict<string, string> *m) {
    i32 val = eval_eq(r, m);
    skip_ws(r);
    while (peek(*r) == '&' && peek2(*r) != '&') {
        *r = (*r)[1:]; val &= eval_eq(r, m);
        skip_ws(r);
    }
    return val;
}

i32 eval_xor(string *r, dict<string, string> *m) {
    i32 val = eval_and(r, m);
    skip_ws(r);
    while (peek(*r) == '^') { *r = (*r)[1:]; val ^= eval_and(r, m); skip_ws(r); }
    return val;
}

i32 eval_or(string *r, dict<string, string> *m) {
    i32 val = eval_xor(r, m);
    skip_ws(r);
    while (peek(*r) == '|' && peek2(*r) != '|') {
        *r = (*r)[1:]; val |= eval_xor(r, m);
        skip_ws(r);
    }
    return val;
}

i32 eval_land(string *r, dict<string, string> *m) {
    i32 val = eval_or(r, m);
    skip_ws(r);
    while (peek(*r) == '&' && peek2(*r) == '&') {
        // Always PARSE the right operand (a short-circuiting `val && eval_or(r)`
        // would skip it and leave the cursor before it); combine afterwards.
        *r = (*r)[2:]; i32 rhs = eval_or(r, m); val = (val && rhs) ? 1 : 0;
        skip_ws(r);
    }
    return val;
}

i32 eval_lor(string *r, dict<string, string> *m) {
    i32 val = eval_land(r, m);
    skip_ws(r);
    while (peek(*r) == '|' && peek2(*r) == '|') {
        *r = (*r)[2:]; i32 rhs = eval_land(r, m); val = (val || rhs) ? 1 : 0;   // parse rhs always
        skip_ws(r);
    }
    return val;
}

i32 eval_ternary(string *r, dict<string, string> *m) {
    i32 val = eval_lor(r, m);
    skip_ws(r);
    if (peek(*r) == '?') {
        *r = (*r)[1:];
        i32 t_val = eval_expr(r, m);
        skip_ws(r);
        if (peek(*r) == ':') { *r = (*r)[1:]; i32 f_val = eval_ternary(r, m); return val ? t_val : f_val; }
    }
    return val;
}

i32 eval_expr(string *r, dict<string, string> *macros) {
    return eval_ternary(r, macros);
}

i32 eval_if_expr(string expr, dict<string, string> *macros) {
    string r = expr;
    return eval_expr(&r, macros);
}

// ── Macro expansion ───────────────────────────────────────────────────────

// Is `name` already being expanded (the C "blue paint" hide set)? A macro in the
// active set is emitted literally instead of re-expanded, so `#define A B` /
// `#define B A` terminates (yielding `A`) instead of recursing forever.
i32 name_active(list<string> active, string name) {
    for (i32 i = 0; i < active.length; i++) if (active[i] == name) return 1;
    return 0;
}

// Token pasting (C11 6.10.3.3): `a ## b` joins its operands into ONE token, and
// this happens BEFORE the replacement list is rescanned — so `J(N, 1)` with
// `J(a,b) a##b` yields `N1` even if `N` is itself a macro. Spaces around `##` are
// dropped; chains `a ## b ## c` fold left to right.
list<string> paste_tokens(list<string> t) {
    list<string> out;
    i32 i = 0;
    while (i < t.length) {
        if (t[i] == "##") { i++; continue; }          // stray leading `##`
        string acc = t[i];
        i32 j = i + 1;
        while (true) {
            i32 k = j;
            while (k < t.length && t[k] == " ") k++;
            if (k >= t.length || t[k] != "##" || acc == " ") break;
            k++;
            while (k < t.length && t[k] == " ") k++;
            if (k < t.length) { acc = unpaint(acc) + unpaint(t[k]); k++; }   // a new token
            j = k;
        }
        out.add(acc);
        i = j;
    }
    return out;
}

list<string> expand_tokens(list<string> tokens, dict<string, string> *macros,
                         i32 cur_line, string cur_file, list<string> active);

// Emit `be`, the expansion of a macro use that ended just before tokens[k],
// fenced with padding. The expansion is rescanned "along with all subsequent
// preprocessing tokens" (C11 6.10.3.4p1): when it ends in a function-like macro
// name and the source continues with `(`, that name is expanded together with
// the rest of `tokens` (`f(2)(9)`, `id(g)(3)`) — in the outer context, as the
// macro whose expansion it ended has been left. Returns 1 when the rest of
// `tokens` was consumed that way.
i32 emit_rescan(list<string> *out, list<string> be, list<string> tokens, i32 k,
                dict<string, string> *macros, i32 cur_line, string cur_file, list<string> active) {
    // A pending name ends the expansion — bare, or with an unclosed argument
    // list. A bare one is invoked if `(` follows here, stays pending if this
    // context ends too, and is otherwise not a call; an unclosed call always
    // continues into the tokens that follow (or stays pending at their end).
    i32 last = be.length - 1;
    while (last >= 0 && (be[last] == " " || be[last] == "\x03")) last--;
    i32 open_call = 0;
    if (last >= 0 && be[last][0] != 5) {
        i32 p = last;
        while (p >= 0 && be[p][0] != 5) p--;
        if (p >= 0) {
            i32 q = p + 1;
            while (q < be.length && (be[q] == " " || be[q] == "\x03")) q++;
            if (q < be.length && be[q] == "(") {
                i32 d = 0;
                for (i32 t = q; t < be.length; t++) { if (be[t] == "(") d++; else if (be[t] == ")") d--; }
                if (d > 0) { open_call = 1; last = p; }
            }
        }
    }
    i32 splice = 0;
    i32 n = k;
    while (n < tokens.length && (tokens[n] == " " || tokens[n] == "\x03")) n++;
    if (last >= 0 && be[last][0] == 5) {
        if (n < tokens.length && (open_call || tokens[n] == "(")) splice = 1;
        else if (n < tokens.length) be[last] = be[last][1:];
    }
    i32 end = splice ? last : be.length;
    out->add("\x03");   // padding: the expansion's boundaries
    for (i32 ei = 0; ei < end; ei++) {
        if (be[ei] == " ") { if (out->length == 0 || (*out)[out->length-1] != " ") out->add(" "); }
        else out->add(be[ei]);
    }
    if (!splice) { out->add("\x03"); return 0; }
    list<string> rest;
    rest.add(be[last][1:]);
    for (i32 t = last + 1; t < be.length; t++) if (be[t] != "\x03") rest.add(be[t]);   // an open call's partial args
    for (i32 t = k; t < tokens.length; t++) rest.add(tokens[t]);
    list<string> re = expand_tokens(rest, macros, cur_line, cur_file, active);
    for (i32 t = 0; t < re.length; t++) out->add(re[t]);
    return 1;
}

list<string> expand_tokens(list<string> tokens, dict<string, string> *macros,
                         i32 cur_line, string cur_file, list<string> active) {
    list<string> out;
    for (i32 i = 0; i < tokens.length; i++) {
        string tok = tokens[i];
        if (tok == "##") continue;
        if (tok == " ") {
            // Keep a space that follows tokens which expanded to nothing (`i > 0`
            // with nothing emitted yet): gcc prints it before the first printed
            // token (`EMPTY int d;` → ` int d;`). Plain leading whitespace drops.
            if (out.length > 0 ? out[out.length-1] != " " : i > 0) out.add(" ");
            continue;
        }
        // Predefined dynamic macros
        if (tok == "__LINE__") { out.add(std::Fmt("{}", cur_line)); continue; }
        if (tok == "__FILE__") { out.add("\"" + cur_file + "\""); continue; }
        if (tok == "__DATE__") { out.add("\"Jan  1 2026\""); continue; }
        if (tok == "__TIME__") { out.add("\"00:00:00\""); continue; }
        if (tok == "__STDC__") { out.add("1"); continue; }

        // Macro lookup. A macro already being expanded is emitted painted — never
        // re-expanded, in this pass or a later one — so recursive macros terminate.
        if (tok[0] == 5) tok = tok[1:];   // a pending name is considered afresh here
        if (name_active(active, tok) && macros[tok].size >= 2) tok = "\x04" + tok;
        string enc = tok[0] == 4 ? "" : macros[tok];
        if (enc.size >= 2) {
            // The expansion of this macro hides its own name.
            list<string> nactive;
            for (i32 ni = 0; ni < active.length; ni++) nactive.add(active[ni]);
            nactive.add(tok);
            if (enc[0] == 'F') {
                // Function-like: is the next token '(' ? (Padding is transparent;
                // any other token — even a macro expanding to nothing — is not.)
                i32 j = i + 1;
                while (j < tokens.length && (tokens[j] == " " || tokens[j] == "\x03")) j++;
                if (j >= tokens.length) { out.add("\x05" + tok); continue; }   // pending
                if (j < tokens.length && tokens[j] == "(") {
                    // Collect arg text between balanced parens
                    i32 k = j + 1, depth = 1;
                    while (k < tokens.length && depth > 0) {
                        if (tokens[k] == "(") depth++;
                        else if (tokens[k] == ")") depth--;
                        k++;
                    }
                    if (depth > 0) {
                        // The argument list runs past this context (`#define h g(~`
                        // used as `h 5)`): pending, with its raw partial arguments;
                        // the enclosing context completes the call (emit_rescan).
                        out.add("\x05" + tok);
                        for (i32 t = i + 1; t < tokens.length; t++) out.add(tokens[t]);
                        return out;
                    }
                    // The arguments split at top-level `,` TOKENS: a comma inside a
                    // string/char literal (one token) or nested parentheses does not
                    // separate (C11 6.10.3p11; brackets and braces do not group).
                    string arg_str = "";
                    string cur_arg = "";
                    list<string> split_args;
                    i32 adepth = 0;
                    for (i32 ai = j+1; ai < k-1; ai++) {
                        if (tokens[ai] == " " && arg_str.size > 0 && arg_str[arg_str.size-1] == ' ') continue;
                        if (tokens[ai] == "\x03") continue;          // padding is not argument text
                        arg_str = arg_str + tokens[ai];
                        if (tokens[ai] == "(") adepth++;
                        else if (tokens[ai] == ")") adepth--;
                        if (tokens[ai] == "," && adepth == 0) { split_args.add(cur_arg); cur_arg = ""; }
                        else cur_arg = cur_arg + tokens[ai];
                    }
                    split_args.add(cur_arg);
                    // Parse | separated encoding: "F|params|body"
                    tuple ep = enc.split("|");
                    string params_section = "";
                    string body = "";
                    if (ep.length >= 2) {
                        if (enc[0] == 'F') {
                            tuple ep2 = ep[1].split("|");
                            if (ep2.length >= 2) { params_section = ep2[0]; body = ep2[1]; }
                            else { body = ep[1]; }
                        } else {
                            body = ep[1];
                        }
                    }

                    // Split params by comma, args by top-level comma
                    list<string> param_names;
                    i32 pi = 0;
                    while (pi < params_section.size) {
                        i32 ps = pi;
                        while (pi < params_section.size && params_section[pi] != ',') pi++;
                        param_names.add(params_section[ps:pi].trim());   // `(maj, min)`: drop the space
                        if (pi < params_section.size && params_section[pi] == ',') { if (pi+1 < params_section.size) pi++; else break; }
                    }

                    list<string> args_list;
                    // `M()` on a macro WITH parameters passes one empty argument
                    // (C11 6.10.3p4), so `#x` of it is `""`.
                    if (arg_str.size > 0 || param_names.length > 0) args_list = split_args;

                    // Variadic macro (C11 6.10.3p12): a trailing `...` is named
                    // `__VA_ARGS__` (GNU `name...` names it `name`) and receives every
                    // remaining argument, commas included.
                    if (param_names.length > 0 && param_names[param_names.length-1].ends_with("...")) {
                        string last = param_names[param_names.length-1];
                        string vname = last == "..." ? "__VA_ARGS__" : last[0:last.size-3].trim();
                        i32 nfixed = param_names.length - 1;
                        list<string> pn2;
                        for (i32 k = 0; k < nfixed; k++) pn2.add(param_names[k]);
                        pn2.add(vname);
                        param_names = pn2;
                        list<string> al2;
                        for (i32 k = 0; k < nfixed && k < args_list.length; k++) al2.add(args_list[k]);
                        while (al2.length < nfixed) al2.add("");
                        string va = "";
                        for (i32 k = nfixed; k < args_list.length; k++) { if (k > nfixed) va = va + ","; va = va + args_list[k]; }
                        al2.add(va);
                        args_list = al2;
                    }

                    // Stringize `#param` → "<raw arg>" (the UNexpanded argument,
                    // C11 6.10.3.2). Done before normal substitution so the `#`
                    // operator sees the parameter, not its replacement. A `##` is
                    // left alone (handled as token-paste elsewhere).
                    {
                        string sb = "";
                        i32 si = 0;
                        while (si < body.size) {
                            // Leave `##` (token paste) intact — consume both chars.
                            if (body[si] == '#' && si + 1 < body.size && body[si+1] == '#') {
                                sb = sb + "##"; si += 2; continue;
                            }
                            if (body[si] == '#') {
                                i32 sj = si + 1;
                                while (sj < body.size && (body[sj] == ' ' || body[sj] == '\t')) sj++;
                                i32 ns = sj;
                                while (sj < body.size && is_ident(body[sj])) sj++;
                                string nm = body[ns:sj];
                                i32 matched = -1;
                                for (i32 pp2 = 0; pp2 < param_names.length && pp2 < args_list.length; pp2++)
                                    if (nm.size > 0 && param_names[pp2] == nm) { matched = pp2; break; }
                                if (matched >= 0) {
                                    sb = sb + stringize_arg(args_list[matched]);
                                    si = sj; continue;
                                }
                            }
                            sb = sb + body[si:si+1];
                            si++;
                        }
                        body = sb;
                    }

                    // Parameter substitution — ONE left-to-right pass over the body
                    // (C11 6.10.3.1): string/char literals are copied verbatim (so the
                    // stringized `"…x…"` above is not re-substituted), each parameter
                    // name is replaced exactly once (an argument containing another
                    // parameter's name is not substituted again), and an operand of
                    // `##` gets the RAW argument while every other use gets the fully
                    // macro-expanded one.
                    list<string> arg_exps;
                    for (i32 pi2 = 0; pi2 < param_names.length && pi2 < args_list.length; pi2++) {
                        list<string> atok = tokenize(args_list[pi2]);
                        list<string> aexp = expand_tokens(atok, macros, cur_line, cur_file, active);
                        string arg_exp = "";
                        for (i32 ei = 0; ei < aexp.length; ei++) {
                            if (aexp[ei] == " ") { if (arg_exp.size > 0 && arg_exp[arg_exp.size-1] != ' ') arg_exp = arg_exp + " "; }
                            else arg_exp = arg_exp + aexp[ei];
                        }
                        arg_exps.add(arg_exp.trim().dup);
                    }
                    {
                        string nb = "";
                        i32 bi = 0;
                        while (bi < body.size) {
                            i32 c = body[bi];
                            if (c == '"' || c == '\'') {
                                i32 st = bi; bi++;
                                while (bi < body.size && body[bi] != c) { if (body[bi] == '\\') bi++; bi++; }
                                if (bi < body.size) bi++;
                                nb = nb + body[st:bi];
                                continue;
                            }
                            if (is_ident_start(c)) {
                                i32 st = bi;
                                while (bi < body.size && is_ident(body[bi])) bi++;
                                string word = body[st:bi];
                                i32 pidx = -1;
                                for (i32 k = 0; k < param_names.length && k < args_list.length; k++)
                                    if (param_names[k] == word) { pidx = k; break; }
                                if (pidx < 0) { nb = nb + word; continue; }
                                // Adjacent to `##` (either side, spaces allowed)?
                                i32 l = st - 1;
                                while (l >= 0 && (body[l] == ' ' || body[l] == '\t')) l--;
                                i32 r = bi;
                                while (r < body.size && (body[r] == ' ' || body[r] == '\t')) r++;
                                i32 pasted = (l >= 1 && body[l] == '#' && body[l-1] == '#')
                                          || (r + 1 < body.size && body[r] == '#' && body[r+1] == '#');
                                // An expanded argument is fenced with padding (`\x03`):
                                // where it meets a neighbour without whitespace, the
                                // final join decides whether a space is needed.
                                nb = nb + (pasted ? args_list[pidx].trim() : "\x03" + arg_exps[pidx] + "\x03");
                                continue;
                            }
                            nb = nb + body[bi:bi+1];
                            bi++;
                        }
                        body = nb;
                    }

                    // Expand body and emit
                    list<string> bt = paste_tokens(tokenize(body));
                    list<string> be = expand_tokens(bt, macros, cur_line, cur_file, nactive);
                    if (emit_rescan(&out, be, tokens, k, macros, cur_line, cur_file, active)) return out;
                i = k - 1; continue;
                }
            } else if (enc[0] == 'O') {
                tuple ep = enc.split("|");
                string body = ep.length >= 2 ? ep[1] : "";
                list<string> bt = paste_tokens(tokenize(body));
                list<string> be = expand_tokens(bt, macros, cur_line, cur_file, nactive);
                if (emit_rescan(&out, be, tokens, i + 1, macros, cur_line, cur_file, active)) return out;
                continue;
            }
        }
        // ## token pasting: if next token is ##, skip space
        if (i + 1 < tokens.length && tokens[i + 1] == "##") {
            out.add(tok); i++;
            while (i + 1 < tokens.length && tokens[i + 1] == " ") i++;
            continue;
        }
        out.add(tok);
    }
    return out;
}

// gcc's cpp_avoid_paste: would token `a` immediately followed by token `b`
// lex differently (as one token, or a comment)?
i32 avoid_paste(string a, string b) {
    if (a.size == 0 || b.size == 0) return 0;
    i32 b0 = b[0];
    i32 b_name = is_ident_start(b0);
    i32 b_num = (b0 >= '0' && b0 <= '9') || (b0 == '.' && b.size > 1 && b[1] >= '0' && b[1] <= '9');
    i32 b_str = b0 == '"';
    i32 b_chr = b0 == '\'';
    i32 c = (b_name || b_num || b_str || b_chr) ? -1 : b0;   // first char of an operator
    // Everything that can take a following `=` (`+=`, `==`, `<<=`, …).
    if (c == '=' && (a == "=" || a == "!" || a == ">" || a == "<" || a == "+" || a == "-"
        || a == "*" || a == "/" || a == "%" || a == "&" || a == "|" || a == "^" || a == ">>" || a == "<<"))
        return 1;
    if (a == ">") return c == '>';
    if (a == "<") return c == '<' || c == '%' || c == ':';
    if (a == "+") return c == '+';
    if (a == "-") return c == '-' || c == '>';
    if (a == "/") return c == '/' || c == '*';
    if (a == "%") return c == ':' || c == '%';
    if (a == "&") return c == '&';
    if (a == "|") return c == '|';
    if (a == ":") return c == ':' || c == '>';
    if (a == "->") return c == '*';
    if (a == ".") return c == '.' || c == '%' || b_num;
    if (a == "#") return c == '#' || c == '%';
    i32 a0 = a[0];
    if (is_ident_start(a0)) return b_name || b_chr || b_str;
    if ((a0 >= '0' && a0 <= '9') || (a0 == '.' && a.size > 1))
        return b_num || b_name || b_chr || c == '.' || c == '+' || c == '-';
    return 0;
}

string expand_line(string line, dict<string, string> *macros, i32 cur_line, string cur_file) {
    // ONE scan: every expansion is rescanned with the rest of the line as it is
    // produced (emit_rescan), so nothing is left for a second pass — which would
    // wrongly expand what C leaves alone (`DEFER(f)(1)` stays `f (1)`).
    list<string> nothing_active;
    list<string> toks = expand_tokens(tokenize(line), macros, cur_line, cur_file, nothing_active);
    // Join. At a padding boundary (`\x03`, around macro expansions and
    // substituted arguments) with no whitespace, add a space where the two
    // tokens would otherwise lex as one (`- -1`, not `--1`; `4 .5`, not `4.5`).
    string result = "";
    string prev = "";
    i32 pad = 0;
    for (i32 i = 0; i < toks.length; i++) {
        string t = toks[i];
        if (t == "\x03") { pad = 1; continue; }
        if (t.size > 0 && (t[0] == 4 || t[0] == 5)) t = unpaint(t);
        if (t == " ") {
            if (result.size > 0 && result[result.size-1] != ' ') result = result + " ";
            continue;
        }
        if (pad && result.size > 0 && result[result.size-1] != ' ' && avoid_paste(prev, t)) result = result + " ";
        pad = 0;
        result = result + t;
        prev = t;
    }
    // Trailing whitespace (e.g. where a line-end comment became a space) is never
    // significant in preprocessed output — drop it, matching `cpp`. `.rtrim()` is a
    // view into the local `result`, so `.dup` it to return an owned string.
    return result.rtrim().dup;
}

// ── Conditionals ──────────────────────────────────────────────────────────

i32 cond_active(Preprocessor *pp) {
    for (i32 i = 0; i < pp->cond_depth; i++)
        if (pp->cond_stack[i] > 0) return 0;
    return 1;
}

i32 cond_any_skip(Preprocessor *pp) {
    for (i32 i = 0; i < pp->cond_depth; i++)
        if (pp->cond_stack[i] > 0) return 1;
    return 0;
}

// ── Directive handlers ────────────────────────────────────────────────────

void pp_define(Preprocessor *pp, string rest) {
    rest = rest.ltrim();
    if (rest.size == 0) return;
    i32 i = 0;
    while (i < rest.size && is_ident(rest[i])) i++;
    if (i == 0) return;
    string name = rest[0:i];
    i32 j = i;
    // Function-like only when `(` IMMEDIATELY follows the name (C11 6.10.3p3):
    // `#define N (1024 / 8)` is an object-like macro whose body starts with `(`.
    if (j < rest.size && rest[j] == '(') {
        j++;
        i32 k = j, depth = 1;
        while (k < rest.size && depth > 0) {
            if (rest[k] == '(') depth++; else if (rest[k] == ')') depth--;
            k++;
        }
        string params = rest[j:k-1];
        string body = "";
        while (k < rest.size && (rest[k] == ' ' || rest[k] == '\t')) k++;
        if (k < rest.size) body = rest[k:rest.size].rtrim();   // where a comment was: not body
        pp->macros[name] = "F|" + params + "|" + body;
    } else {
        string body = rest[i:rest.size];
        while (body.size > 0 && (body[0] == ' ' || body[0] == '\t')) body = body[1:body.size];
        pp->macros[name] = "O|" + body.rtrim();
    }
}

// Process a whole source text line by line. A backslash-newline splices the
// next physical line on (C11 5.1.1.2 phase 2), so a multi-line `#define`/`#if`
// reaches the directive handler as one logical line — for the main file and for
// every `#include`d header alike.
// `#arg` (C11 6.10.3.2): the argument's spelling in quotes — leading/trailing
// space dropped, each internal whitespace run collapsed to one space, and a `\`
// placed before every `"` and `\` inside a string literal or char constant.
string stringize_arg(string arg) {
    string a = unpaint(arg).trim();
    string out = "\"";
    i32 i = 0;
    while (i < a.size) {
        i32 c = a[i];
        if (c == '"' || c == '\'') {
            i32 q = c;
            out = out + (q == '"' ? "\\\"" : "'"); i++;
            while (i < a.size && a[i] != q) {
                if (a[i] == '\\' && i + 1 < a.size) {
                    out = out + "\\\\";          // the backslash itself
                    i++;
                    if (a[i] == '"') out = out + "\\\"";
                    else if (a[i] == '\\') out = out + "\\\\";
                    else out = out + a[i:i+1];
                    i++; continue;
                }
                if (a[i] == '"') out = out + "\\\""; else out = out + a[i:i+1];
                i++;
            }
            if (i < a.size) { out = out + (q == '"' ? "\\\"" : "'"); i++; }
            continue;
        }
        if (std::IsSpace(c)) {
            while (i < a.size && std::IsSpace(a[i])) i++;
            out = out + " ";
            continue;
        }
        out = out + a[i:i+1]; i++;
    }
    return out + "\"";
}

// `line` ends inside an open macro invocation; where in `next` (the following
// physical line) does that invocation close? Returns the offset just after its
// closing `)`, or -1 if it is still open at the end of `next`.
i32 call_close_offset(Preprocessor *pp, string line, string next) {
    string all = line + " " + next;
    i32 base = line.size + 1;
    i32 i = 0, depth = 0, in_call = 0;
    while (i < all.size) {
        i32 c = all[i];
        if (c == '"' || c == '\'') {
            i32 q = c; i++;
            while (i < all.size && all[i] != q) { if (all[i] == '\\') i++; i++; }
            i++; continue;
        }
        if (in_call) {
            if (c == '(') depth++;
            else if (c == ')') {
                depth--;
                if (depth == 0) { in_call = 0; if (i >= base) return i + 1 - base; }
            }
            i++; continue;
        }
        if (is_ident_start(c)) {
            i32 st = i;
            while (i < all.size && is_ident(all[i])) i++;
            if (pp->macros[all[st:i]].starts_with("F|")) {
                i32 k = i;
                while (k < all.size && (all[k] == ' ' || all[k] == '\t')) k++;
                if (k < all.size && all[k] == '(') { in_call = 1; depth = 1; i = k + 1; }
            }
            continue;
        }
        i++;
    }
    return -1;
}

// Whether `line` ends inside an unclosed function-like macro invocation: a
// name defined as a function-like macro, followed by `(`, whose parentheses are
// not balanced by the end of the line. String/char literals are skipped.
i32 open_macro_call(Preprocessor *pp, string line) {
    i32 i = 0, depth = 0, in_call = 0;
    while (i < line.size) {
        i32 c = line[i];
        if (c == '"' || c == '\'') {
            i32 q = c; i++;
            while (i < line.size && line[i] != q) { if (line[i] == '\\') i++; i++; }
            i++; continue;
        }
        if (in_call) {
            if (c == '(') depth++;
            else if (c == ')') { depth--; if (depth == 0) in_call = 0; }
            i++; continue;
        }
        if (is_ident_start(c)) {
            i32 st = i;
            while (i < line.size && is_ident(line[i])) i++;
            string name = line[st:i];
            if (pp->macros[name].starts_with("F|")) {
                i32 k = i;
                while (k < line.size && (line[k] == ' ' || line[k] == '\t')) k++;
                if (k < line.size && line[k] == '(') { in_call = 1; depth = 1; i = k + 1; }
            }
            continue;
        }
        i++;
    }
    return in_call;
}

void pp_process_content(Preprocessor *pp, string content) {
    string rest = content;
    while (rest.size > 0) {
        string line = "";
        i32 nphys = 0;   // physical lines this logical line spans
        i32 splices = 0; // backslash-newlines in the current run
        i32 all_splices = 0;
        string before_last = "";
        while (true) {
            i32 n = 0;
            while (n < rest.size && rest[n] != '\n') n++;
            string phys = rest[0:n];
            rest = n < rest.size ? rest[n+1:] : rest[n:];
            nphys++;
            before_last = line;
            // A trailing `\` (optionally followed by `\r`) continues the line.
            if (phys.ends_with("\\")) { line = line + phys[0:phys.size-1]; splices++; all_splices++; if (rest.size > 0) continue; }
            else if (phys.ends_with("\\\r")) { line = line + phys[0:phys.size-2]; splices++; all_splices++; if (rest.size > 0) continue; }
            else {
                // -C with linemarkers: tokens after a comment that a splice made
                // span lines stay on their own physical line (as gcc prints
                // them) — push the remainder back, keeping its column.
                if (g_keep_comments && pp->markers && all_splices > 0 && open_block_comment(before_last)) {
                    i32 k = 0;
                    while (k + 1 < phys.size && !(phys[k] == '*' && phys[k+1] == '/')) k++;
                    k += 2;
                    if (k < phys.size && phys[k:].trim().size > 0) {
                        line = line + phys[0:k];
                        rest = ("\x02" + spaces(k) + phys[k:] + "\n" + rest).dup;
                        nphys--;
                        break;
                    }
                }
                line = line + phys;
            }
            // -C: a block comment left open continues onto the next line.
            if (g_keep_comments && rest.size > 0 && open_block_comment(line)) {
                // gcc removes backslash-newlines from its line buffer in place,
                // and -C copies a comment out of that buffer: the freed bytes
                // still hold the original line's last 2k-1 characters, which
                // therefore appear (after a newline) inside the comment. Kept
                // byte-compatible.
                if (splices > 0) {
                    i32 stale = 2 * splices - 1;
                    if (stale > phys.size) stale = phys.size;
                    line = line + "\n" + phys[phys.size - stale:];
                }
                splices = 0;
                line = line + "\n";
                continue;
            }
            break;
        }
        // A function-like macro invocation may span lines (glibc's
        // `__REDIRECT (name, (args…,\n more…), alias)`): while a TEXT line ends
        // inside an open invocation, join the following lines onto it.
        if (cond_active(pp) && !line.ltrim().starts_with("#")) {
            while (rest.size > 0 && open_macro_call(pp, line)) {
                i32 n = 0;
                while (n < rest.size && rest[n] != '\n') n++;
                string next = rest[0:n];
                if (next.ltrim().starts_with("#")) break;   // never swallow a directive
                string after = n < rest.size ? rest[n+1:] : rest[n:];
                // With linemarkers, gcc prints only the macro call at its first
                // line; tokens after the call's closing `)` stay on THEIR source
                // line. So cut there and push the remainder back as its own line,
                // keeping its column (it is not counted as consumed here).
                i32 k = pp->markers ? call_close_offset(pp, line, next) : -1;
                if (k >= 0 && next[k:].trim().size > 0) {
                    line = line + " " + next[0:k];
                    // `\x02` tags it as a continuation (see pp_process_line).
                    rest = ("\x02" + spaces(k) + next[k:] + (n < rest.size ? "\n" : "") + after).dup;
                    break;
                }
                line = line + " " + next;
                rest = after;
                nphys++;
            }
        }
        // The line is attributed to its FIRST physical line; afterwards skip the
        // rest it consumed (pp_process_line itself advances by one), so later
        // line numbers, `__LINE__` and linemarkers stay exact.
        pp_process_line(pp, line);
        pp->current_line += nphys - 1;
    }
}

// Parse the header name of `#include` / `__has_include`: `<x>` or `"x"`.
// Returns the name ("" if malformed) and sets *quoted.
string header_name(string rest, i32 *quoted) {
    string r = rest.trim();
    *quoted = 0;
    if (r.size < 2) return "";
    if (r[0] == '"') {
        *quoted = 1;
        i32 n = 1;
        while (n < r.size && r[n] != '"') n++;
        return r[1:n];
    }
    if (r[0] == '<') {
        i32 n = 1;
        while (n < r.size && r[n] != '>') n++;
        return r[1:n];
    }
    return "";
}

// Index of the include directory the current file was found in (-1 if it was
// not found via the search path), for `#include_next`.
i32 current_dir_index(Preprocessor *pp) { return pp->cur_dir_idx; }

// Resolve a header to a path ("" if not found). `"x"` first tries the including
// file's directory (C11 6.10.2); then the search list from index `from`
// (`#include_next` starts after the current file's directory).
// `*dir` receives the search-list index it was found in, or -1 (an absolute
// path, or the includer's own directory).
string resolve_include(Preprocessor *pp, string path, i32 quoted, i32 from, i32 *dir) {
    *dir = -1;
    if (path.size == 0) return "";
    if (path[0] == '/') return file_exists(path) ? path : "";
    if (quoted && from == 0) {
        string here = dir_of(pp->current_file);
        string cand = here.size > 0 ? here + "/" + path : path;
        if (file_exists(cand)) return cand;
        for (i32 qi = 0; qi < pp->quote_dirs.length; qi++) {      // -iquote
            string qc = pp->quote_dirs[qi] + "/" + path;
            if (file_exists(qc)) return qc;
        }
    }
    for (i32 di = from; di < pp->include_dirs.length; di++) {
        string cand = pp->include_dirs[di] + "/" + path;
        if (file_exists(cand)) { *dir = di; return cand; }
    }
    return "";
}

void pp_include(Preprocessor *pp, string rest, i32 next) {
    i32 quoted = 0;
    string path = header_name(rest, &quoted);
    if (path.size == 0) {
        // A computed include: `#include MACRO` expands to `<x>` / `"x"`.
        string ex = expand_line(rest, &pp->macros, pp->current_line, pp->current_file);
        path = header_name(ex, &quoted);
        if (path.size == 0) return;
    }
    i32 from = 0;
    if (next) { i32 ci = current_dir_index(pp); from = ci < 0 ? 0 : ci + 1; }
    i32 dir = -1;
    string full_path = resolve_include(pp, path, quoted, from, &dir);
    // `#pragma once`: a header already included is skipped entirely.
    for (i32 i = 0; i < pp->once_files.length; i++) if (pp->once_files[i] == full_path) return;

    if (full_path.size > 0) {
        // A system header: found in a system directory — or, by `"x"` from the
        // includer's own directory, a header next to a system header.
        i32 sys = dir >= 0 ? dir >= pp->user_dirs : pp->cur_sys;
        enter_file(pp, full_path, sys, dir);
    } else if (pp->missing_ok) {
        add_dep(pp, path, 0);          // -MG: assume it will be generated
    } else {
        // As gcc: a missing header is fatal (exit status 1).
        i32 col = 1;
        while (col <= pp->cur_text.size && pp->cur_text[col-1] != '"' && pp->cur_text[col-1] != '<') col++;
        if (col > pp->cur_text.size) col = 1;
        std::Println("{}:{}:{}: fatal error: {}: No such file or directory",
                     pp->current_file, pp->current_line, col, path, target = 2);
        std::Println("compilation terminated.", target = 2);
        flush_and_exit(pp, 1);
    }
}

// The include-guard macro of a header (`#ifndef X` / `#if !defined X` as the
// first directive, its matching `#endif` as the last line, nothing outside but
// blank lines), or "" when it is not guarded that way.
string include_guard(string content) {
    string rest = content;
    i32 depth = 0;
    i32 closed = 0;     // the guard's #endif has been seen
    string guard = "";
    while (rest.size > 0) {
        i32 n = 0;
        while (n < rest.size && rest[n] != '\n') n++;
        string l = rest[0:n].trim();
        rest = n < rest.size ? rest[n+1:] : rest[n:];
        if (l.size == 0) continue;
        if (closed) return "";                      // something after the #endif
        if (l[0] != '#') { if (depth == 0) return ""; continue; }
        string d = l[1:].ltrim();
        if (guard.size == 0) {
            string name = "";
            if (d.starts_with("ifndef")) name = d[6:].trim();
            else if (d.starts_with("if")) {
                string e = d[2:].trim();
                if (e.starts_with("!")) {
                    e = e[1:].trim();
                    if (e.starts_with("defined")) {
                        e = e[7:].trim();
                        if (e.starts_with("(") && e.ends_with(")")) e = e[1:e.size-1].trim();
                        name = e;
                    }
                }
            }
            i32 k = 0;
            while (k < name.size && is_ident(name[k])) k++;
            if (k == 0 || k != name.size) return "";
            guard = name.dup;
            depth = 1;
            continue;
        }
        if (d.starts_with("if")) depth++;
        else if (d.starts_with("endif")) { depth--; if (depth == 0) closed = 1; }
        else if (depth == 1 && (d.starts_with("else") || d.starts_with("elif"))) return "";
    }
    return closed ? guard : "";
}

// Preprocess an included file in place: `# 1 "file" 1` on entry, and on return
// `# N "includer" 2` with N = the line after the `#include`.
// Record a dependency once (first-seen order).
void add_dep(Preprocessor *pp, string path, i32 sys) {
    for (i32 i = 0; i < pp->deps.length; i++) if (pp->deps[i] == path) return;
    pp->deps.add(path.dup);
    pp->deps_sys.add(sys);
}

void enter_file(Preprocessor *pp, string path, i32 sys, i32 dir_idx) {
    add_dep(pp, path, sys);
    // Guarded and already included (guard macro defined): skip entirely.
    string g = pp->guards[path];
    if (g.size > 0 && pp->macros[g].size >= 2) return;
    string content = read_file(path);
    if (!g_keep_comments) content = strip_comments(content);
    if (g.size == 0) { string ng = include_guard(content); if (ng.size > 0) pp->guards[path] = ng.dup; }
    // The reader is first brought to the `#include` line itself.
    if (pp->markers) sync_to(pp);
    string saved_file = pp->current_file;
    i32 saved_line = pp->current_line;
    i32 saved_sys = pp->cur_sys;
    i32 saved_dir = pp->cur_dir_idx;
    pp->current_file = path;
    pp->current_line = 1;
    pp->cur_sys = sys;
    pp->cur_dir_idx = dir_idx;
    if (pp->markers) emit_marker(pp, 1, path, " 1" + sys_flags(pp));
    pp_process_content(pp, content);
    pp->current_file = saved_file;
    pp->current_line = saved_line;   // the #include line; pp_process_line advances it
    pp->cur_sys = saved_sys;
    pp->cur_dir_idx = saved_dir;
    // (Returning to the pseudo-file `<command-line>` is shown as its line 0.)
    if (pp->markers) emit_marker(pp, saved_file == "<command-line>" ? 0 : saved_line + 1, saved_file, " 2" + sys_flags(pp));
}

i32 pp_ifdef(Preprocessor *pp, string rest, i32 negate) {
    rest = rest.ltrim();
    i32 i = 0;
    while (i < rest.size && is_ident(rest[i])) i++;
    string name = rest[0:i];
    i32 found = 0;
    string v = pp->macros[name];
    if (v.size >= 2) found = 1;
    return negate ? !found : found;
}

// Replace every `defined NAME` / `defined(NAME)` in `rest` with `1` or `0`
// BEFORE macro expansion — the operand of `defined` is not itself expanded
// (C11 6.10.1), so `#if defined(FOO) && FOO` must test FOO's definedness, not the
// expansion of the token `FOO`.
// `__has_attribute(x)` / `__has_builtin(x)` / `__has_feature(x)` / … : the
// answer of the host compiler that supplied the target macros (that is what the
// sic compiler sees, through the host cpp), asked once per distinct query and
// cached. Only identifier-like operands (`noreturn`, `gnu::cold`) are queried.
string host_has(Preprocessor *pp, string kind, string arg) {
    string a = arg.trim();
    if (pp->info_mode) {
        // sic lists names plainly: `__cold__`, `gnu::cold` and `__gnu__::__cold__`
        // are all `cold`; `__c_atomic__` is `c_atomic` (features too, as in
        // gcc/clang). Builtin names are exact.
        if (kind.contains("attribute")) {
            if (a.starts_with("gnu::")) a = a[5:];
            else if (a.starts_with("__gnu__::")) a = a[9:];
        }
        if (kind != "__has_builtin" && a.size > 4 && a.starts_with("__") && a.ends_with("__")) a = a[2:a.size-2];
        string v = pp->has_cache[kind + "(" + a + ")"];
        return v.size > 0 ? v : "0";
    }
    string key = kind + "(" + a + ")";
    string hit = pp->has_cache[key];
    if (hit.size > 0) return hit;
    string ans = "0";
    i32 ok = a.size > 0 && pp->cc.size > 0;
    for (i32 i = 0; i < a.size; i++) if (!is_ident(a[i]) && a[i] != ':') ok = 0;
    if (ok) {
        list<string> out = run_lines("printf '#if " + key + "\\n1\\n#else\\n0\\n#endif\\n' | "
                                     + pp->cc + " -xc -E -P - 2>/dev/null");
        for (i32 i = 0; i < out.length; i++) if (out[i].trim() == "1") ans = "1";
    }
    pp->has_cache[key] = ans.dup;
    return ans;
}

// The text of a balanced `( … )` group starting at rest[*i] (which must be the
// `(`), advancing *i past the closing paren. "" if there is no group.
string paren_group(string rest, i32 *i) {
    while (*i < rest.size && std::IsSpace(rest[*i])) (*i)++;
    if (*i >= rest.size || rest[*i] != '(') return "";
    i32 st = *i + 1, depth = 0;
    while (*i < rest.size) {
        if (rest[*i] == '(') depth++;
        else if (rest[*i] == ')') { depth--; if (depth == 0) break; }
        (*i)++;
    }
    string inner = rest[st:*i];
    if (*i < rest.size) (*i)++;
    return inner;
}

// `__has_include(…)` / `__has_embed(…)` in ordinary text: an error (they belong
// to #if), but — as in gcc — still replaced by their value.
string has_ops_in_text(Preprocessor *pp, string line) {
    string out = "";
    i32 i = 0;
    while (i < line.size) {
        i32 c = line[i];
        if (c == '"' || c == '\'') {
            i32 st = i; i++;
            while (i < line.size && line[i] != c) { if (line[i] == '\\') i++; i++; }
            if (i < line.size) i++;
            out = out + line[st:i];
            continue;
        }
        if (is_ident_start(c) && (i == 0 || !is_ident(line[i-1]))) {
            i32 st = i;
            while (i < line.size && is_ident(line[i])) i++;
            string w = line[st:i];
            if (w == "__has_include" || w == "__has_include_next" || w == "__has_embed") {
                diag(pp, "error", "‘" + w + "’ used outside of preprocessing directive", st + 1);
                string arg = paren_group(line, &i);
                if (w == "__has_embed") { out = out + has_embed(pp, arg); continue; }
                i32 quoted = 0;
                string path = header_name(arg, &quoted);
                i32 from = 0;
                if (w == "__has_include_next") { i32 ci = current_dir_index(pp); from = ci < 0 ? 0 : ci + 1; }
                i32 dummy = 0;
                out = out + (resolve_include(pp, path, quoted, from, &dummy).size > 0 ? "1" : "0");
                continue;
            }
            out = out + w;
            continue;
        }
        out = out + line[i:i+1];
        i++;
    }
    return out;
}

// `#if` pre-pass, before macro expansion: `defined X` / `defined(X)` and the
// `__has_*` operators are replaced by 0/1 — their operands must NOT be expanded
// (C11 6.10.1p4: `#if defined(VER) && VER==42` must test the name `VER`).
string substitute_defined(Preprocessor *pp, string rest) {
    string out = "";
    i32 i = 0;
    while (i < rest.size) {
        i32 c = rest[i];
        if (is_ident_start(c) && (i == 0 || !is_ident(rest[i-1]))) {
            i32 st = i;
            while (i < rest.size && is_ident(rest[i])) i++;
            string word = rest[st:i];
            if (word == "defined") {
                while (i < rest.size && std::IsSpace(rest[i])) i++;
                i32 paren = 0;
                if (i < rest.size && rest[i] == '(') { paren = 1; i++; }
                while (i < rest.size && std::IsSpace(rest[i])) i++;
                i32 ns = i;
                while (i < rest.size && is_ident(rest[i])) i++;
                string name = rest[ns:i];
                while (i < rest.size && std::IsSpace(rest[i])) i++;
                if (paren && i < rest.size && rest[i] == ')') i++;
                out = out + (pp->macros[name].size >= 2 ? "1" : "0");
                continue;
            }
            if (word == "__has_embed") {
                string arg = paren_group(rest, &i);
                out = out + has_embed(pp, arg);
                continue;
            }
            if (word == "__has_include" || word == "__has_include_next") {
                string arg = paren_group(rest, &i);
                i32 quoted = 0;
                string path = header_name(arg, &quoted);
                if (path.size == 0) {
                    string ex = expand_line(arg, &pp->macros, pp->current_line, pp->current_file);
                    path = header_name(ex, &quoted);
                }
                i32 from = 0;
                if (word == "__has_include_next") { i32 ci = current_dir_index(pp); from = ci < 0 ? 0 : ci + 1; }
                i32 dummy = 0;
                out = out + (resolve_include(pp, path, quoted, from, &dummy).size > 0 ? "1" : "0");
                continue;
            }
            if (word == "__has_attribute" || word == "__has_c_attribute" || word == "__has_cpp_attribute"
                || word == "__has_builtin" || word == "__has_feature" || word == "__has_extension"
                || word == "__has_declspec_attribute") {
                string arg = paren_group(rest, &i);
                out = out + host_has(pp, word, arg);
                continue;
            }
            out = out + word;
            continue;
        }
        if (c == '"' || c == '\'') {   // literals copied verbatim
            i32 st = i; i++;
            while (i < rest.size && rest[i] != c) { if (rest[i] == '\\') i++; i++; }
            if (i < rest.size) i++;
            out = out + rest[st:i];
            continue;
        }
        out = out + rest[i:i+1];
        i++;
    }
    return out;
}

i32 pp_if(Preprocessor *pp, string rest) {
    string pre = substitute_defined(pp, rest);
    string expanded = expand_line(pre, &pp->macros, pp->current_line, pp->current_file);
    // A macro may expand TO an operator (glibc: `__glibc_has_attribute (x)` →
    // `__has_attribute (x)`), so evaluate the operators again, as gcc does.
    string post = substitute_defined(pp, expanded);
    return eval_if_expr(post, &pp->macros);
}

// Conditional-group state per `#if` nesting level:
//   0 = active (this branch taken, emit)
//   1 = done   (a branch already matched; skip the rest of the group to #endif)
//   2 = waiting (no branch matched yet; a later #elif/#else may activate)
//   3 = parent-skip (an enclosing level is inactive; never activate)
void pp_else(Preprocessor *pp) {
    if (pp->cond_depth == 0) { std::Println("sic-cpp: {}:{}: #else without #if", pp->current_file, pp->current_line, target = 2); return; }
    i32 state = pp->cond_stack[pp->cond_depth - 1];
    if (state == 0) pp->cond_stack[pp->cond_depth - 1] = 1;        // was active → done
    else if (state == 2) pp->cond_stack[pp->cond_depth - 1] = 0;   // waiting → activate else
}

void pp_elif(Preprocessor *pp, string rest) {
    if (pp->cond_depth == 0) { std::Println("sic-cpp: {}:{}: #elif without #if", pp->current_file, pp->current_line, target = 2); return; }
    i32 state = pp->cond_stack[pp->cond_depth - 1];
    if (state == 0) pp->cond_stack[pp->cond_depth - 1] = 1;        // was active → done
    else if (state == 2) {                                         // still looking: test it
        pp->cond_stack[pp->cond_depth - 1] = pp_if(pp, rest) ? 0 : 2;
    }
    // state 1 (done) and 3 (parent-skip) stay put.
}

// C23 `#elifdef X` / `#elifndef X`.
void pp_elifdef(Preprocessor *pp, string rest, i32 negate) {
    if (pp->cond_depth == 0) { diag(pp, "error", "#elifdef without #if", 2); return; }
    i32 state = pp->cond_stack[pp->cond_depth - 1];
    if (state == 0) pp->cond_stack[pp->cond_depth - 1] = 1;
    else if (state == 2) pp->cond_stack[pp->cond_depth - 1] = pp_ifdef(pp, rest, negate) ? 0 : 2;
}

// gcc-style diagnostic `file:line:col: kind: msg`; an error makes exit status 1.
void diag(Preprocessor *pp, string kind, string msg, i32 col) {
    std::Println("{}:{}:{}: {}: {}", pp->current_file, pp->current_line, col, kind, msg, target = 2);
    if (kind == "error") pp->errors++;
}

// ── #embed (C23) ───────────────────────────────────────────────────────────

struct EmbedSpec {
    string name;        // resource name as written
    i32 quoted;
    i32 name_pos;       // offset of the header-name token in the directive text
    i64 limit;          // -1 = none
    i64 offset;         // gnu::offset
    i32 has_prefix; string prefix; i32 prefix_pos;
    i32 has_suffix; string suffix;
    i32 has_if_empty; string if_empty; i32 if_empty_pos;
    string bad;         // first unknown parameter ("" = all fine)
}

// Parse `<name>`/`"name"` [parameters] of #embed / __has_embed. Standard
// parameters may be spelled `limit` or `__limit__`; `gnu::offset` is gcc's.
EmbedSpec embed_parse(Preprocessor *pp, string text) {
    EmbedSpec e;
    e.limit = -1; e.offset = 0; e.has_prefix = 0; e.has_suffix = 0; e.has_if_empty = 0;
    e.bad = ""; e.name = ""; e.quoted = 0; e.prefix = ""; e.suffix = ""; e.if_empty = "";
    e.prefix_pos = 0; e.if_empty_pos = 0;
    i32 i = 0;
    while (i < text.size && std::IsSpace(text[i])) i++;
    e.name_pos = i;
    if (i < text.size && (text[i] == '"' || text[i] == '<')) {
        i32 close = text[i] == '"' ? '"' : '>';
        e.quoted = text[i] == '"';
        i32 st = i + 1;
        i++;
        while (i < text.size && text[i] != close) i++;
        e.name = text[st:i].dup;
        if (i < text.size) i++;
    } else {
        // `#embed MACRO …`: the header name comes from the expansion.
        i32 st = i;
        while (i < text.size && is_ident(text[i])) i++;
        string ex = expand_line(text[st:i], &pp->macros, pp->current_line, pp->current_file).trim();
        i32 q = 0;
        e.name = header_name(ex, &q).dup;
        e.quoted = q;
    }
    while (true) {
        while (i < text.size && std::IsSpace(text[i])) i++;
        if (i >= text.size || !is_ident_start(text[i])) break;
        i32 st = i;
        while (i < text.size && (is_ident(text[i]) || text[i] == ':')) i++;
        string pname = text[st:i];
        i32 gpos = i;
        while (gpos < text.size && std::IsSpace(text[gpos])) gpos++;
        string arg = "";
        i32 arg_pos = gpos + 1;
        if (gpos < text.size && text[gpos] == '(') { i = gpos; arg = paren_group(text, &i); }
        while (arg_pos < text.size && std::IsSpace(text[arg_pos])) arg_pos++;
        // Normalize `__x__` / `__gnu__::__x__` spellings.
        string n = pname;
        if (n.starts_with("__gnu__::")) n = "gnu::" + n[9:];
        if (n.starts_with("gnu::__") && n.ends_with("__")) n = "gnu::" + n[7:n.size-2];
        else if (n.starts_with("__") && n.ends_with("__") && n.size > 4) n = n[2:n.size-2];
        if (n == "limit" || n == "gnu::offset") {
            string v = substitute_defined(pp, arg);
            v = expand_line(v, &pp->macros, pp->current_line, pp->current_file);
            i64 val = eval_if_expr(v, &pp->macros);
            if (n == "limit") e.limit = val; else e.offset = val;
        } else if (n == "prefix") { e.has_prefix = 1; e.prefix = normalize_tokens(arg).dup; e.prefix_pos = arg_pos; }
        else if (n == "suffix") { e.has_suffix = 1; e.suffix = normalize_tokens(arg).dup; }
        else if (n == "if_empty") { e.has_if_empty = 1; e.if_empty = normalize_tokens(arg).dup; e.if_empty_pos = arg_pos; }
        else if (e.bad.size == 0) e.bad = pname.dup;
    }
    return e;
}

// Locate a resource: `"x"` next to the current file, then --embed-dir dirs;
// `<x>` only in the --embed-dir dirs.
string embed_find(Preprocessor *pp, EmbedSpec *e) {
    if (e->name.size == 0) return "";
    if (e->name[0] == '/') return file_exists(e->name) ? e->name : "";
    if (e->quoted) {
        string here = dir_of(pp->current_file);
        string cand = here.size > 0 ? here + "/" + e->name : e->name;
        if (file_exists(cand)) return cand;
    }
    for (i32 i = 0; i < pp->embed_dirs.length; i++) {
        string cand = pp->embed_dirs[i] + "/" + e->name;
        if (file_exists(cand)) return cand;
    }
    return "";
}

// The resource's bytes after gnu::offset and limit.
string embed_bytes(string path, EmbedSpec *e) {
    string data = read_file(path);
    i64 off = e->offset < 0 ? 0 : e->offset;
    if (off > data.size) off = data.size;
    i64 end = data.size;
    if (e->limit >= 0 && off + e->limit < end) end = off + e->limit;
    return data[off:end].dup;
}

// `__has_embed(…)` → __STDC_EMBED_NOT_FOUND__ (0) / _FOUND__ (1) / _EMPTY__ (2).
string has_embed(Preprocessor *pp, string arg) {
    EmbedSpec e = embed_parse(pp, arg);
    if (e.bad.size > 0) return "0";
    string path = embed_find(pp, &e);
    if (path.size == 0) return "0";
    return embed_bytes(path, &e).size == 0 ? "2" : "1";
}

// `#embed resource [params]` → the bytes as a comma-separated list of integer
// constants. (gcc hands big resources to cc1 as a base64 `#embed` extension;
// the sic compiler reads plain C, so sic-cpp always writes the numbers —
// 128 per output line.) Placed at the column of its first token, as gcc does.
void pp_embed(Preprocessor *pp, string rest, i32 rest_off) {
    EmbedSpec e = embed_parse(pp, rest);
    if (e.bad.size > 0) {
        diag(pp, "error", "unknown embed parameter '" + e.bad + "'", rest_off + e.name_pos + 1);
        return;
    }
    string path = embed_find(pp, &e);
    if (path.size == 0) {
        if (!e.quoted && pp->embed_dirs.length == 0)
            diag(pp, "error", "no include path in which to search for " + e.name, rest_off + e.name_pos + 1);
        else {
            std::Println("{}:{}:{}: fatal error: {}: No such file or directory",
                         pp->current_file, pp->current_line, rest_off + e.name_pos + 1, e.name, target = 2);
            std::Println("compilation terminated.", target = 2);
            flush_and_exit(pp, 1);
        }
        return;
    }
    add_dep(pp, path, 0);
    string data = embed_bytes(path, &e);
    if (data.size == 0) {
        if (e.has_if_empty && e.if_empty.size > 0)
            add_out(pp, spaces(rest_off + e.if_empty_pos) + e.if_empty);
        return;
    }
    list<string> num;
    for (i32 v = 0; v < 256; v++) num.add(std::Fmt("{}", v));
    i32 col0 = e.has_prefix ? rest_off + e.prefix_pos : rest_off + e.name_pos;
    string line = spaces(col0) + (e.has_prefix && e.prefix.size > 0 ? e.prefix + " " : "");
    i32 first = 1;
    for (i64 i = 0; i < data.size; i++) {
        line = line + num[data[i] & 255];
        if (i + 1 < data.size) line = line + ",";
        if ((i + 1) % 128 == 0 && i + 1 < data.size) {
            if (first) { add_out(pp, line); first = 0; }
            else { pp->output_lines.add(line); if (pp->markers) pp->out_line++; }
            line = "";
        }
    }
    if (e.has_suffix && e.suffix.size > 0) line = line + " " + e.suffix;
    if (first) add_out(pp, line);
    else { pp->output_lines.add(line); if (pp->markers) pp->out_line++; }
}

// The `#define …` line for macro `name` as -dD/-dM print it.
string define_text(Preprocessor *pp, string name) {
    string enc = pp->macros[name];
    if (enc.starts_with("F|")) {
        tuple pb = enc[2:].split("|");
        string params = "";
        list<string> ps = split_all(pb[0], ',');
        for (i32 i = 0; i < ps.length; i++) { if (i > 0) params = params + ","; params = params + ps[i].trim(); }
        string body = pb.length > 1 ? pb[1] : "";
        return "#define " + name + "(" + params + ") " + normalize_tokens(body);
    }
    return "#define " + name + " " + normalize_tokens(enc[2:]);
}

void pp_endif(Preprocessor *pp) {
    if (pp->cond_depth > 0) pp->cond_depth--;
    else std::Println("sic-cpp: {}:{}: #endif without #if", pp->current_file, pp->current_line, target = 2);
}

// ── Line processor ────────────────────────────────────────────────────────

// Emit a linemarker and make it the reader's position.
void emit_marker(Preprocessor *pp, i32 line, string file, string flags) {
    pp->output_lines.add("# " + std::Fmt("{}", line) + " \"" + file + "\"" + flags);
    pp->out_file = file.dup;
    pp->out_line = line;
    pp->force_marker = 0;
}

string sys_flags(Preprocessor *pp) { return pp->cur_sys ? " 3 4" : ""; }

// Add one output line produced at the current source position. With
// linemarkers, first bring the reader to that position the way gcc does: a gap
// of fewer than 8 lines in the same file is filled with empty lines, anything
// else (another file, going backwards, a bigger jump) gets `# N "file"`.
// Bring the reader to the current source position (gcc's maybe_print_line):
// fewer than 8 lines ahead in the same file → empty lines, else a marker.
void sync_to(Preprocessor *pp) {
    i32 line = pp->current_line;
    if (pp->force_marker || pp->out_file != pp->current_file
        || line < pp->out_line || line >= pp->out_line + 8) {
        emit_marker(pp, line, pp->current_file, sys_flags(pp));
    } else {
        while (pp->out_line < line) { pp->output_lines.add(""); pp->out_line++; }
    }
}

void add_out(Preprocessor *pp, string text) {
    // -imacros: the text is dropped but, as in gcc, the lines still advance.
    if (pp->discard) text = "";
    if (pp->markers) {
        i32 line = pp->current_line;
        sync_to(pp);
        // gcc tracks whether the previous printed token came from a system
        // header; when the next one's system-ness differs it ends the line and
        // re-emits the marker with the new flags (an empty line + `# N "file"`).
        // (Pragma lines are printed outside the token stream: they don't count.)
        // (A pragma line doesn't trigger that re-mark, but does count as the
        // last printed token.)
        i32 pragma = text.starts_with("#pragma ");
        // -dD/-dN/-dI echo lines are printed outside the token stream entirely.
        i32 echo = text.starts_with("#define ") || text.starts_with("#undef ") || text.starts_with("#include");
        i32 toks = text.trim().size > 0 && !pragma && !echo;
        if (toks && pp->cur_sys != pp->prev_sys_tok) {
            pp->output_lines.add("");
            emit_marker(pp, line, pp->current_file, sys_flags(pp));
        }
        if (toks || pragma) pp->prev_sys_tok = pp->cur_sys;
        pp->out_line++;
        for (i32 k = 0; k < text.size; k++) if (text[k] == '\n') pp->out_line++;
    }
    pp->output_lines.add(text);
}

// Emit one output line, turning each `_Pragma("…")` operator (C11 6.10.9) into a
// `#pragma …` line of its own as gcc does: the text before it ends the current
// line (an empty line if there was none), the text after continues on a new
// line with a leading space.
void emit_text(Preprocessor *pp, string text) {
    string rest = text;
    while (true) {
        i32 at = -1;
        for (i32 i = 0; i + 7 <= rest.size; i++) {
            if (rest[i] == '"' || rest[i] == '\'') {        // skip literals
                i32 q = rest[i]; i++;
                while (i < rest.size && rest[i] != q) { if (rest[i] == '\\') i++; i++; }
                continue;
            }
            // … and comments kept by -C (`_Pragma` inside one is just text).
            if (rest[i] == '/' && i + 1 < rest.size && rest[i+1] == '*') {
                i += 2;
                while (i + 1 < rest.size && !(rest[i] == '*' && rest[i+1] == '/')) i++;
                i++;
                continue;
            }
            if (rest[i] == '/' && i + 1 < rest.size && rest[i+1] == '/') break;
            if (rest[i:i+7] == "_Pragma" && (i == 0 || !is_ident(rest[i-1]))
                && (i + 7 >= rest.size || !is_ident(rest[i+7]))) { at = i; break; }
        }
        if (at < 0) break;
        i32 k = at + 7;
        string args = paren_group(rest, &k);
        string lit = args.trim();
        if (lit.size < 2 || lit[0] != '"') break;              // malformed: leave as text
        // Destringize: drop the quotes, unescape \" and \\.
        string body = "";
        for (i32 i = 1; i < lit.size - 1; i++) {
            if (lit[i] == '\\' && i + 1 < lit.size - 1 && (lit[i+1] == '"' || lit[i+1] == '\\')) i++;
            body = body + lit[i:i+1];
        }
        add_out(pp, rest[0:at].rtrim().dup);
        add_out(pp, "#pragma " + normalize_tokens(body));
        string after = rest[k:].ltrim();
        // gcc still ends the pragma with the continuation line, empty or not.
        if (after.size == 0) { add_out(pp, ""); return; }
        rest = (" " + after).dup;
    }
    add_out(pp, rest);
}

// Tokens joined with single spaces where the source had whitespace (literals intact).
string normalize_tokens(string text) {
    list<string> t = tokenize(text);
    string out = "";
    for (i32 i = 0; i < t.length; i++) {
        if (t[i] == " ") { if (out.size > 0 && out[out.size-1] != ' ') out = out + " "; }
        else out = out + t[i];
    }
    return out.trim().dup;
}

// `#pragma`: the ones cpp itself implements are acted on and leave a line of 7
// spaces (gcc prints exactly that); every other pragma is passed through as
// `#pragma <normalized tokens>` for the compiler.
void pp_pragma(Preprocessor *pp, string rest) {
    string r = normalize_tokens(rest);
    list<string> w = split_all(r, ' ');
    string a = w.length > 0 ? w[0] : "";
    string b = w.length > 1 ? w[1] : "";
    if (a == "once") {
        pp->once_files.add(pp->current_file);
    } else if (a.starts_with("push_macro") || a.starts_with("pop_macro")) {
        i32 q1 = 0;
        while (q1 < r.size && r[q1] != '"') q1++;
        i32 q2 = q1 + 1;
        while (q2 < r.size && r[q2] != '"') q2++;
        if (q2 >= r.size) { add_out(pp, "       "); return; }
        string name = r[q1+1:q2];
        if (a.starts_with("push_macro")) {
            pp->pushed_macros.add(name + "\x02" + pp->macros[name]);
        } else {
            // Restore the most recent push of `name`, and drop it from the stack.
            list<string> keep;
            i32 found = -1;
            for (i32 i = pp->pushed_macros.length - 1; i >= 0; i--)
                if (found < 0 && pp->pushed_macros[i].starts_with(name + "\x02")) found = i;
            for (i32 i = 0; i < pp->pushed_macros.length; i++) if (i != found) keep.add(pp->pushed_macros[i]);
            if (found >= 0) {
                string enc = pp->pushed_macros[found][name.size + 1:];
                if (enc.size >= 2) pp->macros[name] = enc.dup; else del pp->macros[name];
            }
            pp->pushed_macros = keep;
        }
    } else if (a == "GCC" && (b == "system_header" || b == "poison" || b == "dependency" || b == "pch_preprocess")) {
        // Accepted; no effect on the text output.
    } else if (a == "GCC" && (b == "warning" || b == "error")) {
        string msg = r[4 + b.size:].trim();
        std::Println("{}:{}: {}: {}", pp->current_file, pp->current_line, b, msg, target = 2);
        if (b == "error") std::Exit(1);
    } else {
        add_out(pp, "#pragma " + r);
        return;
    }
    add_out(pp, "       ");
}

void pp_process_line(Preprocessor *pp, string line) {
    // -C/-CC: comments are still in the text. A directive never keeps them —
    // except a -CC #define, whose body keeps its comments (`//` → `/* */`).
    if (g_keep_comments && line.ltrim().starts_with("#")) {
        string st = strip_comments(line);
        string flat = "";
        for (i32 k = 0; k < st.size; k++) flat = flat + (st[k] == '\n' ? " " : st[k:k+1]);
        string d = flat.ltrim()[1:].ltrim();
        // (-C keeps a #pragma's comments too: it is passed through.)
        if (d.starts_with("pragma")) {
            string pc = "";
            for (i32 k = 0; k < line.size; k++) pc = pc + (line[k] == '\n' ? " " : line[k:k+1]);
            line = pc.dup;
        } else if (g_keep_comments == 2 && d.starts_with("define")) {
            string cc = "";
            string lc = line_comments_to_block(line);
            for (i32 k = 0; k < lc.size; k++) cc = cc + (lc[k] == '\n' ? " " : lc[k:k+1]);
            line = cc.dup;
        } else line = flat.dup;
    }
    pp->cur_text = line;
    // A continuation (the rest of a physical line after a multi-line macro
    // call): gcc places it by the column of its first PRINTED token, so skip
    // leading names that expand to nothing (`__wur`, `__THROW`, …).
    if (line.starts_with("\x02")) {
        string l = line[1:];
        i32 col = 0;
        while (true) {
            while (col < l.size && std::IsSpace(l[col])) col++;
            if (col >= l.size || !is_ident_start(l[col])) break;
            i32 e = col;
            while (e < l.size && is_ident(l[e])) e++;
            string enc = pp->macros[l[col:e]];
            if (!enc.starts_with("O|")) break;
            if (expand_line(l[col:e], &pp->macros, pp->current_line, pp->current_file).trim().size > 0) break;
            col = e;
        }
        line = (spaces(col) + l[col:]).dup;
    }
    string trimmed = line.ltrim();
    if (trimmed.size == 0 || trimmed[0] != '#') {
        // gcc `-P` output rules: a line with no tokens (blank, or only comments
        // — already turned into spaces) prints nothing; a line WITH tokens prints
        // even when they expand to nothing (`__BEGIN_DECLS` → an empty line). Its
        // indentation is the first token's source column - 1, as spaces (a tab
        // counts as one column, a comment keeps its width).
        if (cond_active(pp) && trimmed.size > 0 && trimmed.contains("__has_")) {
            line = has_ops_in_text(pp, line);
            trimmed = line.ltrim();
        }
        if (cond_active(pp) && trimmed.size > 0) {
            // A sentinel token in front keeps the expansion's own leading space
            // (after leading tokens that vanished) from being taken for
            // indentation; it is dropped again below.
            string ex = expand_line("\x01" + trimmed, &pp->macros, pp->current_line, pp->current_file);
            ex = ex.size > 0 ? ex[1:] : ex;
            i32 lead = ex.starts_with(" ");
            ex = ex.ltrim();
            // gcc: (column - 2) spaces, plus one more when the first PRINTED token
            // had whitespace before it — i.e. the line was indented, or leading
            // tokens expanded to nothing before a space.
            i32 indent = line.size - trimmed.size;
            string text = "";
            // (When every token vanished gcc still prints the column-2 indentation.)
            text = spaces(indent > 0 ? indent - 1 : 0);
            if (ex.size > 0) text = text + ((indent > 0 || lead) ? " " : "") + ex;
            emit_text(pp, text);
        }
        pp->current_line++; return;
    }
    i32 di = 1;
    while (di < trimmed.size && (trimmed[di] == ' ' || trimmed[di] == '\t')) di++;
    if (di >= trimmed.size) { pp->current_line++; return; }
    i32 kw_start = di;
    while (kw_start < trimmed.size && is_ident(trimmed[kw_start])) kw_start++;   // `include_next`
    string kw = trimmed[di:kw_start];
    string rest = trimmed[kw_start:trimmed.size];
    i32 skipping = cond_any_skip(pp);

    if (kw == "define") {
        if (!skipping) {
            pp_define(pp, rest);
            if (pp->dump_defines || pp->dump_names) {
                string r = rest.ltrim();
                i32 n = 0;
                while (n < r.size && is_ident(r[n])) n++;
                string name = r[0:n];
                add_out(pp, pp->dump_defines ? define_text(pp, name) : "#define " + name);
            }
        }
    }
    else if (kw == "undef") {
        if (!skipping) {
            tuple parts = rest.trim().split(" ");
            string name = parts[0];
            del pp->macros[name];
            if (pp->dump_defines || pp->dump_names) add_out(pp, "#undef " + name);
        }
    } else if (kw == "include" || kw == "include_next") {
        if (!skipping) {
            if (pp->dump_includes) add_out(pp, "#" + kw + " " + normalize_tokens(rest));
            pp_include(pp, rest, kw == "include_next");
        }
    }
    else if (kw == "embed") { if (!skipping) pp_embed(pp, rest, line.size - trimmed.size + kw_start); }
    else if (kw == "elifdef") { pp_elifdef(pp, rest, 0); }
    else if (kw == "elifndef") { pp_elifdef(pp, rest, 1); }
    else if (kw == "if") { pp->cond_stack[pp->cond_depth++] = (skipping ? 3 : (pp_if(pp, rest) ? 0 : 2)); }
    else if (kw == "ifdef") { pp->cond_stack[pp->cond_depth++] = (skipping ? 3 : (pp_ifdef(pp, rest, 0) ? 0 : 2)); }
    else if (kw == "ifndef") { pp->cond_stack[pp->cond_depth++] = (skipping ? 3 : (pp_ifdef(pp, rest, 1) ? 0 : 2)); }
    else if (kw == "else") { pp_else(pp); }
    else if (kw == "elif") { pp_elif(pp, rest); }
    else if (kw == "endif") { pp_endif(pp); }
    // `#error` / `#warning`: reported (gcc style, column of the directive name)
    // and preprocessing continues; an #error makes the exit status 1.
    else if (kw == "error" || kw == "warning") {
        if (cond_active(pp)) {
            string msg = ("#" + kw + " " + normalize_tokens(rest)).trim() + (kw == "warning" ? " [-Wcpp]" : "");
            diag(pp, kw, msg.dup, line.size - trimmed.size + di + 1);
        }
    }
    else if (kw == "line") {
        if (!skipping) {
            string rl = rest.ltrim();
            i32 ni = 0;
            while (ni < rl.size && rl[ni] >= '0' && rl[ni] <= '9') ni++;
            if (ni > 0) {
                pp->current_line = eval_if_expr(rl[0:ni], &pp->macros) - 1;
                i32 fi = ni;
                while (fi < rl.size && std::IsSpace(rl[fi])) fi++;
                if (fi < rl.size && rl[fi] == '"') {
                    fi++; i32 fn_start = fi;
                    while (fi < rl.size && rl[fi] != '"') fi++;
                    pp->current_file = rl[fn_start:fi];
                }
                pp->force_marker = 1;   // the reader learns the new position
            }
        }
    }
    else if (kw == "pragma") { if (!skipping) pp_pragma(pp, rest); }
    // other unknown directives are silently ignored
    pp->current_line++;
}


// ── Output ─────────────────────────────────────────────────────────────────

extern int open(char *path, int flags, int mode);
extern i64 read(int fd, void *buf, u64 n);
extern int close(int fd);

// Open `path` for writing (create/truncate); -1 on failure.
i32 open_out(string path) { return open(path.str, 0x241, 420); }   // O_WRONLY|O_CREAT|O_TRUNC, 0644

// Make-escape a file name the way gcc's mkdeps does: `$` → `$$`, `#` → `\#`,
// and a space/tab gets a backslash (backslashes right before it doubled).
string make_escape(string name) {
    string out = "";
    for (i32 i = 0; i < name.size; i++) {
        i32 c = name[i];
        if (c == ' ' || c == '\t') {
            i32 j = i - 1;
            while (j >= 0 && name[j] == '\\') { out = out + "\\"; j--; }
            out = out + "\\" + name[i:i+1];
        } else if (c == '$') out = out + "$$";
        else if (c == '#') out = out + "\\#";
        else out = out + name[i:i+1];
    }
    return out;
}

// One word of a make rule, wrapping at `colmax` like gcc (`\` + newline + space).
string make_word(string w, i32 *col, i32 colmax) {
    string out = "";
    if (*col > 0) {
        if (colmax > 0 && *col + w.size > colmax) { out = " \\\n"; *col = 0; }
        *col = *col + 1;
        out = out + " ";
    }
    *col = *col + w.size;
    return out + w;
}

// The dependency rule (gcc format, 72 columns).
string dep_rule(Preprocessor *pp) {
    list<string> targets;
    for (i32 i = 0; i < pp->dep_targets.length; i++) targets.add(pp->dep_targets[i]);
    if (targets.length == 0) {
        // Default: the input's basename with its suffix replaced by `.o`.
        string base = pp->input_name;
        i32 sl = base.size - 1;
        while (sl >= 0 && base[sl] != '/') sl--;
        base = base[sl+1:];
        i32 dot = base.size - 1;
        while (dot > 0 && base[dot] != '.') dot--;
        if (dot > 0) base = base[0:dot];
        targets.add(make_escape(base + ".o"));
    }
    list<string> deps;
    for (i32 i = 0; i < pp->deps.length; i++)
        if (!(pp->dep_no_sys && pp->deps_sys[i])) deps.add(make_escape(pp->deps[i]));
    string out = "";
    i32 col = 0;
    for (i32 i = 0; i < targets.length; i++) out = out + make_word(targets[i], &col, 0);
    out = out + ":";
    col++;
    for (i32 i = 0; i < deps.length; i++) out = out + make_word(deps[i], &col, 72);
    out = out + "\n";
    if (pp->dep_phony) for (i32 i = 1; i < deps.length; i++) out = out + deps[i] + ":\n";
    return out;
}

// `#define` lines for every macro (-dM).
string macro_dump(Preprocessor *pp) {
    string out = "";
    for (tuple kv : pp->macros) {
        string name = kv[0];
        string enc = kv[1];
        if (enc.starts_with("O|")) out = out + "#define " + name + " " + enc[2:] + "\n";
        else if (enc.starts_with("F|")) {
            tuple pb = enc[2:].split("|");
            string body = pb.length > 1 ? pb[1] : "";
            out = out + "#define " + name + "(" + pb[0] + ")" + (body.size > 0 ? " " + body : "") + "\n";
        }
    }
    return out;
}

// Write the results and exit: the preprocessed text (or -dM's macros, or -M's
// rule) to -o / stdout, plus -MD's .d file.
void flush_and_exit(Preprocessor *pp, i32 code) {
    i32 fd = 1;
    if (pp->out_path.size > 0) {
        fd = open_out(pp->out_path);
        if (fd < 0) {
            std::Println("sic-cpp: fatal error: opening output file {}: cannot write", pp->out_path, target = 2);
            std::Exit(1);
        }
    }
    if (pp->dep_only) {
        string rule = dep_rule(pp);
        if (pp->dep_file.size > 0) {
            i32 df = open_out(pp->dep_file);
            if (df >= 0) { std::Print("{}", rule, target = df); close(df); }
        } else std::Print("{}", rule, target = fd);
    } else if (pp->dump_macros) {
        std::Print("{}", macro_dump(pp), target = fd);
    } else {
        // Written in ~64 KB chunks (one growing string would be quadratic).
        string text = "";
        for (i32 i = 0; i < pp->output_lines.length; i++) {
            string line = pp->output_lines[i];
            if (pp->compact && line.trim().size == 0) continue;
            text = text + line + "\n";
            if (text.size > 65536) { std::Print("{}", text, target = fd); text = ""; }
        }
        std::Print("{}", text, target = fd);
        if (pp->dep_side) {
            i32 df = open_out(pp->dep_file);
            if (df >= 0) { std::Print("{}", dep_rule(pp), target = df); close(df); }
        }
    }
    if (fd != 1) close(fd);
    std::Exit(code);
}

// ── Main ──────────────────────────────────────────────────────────────────

int main(int argc, char **argv) {
    Preprocessor pp;
    pp.cond_depth = 0; pp.current_line = 1; pp.current_file = "";

    // Parse arguments — gcc `cpp` compatible: separate and attached forms of
    // -D/-U/-I/-o/-x/-include/-imacros/-iquote/-isystem/-idirafter/-MF/-MT/-MQ,
    // `cpp in [out]`, -M family, -dM; compiler-only flags (-W*, -f*, -m*, -O*,
    // -g*, -E, …) are accepted and ignored.
    string input_file = "";
    i32 nostdinc = 0, verbose = 0, undef = 0, no_markers = 0, freestanding = 0;
    pp.markers = 0; pp.out_line = 1; pp.out_file = ""; pp.cur_sys = 0; pp.user_dirs = 0; pp.force_marker = 0;
    pp.prev_sys_tok = 0; pp.cur_dir_idx = -1;
    pp.missing_ok = 0; pp.discard = 0; pp.out_path = ""; pp.dump_defines = 0; pp.dump_names = 0;
    pp.dump_includes = 0; pp.errors = 0; pp.compact = 0; pp.dump_macros = 0;
    pp.dep_only = 0; pp.dep_side = 0; pp.dep_no_sys = 0; pp.dep_phony = 0; pp.dep_file = "";
    list<string> def_ops;          // "D<def>" / "U<name>", applied in command-line order
    list<string> isystem_dirs;
    list<string> after_dirs;
    list<string> include_files;    // -include
    list<string> imacros_files;    // -imacros
    i32 positional = 0;
    string std_name = "gnu23";     // gcc's default dialect
    for (i32 ai = 1; ai < argc; ai++) {
        string arg = argv[ai];
        // A flag whose value is either attached (`-Ifoo`) or the next argument.
        string val = "";
        i32 takes = 0;
        list<string> valued;
        valued.add("-D"); valued.add("-U"); valued.add("-I"); valued.add("-o"); valued.add("-x");
        valued.add("-include"); valued.add("-imacros"); valued.add("-iquote"); valued.add("-isystem");
        valued.add("-idirafter"); valued.add("-MF"); valued.add("-MT"); valued.add("-MQ");
        string flag = "";
        for (i32 vi = 0; vi < valued.length; vi++) {
            string f = valued[vi];
            if (arg == f) { flag = f; takes = 1; break; }
            // attached form; `-include`/`-imacros` only separate (as gcc)
            if (arg.starts_with(f) && arg.size > f.size && f != "-include" && f != "-imacros"
                && !(f == "-I" && (arg.starts_with("-iquote") || arg.starts_with("-isystem") || arg.starts_with("-idirafter")))) {
                // the longest matching flag wins (`-isystem` vs `-I`)
                if (flag.size < f.size) { flag = f; val = arg[f.size:]; }
            }
        }
        if (takes) {
            if (ai + 1 >= argc) {
                std::Println("sic-cpp: error: missing argument to '{}'", arg, target = 2);
                return 1;
            }
            ai++;
            val = argv[ai];
        }
        if (flag == "-D") { def_ops.add("D" + val); }
        else if (flag == "-U") { def_ops.add("U" + val); }
        else if (flag == "-I") { add_dir(&pp.include_dirs, val); }
        else if (flag == "-o") { pp.out_path = val; }
        else if (flag == "-x") { /* C only — accepted */ }
        else if (flag == "-include") { include_files.add(val); }
        else if (flag == "-imacros") { imacros_files.add(val); }
        else if (flag == "-iquote") { pp.quote_dirs.add(val); }
        else if (flag == "-isystem") { isystem_dirs.add(val); }
        else if (flag == "-idirafter") { after_dirs.add(val); }
        else if (flag == "-MF") { pp.dep_file = val; }
        else if (flag == "-MT") { pp.dep_targets.add(val); }
        else if (flag == "-MQ") { pp.dep_targets.add(make_escape(val)); }
        else if (arg == "-M") { pp.dep_only = 1; }
        else if (arg == "-MM") { pp.dep_only = 1; pp.dep_no_sys = 1; }
        else if (arg == "-MD") { pp.dep_side = 1; }
        else if (arg == "-MMD") { pp.dep_side = 1; pp.dep_no_sys = 1; }
        else if (arg == "-MP") { pp.dep_phony = 1; }
        else if (arg == "-MG") { pp.missing_ok = 1; }
        else if (arg == "-dM") { pp.dump_macros = 1; }
        else if (arg == "-dD") { pp.dump_defines = 1; }
        else if (arg == "-dN") { pp.dump_names = 1; }
        else if (arg == "-dI") { pp.dump_includes = 1; }
        else if (arg.starts_with("--embed-dir=")) { pp.embed_dirs.add(arg[12:]); }
        else if (arg == "--embed-dir" && ai + 1 < argc) { ai++; string ed = argv[ai]; pp.embed_dirs.add(ed); }
        else if (arg.starts_with("-std=")) { std_name = arg[5:]; }
        else if (arg == "-ansi") { std_name = "c90"; }
        else if (arg.starts_with("-W") || arg == "-w" || arg == "-E"
                 || (arg.starts_with("-f") && arg != "-ffreestanding") || arg.starts_with("-m")
                 || arg.starts_with("-O") || arg.starts_with("-g") || arg == "-pipe"
                 || arg.starts_with("-pedantic") || arg.starts_with("-d")
                 || arg == "--gcc-lines" || arg == "-H"
                 || arg == "-trigraphs" || arg == "-traditional-cpp") {

        }
        else if (arg == "-C") { if (g_keep_comments == 0) g_keep_comments = 1; }
        else if (arg == "-CC") { g_keep_comments = 2; }
        else if (arg == "-undef") { undef = 1; }
        else if (arg == "-nostdinc") { nostdinc = 1; }
        else if (arg == "-v") { verbose = 1; }
        else if (arg == "--compact") { pp.compact = 1; }
        else if (arg == "-P") { no_markers = 1; }
        else if (arg == "-ffreestanding") { freestanding = 1; }
        else if (arg == "-" || arg[0] != '-') {
            // `cpp [in] [out]`
            if (positional == 0) input_file = arg;
            else if (positional == 1) pp.out_path = arg;
            positional++;
        }
        else std::Println("sic-cpp: warning: unrecognized option '{}' (ignored)", arg, target = 2);
    }
    pp.input_name = input_file.size > 0 && input_file != "-" ? input_file : "-";
    // -MD/-MMD without -MF: the .d file sits next to the output (`out.i` →
    // `out.d`), or is named after the input without -o.
    if (pp.dep_side && pp.dep_file.size == 0) {
        string base = pp.out_path.size > 0 ? pp.out_path : pp.input_name;
        if (pp.out_path.size == 0) {
            i32 sl = base.size - 1;
            while (sl >= 0 && base[sl] != '/') sl--;
            base = base[sl+1:];
        }
        i32 dot = base.size - 1;
        while (dot > 0 && base[dot] != '.' && base[dot] != '/') dot--;
        if (dot > 0 && base[dot] == '.') base = base[0:dot];
        pp.dep_file = base + ".d";
    }

    // Search order (as gcc): -I dirs, then CPATH / C_INCLUDE_PATH, then the
    // detected system dirs (unless -nostdinc).
    string info = sic_info();
    string cc = (info.size > 0 || (nostdinc && undef)) ? "" : find_compiler();
    setenv(RECURSION_ENV.str, "1", 1);   // for every host query below
    add_env_dirs(&pp.include_dirs, "CPATH");
    add_env_dirs(&pp.include_dirs, "C_INCLUDE_PATH");
    {
        // As gcc: a -I naming a system directory is ignored, so the directory
        // keeps its system position (else -I/usr/include would shadow the
        // compiler's own stddef.h/stdarg.h).
        list<string> std_dirs;
        if (!nostdinc) std_dirs = info.size > 0 ? info_records(info, "include") : system_include_dirs(cc);   // -nostdinc drops only these
        // The <x> chain: -I, then -isystem, the standard dirs, then -idirafter
        // (all but -I are system directories).
        list<string> sys;
        for (i32 i = 0; i < isystem_dirs.length; i++) add_dir(&sys, isystem_dirs[i]);
        for (i32 i = 0; i < std_dirs.length; i++) add_dir(&sys, std_dirs[i]);
        for (i32 i = 0; i < after_dirs.length; i++) add_dir(&sys, after_dirs[i]);
        list<string> user;
        for (i32 i = 0; i < pp.include_dirs.length; i++) {
            i32 is_sys = 0;
            for (i32 k = 0; k < sys.length; k++) if (sys[k] == pp.include_dirs[i]) is_sys = 1;
            if (!is_sys) user.add(pp.include_dirs[i]);
        }
        pp.user_dirs = user.length;
        for (i32 i = 0; i < sys.length; i++) add_dir(&user, sys[i]);
        pp.include_dirs = user;
    }

    // Predefined macros: the target description from the host compiler (unless
    // -undef), then sic-cpp's own identity on top — it presents as the sic
    // compiler (clang 15 / gcc 4.2 compatible), whatever compiler was consulted.
    // The dialect (-std= / -ansi): __STDC_VERSION__, and in strict ISO modes
    // __STRICT_ANSI__ (removed again by -undef, as in gcc).
    i32 strict = std_name.starts_with("c") || std_name.starts_with("iso");
    string stdc_version = "202311L";
    if (std_name == "c89" || std_name == "c90" || std_name == "gnu89" || std_name == "gnu90"
        || std_name == "iso9899:1990") stdc_version = "";
    else if (std_name == "iso9899:199409") stdc_version = "199409L";
    else if (std_name.ends_with("99") || std_name.ends_with("9x") || std_name == "iso9899:1999") stdc_version = "199901L";
    else if (std_name.ends_with("11") || std_name.ends_with("1x") || std_name == "iso9899:2011") stdc_version = "201112L";
    else if (std_name.ends_with("17") || std_name.ends_with("18") || std_name == "iso9899:2017" || std_name == "iso9899:2018") stdc_version = "201710L";
    if (info.size == 0 && cc.size == 0) {
        if (!undef) fallback_predefines(&pp);
    } else {
        list<string> defs = info.size > 0 ? info_records(info, "define") : compiler_predefines(cc);
        for (i32 i = 0; i < defs.length; i++) {
            string d = info.size > 0 ? defs[i] : defs[i][8:];   // drop "#define "
            i32 n = 0;
            while (n < d.size && is_ident(d[n])) n++;
            if (keep_predefine(d[0:n], undef, strict)) pp_define(&pp, d);
        }
    }
    pp.cc = cc;
    // `__has_*` are operators of `#if` (handled before expansion), but they are
    // also `defined` / `#ifdef`-visible, as in gcc and clang.
    pp.macros["__has_include"] = "B|";
    pp.macros["__has_include_next"] = "B|";
    pp.macros["__has_embed"] = "B|";
    pp.macros["__STDC_EMBED_NOT_FOUND__"] = "O|0";
    pp.macros["__STDC_EMBED_FOUND__"] = "O|1";
    pp.macros["__STDC_EMBED_EMPTY__"] = "O|2";
    // Which of the query operators exist, and their answers: from sic, else
    // compiler-specific (gcc 14 added `__has_feature`/`__has_extension`): ask
    // the host once, in one run.
    if (info.size > 0) {
        pp.info_mode = 1;
        list<string> has = info_records(info, "has");
        for (i32 i = 0; i < has.length; i++) {
            list<string> f = split_all(has[i], ' ');
            string op = "__has_" + f[0];
            pp.macros[op] = "B|";
            for (i32 k = 1; k < f.length; k++) {
                if (f[k].size == 0) continue;
                i32 eq = 0;
                while (eq < f[k].size && f[k][eq] != '=') eq++;
                string v = eq < f[k].size ? f[k][eq+1:] : "1";
                pp.has_cache[op + "(" + f[k][0:eq] + ")"] = v.dup;
            }
        }
    } else if (cc.size > 0) {
        list<string> ops;
        ops.add("__has_attribute"); ops.add("__has_c_attribute"); ops.add("__has_cpp_attribute");
        ops.add("__has_builtin"); ops.add("__has_feature"); ops.add("__has_extension");
        ops.add("__has_declspec_attribute");
        string prog = "";
        for (i32 i = 0; i < ops.length; i++)
            prog = prog + "#ifdef " + ops[i] + "\\nsiccpp_op_" + std::Fmt("{}", i) + "\\n#endif\\n";
        list<string> got = run_lines("printf '" + prog + "' | " + cc + " -xc -E -P - 2>/dev/null");
        for (i32 i = 0; i < got.length; i++) {
            string g = got[i].trim();
            for (i32 k = 0; k < ops.length; k++) if (g == "siccpp_op_" + std::Fmt("{}", k)) pp.macros[ops[k]] = "B|";
        }
    }
    pp.macros["__STDC__"] = "O|1";
    if (stdc_version.size > 0) pp.macros["__STDC_VERSION__"] = "O|" + stdc_version;
    if (strict && !undef) pp.macros["__STRICT_ANSI__"] = "O|1";
    // char16_t/char32_t are UTF-16/-32 from C11 on.
    if (stdc_version.size > 0 && stdc_version != "199409L" && stdc_version != "199901L") {
        pp.macros["__STDC_UTF_16__"] = "O|1";
        pp.macros["__STDC_UTF_32__"] = "O|1";
    }
    pp.macros["__STDC_HOSTED__"] = "O|1";
    pp.macros["__SICC__"] = "O|1";
    pp.macros["__SICC_MINOR__"] = "O|0";
    pp.macros["__clang__"] = "O|1";
    pp.macros["__clang_major__"] = "O|15";
    pp.macros["__clang_minor__"] = "O|0";
    pp.macros["__GNUC__"] = "O|4";
    pp.macros["__GNUC_MINOR__"] = "O|2";
    pp.macros["__GNUC_PATCHLEVEL__"] = "O|1";
    pp.macros["__clang_patchlevel__"] = "O|0";
    pp.macros["__clang_version__"] = "O|\"15.0.0\"";
    pp.macros["__VERSION__"] = "O|\"Clang 15.0.0\"";
    if (verbose) {
        std::Println("#include <...> search starts here:", target = 2);
        for (i32 i = 0; i < pp.include_dirs.length; i++) std::Println(" {}", pp.include_dirs[i], target = 2);
        std::Println("End of search list.", target = 2);
    }

    // Apply -D / -U in command-line order (`-DX -UX` leaves X undefined). A
    // define is `NAME[(params)][=body]`, body defaulting to 1 — handed to the
    // #define handler, so function-like command-line macros work too.
    // (-dD/-dN print the predefined macros under <built-in> and these under
    // <command-line>, as gcc does.)
    list<string> builtin_lines;
    list<string> cmdline_lines;
    if (pp.dump_defines || pp.dump_names) {
        for (tuple kv : pp.macros) {
            string n = kv[0];
            string enc = kv[1];
            if (enc.starts_with("O|") || enc.starts_with("F|"))
                builtin_lines.add(pp.dump_defines ? define_text(&pp, n) : "#define " + n);
        }
    }
    for (i32 i = 0; i < def_ops.length; i++) {
        string op = def_ops[i];
        string d = op[1:];
        if (op[0] == 'U') {
            del pp.macros[d.trim()];
            if (pp.dump_defines || pp.dump_names) cmdline_lines.add("#undef " + d.trim());
            continue;
        }
        i32 eq = 0;
        while (eq < d.size && d[eq] != '=') eq++;
        if (eq < d.size) pp_define(&pp, d[0:eq] + " " + d[eq+1:]);
        else pp_define(&pp, d + " 1");
        i32 n = 0;
        while (n < d.size && is_ident(d[n])) n++;
        if (pp.dump_defines || pp.dump_names)
            cmdline_lines.add(pp.dump_defines ? define_text(&pp, d[0:n]) : "#define " + d[0:n]);
    }

    // Read input
    string content;
    if (input_file.size > 0 && input_file != "-") {
        pp.current_file = input_file;
        if (!file_exists(input_file)) {
            std::Println("sic-cpp: fatal error: {}: No such file or directory", input_file, target = 2);
            std::Println("compilation terminated.", target = 2);
            return 1;
        }
        content = read_file(input_file);
    } else {
        pp.current_file = "<stdin>";
        // Plain read(2) until EOF (works for pipes, terminals and files alike).
        content = "";
        u8 buf[65536];
        while (true) {
            i64 n = read(0, (void*)buf, 65536);
            if (n <= 0) break;
            content = content + string.create((char*)buf, (u64)n);
        }
    }

    if (!g_keep_comments) content = strip_comments(content);
    pp.markers = !no_markers && !pp.dep_only && !pp.dump_macros;
    string main_file = pp.current_file;
    add_dep(&pp, main_file, 0);

    // gcc's preamble, then the implicit `-include stdc-predef.h` (glibc's
    // __STDC_IEC_559__, __STDC_ISO_10646__, …) when the C library provides one
    // on the system path — gcc does this unless -nostdinc/-ffreestanding.
    // (-dD/-dN definitions sit at line 0 of <built-in> / <command-line>, so —
    // exactly as in gcc — each one after the first is re-marked.)
    if (pp.markers) emit_marker(&pp, 0, main_file, "");
    pp.current_file = "<built-in>";
    pp.current_line = 0;
    if (pp.markers) emit_marker(&pp, 0, "<built-in>", "");
    for (i32 i = 0; i < builtin_lines.length; i++) add_out(&pp, builtin_lines[i]);
    pp.current_file = "<command-line>";
    if (pp.markers) emit_marker(&pp, 0, "<command-line>", "");
    for (i32 i = 0; i < cmdline_lines.length; i++) add_out(&pp, cmdline_lines[i]);
    pp.current_file = "<command-line>";
    pp.current_line = 0;
    // -imacros files first (only their macros are kept), then stdc-predef.h,
    // then -include files — gcc's order.
    for (i32 i = 0; i < imacros_files.length; i++) {
        pp.discard = 1;
        cmdline_include(&pp, imacros_files[i]);
        pp.discard = 0;
    }
    if (!nostdinc && !freestanding) {
        i32 dir = -1;
        string predef = resolve_include(&pp, "stdc-predef.h", 0, pp.user_dirs, &dir);
        if (predef.size > 0) enter_file(&pp, predef, 1, dir);
    }
    for (i32 i = 0; i < include_files.length; i++) cmdline_include(&pp, include_files[i]);
    pp.current_file = main_file;
    pp.current_line = 1;
    if (pp.markers) emit_marker(&pp, 1, main_file, "");
    pp_process_content(&pp, content);
    flush_and_exit(&pp, pp.errors > 0 ? 1 : 0);
    return 0;
}

// A command-line `-include`/`-imacros` file: looked up in the current working
// directory first (gcc shows it as `./name`), then like `#include "name"`.
void cmdline_include(Preprocessor *pp, string name) {
    string path = "";
    i32 dir = -1;
    if (name.starts_with("/")) path = file_exists(name) ? name : "";
    else if (file_exists("./" + name)) path = "./" + name;
    else path = resolve_include(pp, name, 1, 0, &dir);
    if (path.size == 0) {
        std::Println("<command-line>: fatal error: {}: No such file or directory", name, target = 2);
        std::Println("compilation terminated.", target = 2);
        flush_and_exit(pp, 1);
    }
    enter_file(pp, path, dir >= 0 ? dir >= pp->user_dirs : 0, dir);
}


