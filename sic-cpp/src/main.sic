// sic-cpp — the C preprocessor as a command: the `sicpp` module with `cpp`'s
// command line (see lib/sicpp.sic).
import std;
import sicpp;

int main(int argc, char **argv)
{
    list<string> args;
    for (i32 i = 1; i < argc; i++) {
        string arg = argv[i];
        args.add(arg);
    }
    sicpp::Output r = sicpp::Run(args, "");
    std::Print("{}", r.errors, target = 2);
    std::Print("{}", r.text);
    return r.status;
}
