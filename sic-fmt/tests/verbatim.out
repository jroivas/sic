// Directives, macro_rules definitions, multiline strings and sic-fmt: off
// regions are kept as written.
#include <stdio.h>
#define SQ(x)   ((x)*(x))
macro_rules twice {
    ($e:expr) => ( $e   +   $e );
}
// sic-fmt: off
i32 table[] = { 1,  2,  3,
                40, 50, 60 };
// sic-fmt: on
int main()
{
    string s = r"""keep   these
      lines    as they are""";
#ifdef DEBUG
    printf("%s\n", s.ptr);
#endif
    return twice(SQ(2)) + table[0];
}
