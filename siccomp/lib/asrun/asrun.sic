// asrun — sic's async runtime (sic.md §"Async"). A small cooperative,
// single-threaded coroutine executor built on `ucontext` stackful coroutines. This
// is the "as much as possible in a module" implementation: the compiler only emits
// the `async`/`await`/`Task<T>` surface; the scheduling lives here and can grow
// (timers, I/O reactor, join/select) without touching the compiler.
//
// Usage:
//   import asrun;
//   void worker(void *arg) { … asrun::yield_now(); … }
//   asrun::spawn(worker, arg);
//   asrun::run();          // drive all coroutines to completion
module asrun;

#include <ucontext.h>

extern void *malloc(unsigned long);
extern void free(void *);

// Fixed-capacity scheduler state (single-threaded, so plain statics are fine).
#define ASRUN_MAX   256
#define ASRUN_STACK 65536

static ucontext_t asrun_main;
static ucontext_t *asrun_ctx[ASRUN_MAX];
static void *asrun_stack[ASRUN_MAX];
static void (*asrun_fn[ASRUN_MAX])(void *);
static void *asrun_arg[ASRUN_MAX];
static int asrun_alive[ASRUN_MAX];
static int asrun_n = 0;
static int asrun_cur = -1;

// Each coroutine starts here, runs its function, then marks itself done and
// switches back to the scheduler (uc_link also points there as a safety net).
static void asrun_trampoline(void) {
    int i = asrun_cur;
    asrun_fn[i](asrun_arg[i]);
    asrun_alive[i] = 0;
    swapcontext(asrun_ctx[i], &asrun_main);
}

// Schedule `fn(arg)` to run as a coroutine. It does not start until `run()`.
int spawn(void (*fn)(void *), void *arg) {
    if (asrun_n >= ASRUN_MAX) return -1;
    int i = asrun_n;
    asrun_n = asrun_n + 1;
    asrun_ctx[i] = (ucontext_t *)malloc(sizeof(ucontext_t));
    asrun_stack[i] = malloc(ASRUN_STACK);
    getcontext(asrun_ctx[i]);
    asrun_ctx[i]->uc_stack.ss_sp = asrun_stack[i];
    asrun_ctx[i]->uc_stack.ss_size = ASRUN_STACK;
    asrun_ctx[i]->uc_link = &asrun_main;
    asrun_fn[i] = fn;
    asrun_arg[i] = arg;
    asrun_alive[i] = 1;
    makecontext(asrun_ctx[i], asrun_trampoline, 0);
    return i;
}

// Yield from the current coroutine back to the scheduler (call only inside a
// coroutine started by `spawn`).
void yield_now(void) {
    int i = asrun_cur;
    if (i < 0) return;
    swapcontext(asrun_ctx[i], &asrun_main);
}

// Run the scheduler until every spawned coroutine has finished. Round-robin: each
// pass resumes every still-alive coroutine once.
void run(void) {
    int progress = 1;
    while (progress) {
        progress = 0;
        for (int i = 0; i < asrun_n; i++) {
            if (asrun_alive[i]) {
                progress = 1;
                asrun_cur = i;
                swapcontext(&asrun_main, asrun_ctx[i]);
            }
        }
    }
    // All done — reclaim stacks/contexts and reset for a fresh run.
    for (int i = 0; i < asrun_n; i++) {
        free(asrun_stack[i]);
        free(asrun_ctx[i]);
    }
    asrun_n = 0;
    asrun_cur = -1;
}

// The number of coroutines still scheduled (alive) — handy for tests/diagnostics.
int pending(void) {
    int c = 0;
    for (int i = 0; i < asrun_n; i++) if (asrun_alive[i]) c = c + 1;
    return c;
}
