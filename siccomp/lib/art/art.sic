// art — sic's async runtime module (sic.md §"Async"). The scheduler itself is
// the task runtime sic adds to every program that uses `async`, `await`, `Task`
// or `import art` (one per thread, each task on a stack of its own); this module
// is its API, so `art::spawn` coroutines and async functions' tasks share one
// scheduler.
//
// Usage:
//   import art;
//   void worker(void *arg) { … art::yield_now(); … }
//   art::spawn(worker, arg);
//   art::run();          // drive all coroutines to completion
module art;

// The program's scheduler (its definitions are in the program, not here).
extern int __sic_task_spawn_fn(void (*fn)(void *), void *arg);
extern void __sic_task_yield(void);
extern void __sic_task_sleep_ms(long ms);
extern void __sic_task_run_all(void);
extern long __sic_task_pending(void);

// Schedule `fn(arg)` to run as a coroutine nobody waits for. It starts when the
// code that made it waits (`run()`, `yield_now()`, `sleep()`, an `await`).
// 0, or -1 when out of memory.
int spawn(void (*fn)(void *), void *arg)
{
    return __sic_task_spawn_fn(fn, arg);
}

// Let the other coroutines run: in a coroutine, until it is resumed; elsewhere,
// each of them once.
void yield_now(void)
{
    __sic_task_yield();
}

// Wait at least `ms` milliseconds while the other coroutines run.
void sleep(int ms)
{
    __sic_task_sleep_ms((long)ms);
}

// Run until every coroutine has finished (in a coroutine: every other one).
void run(void)
{
    __sic_task_run_all();
}

// The number of coroutines of this thread not yet finished.
int pending(void)
{
    return (int)__sic_task_pending();
}
