module std;

namespace Buffer
{
    struct Buffer {
        u64 size;
        u8 *data;
        ~Buffer() {
            del data;
        }
    };


    Buffer *Create(u64 size)
    {
        Buffer *buf = new Buffer();

        if (!buf)
            return NULL;

        buf->data = new u8(size);
        if (!buf->data)
        {
            del buf;
            return NULL;
        }
        buf->size = size;

        return buf;
    }
}
