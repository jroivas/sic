module std;

namespace Buffer
{
    struct Buffer {
        u64 capacity;
        u64 size;
        u8 *data;
        ~Buffer() {
            del data;
        }
    };

    Buffer *Create(u64 size)
    {
        Buffer *buf = new Buffer() else return NULL;

        buf->data = new u8(size);
        if (!buf->data)
        {
            del buf;
            return NULL;
        }
        buf->capacity = size;
        buf->size = 0;

        return buf;
    }

    // The buffer's bytes as a `string` — a non-owning VIEW over `b->data` with the
    // buffer's own length, built without a copy or NUL-termination (so binary data
    // and non-terminated reads are exact). The view borrows the buffer: it is valid
    // only while `b` lives; `.dup` it (or copy into an owned `string`) to outlive a
    // `del b`.
    string Value(Buffer *b)
    {
        if (b == NULL)
            return "";
        return string.create(b->data, b->size);
    }

    // The raw byte pointer, for callers that need it directly.
    const u8* Data(Buffer *b)
    {
        if (b == NULL)
            return NULL;
        return b->data;
    }
}
