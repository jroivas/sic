module std;

namespace Buffer
{
    struct Buffer {
        u64 capacity;
        u64 size;
        u8 *data;
        ~Buffer() {
            del data;
        }
    };

    Buffer *Create(u64 size)
    {
        Buffer *buf = new Buffer() else return NULL;

        buf->data = new u8(size);
        if (!buf->data)
        {
            del buf;
            return NULL;
        }
        buf->capacity = size;
        buf->size = 0;

        return buf;
    }

    const u8* Value(Buffer *b)
    {
        if (b == NULL)
            return NULL
        return b->data;
    }
}
