module std;

#include <unistd.h>
#include <errno.h>

// Write all `n` bytes, retrying short writes and EINTR. False on an error.
static bool write_all(int fd, char *p, u64 n)
{
    u64 done = 0;
    while (done < n) {
        isize w = write(fd, p + done, n - done);
        if (w < 0) {
            if (errno == EINTR) continue;
            return false;
        }
        done += (u64)w;
    }
    return true;
}

// `Print(fmt, a, b, …)` — format `fmt` with the arguments (the same `{}`
// placeholders as `Fmt`) and write the result to a target file descriptor,
// defaulting to stdout. Because the default parameter sits before the `va_array`,
// the target is keyword-only at the call site (sic.md §"Default parameters"):
// `Print("x={}", x)` writes to stdout, `Print("x={}", x, target=2)` to stderr.
// `args` is forwarded to `Fmt` as one already-collected `va_array`, not re-boxed.
int Print(string fmt, int target = 1, va_array args, va_dict kwargs)
{
    string s = Fmt(fmt, args, kwargs);
    return write_all(target, s.ptr, s.size) ? 0 : -1;
}

// `Println(fmt, a, b, …)` — like `Print`, followed by a newline. Named arguments
// (`name = value`) other than `target` are collected into `kwargs` for `{name}`
// placeholders; `target` selects the output fd (default stdout). Both return
// 0, or -1 when the write fails (short writes are retried).
int Println(string fmt, int target = 1, va_array args, va_dict kwargs)
{
    string s = Fmt(fmt, args, kwargs) + "\n";
    return write_all(target, s.ptr, s.size) ? 0 : -1;
}
// NOTE: cross-module default-argument support (below) carries these defaults in
// the `.smod` manifest so a consumer's `std::Print(...)` fills `target`.
