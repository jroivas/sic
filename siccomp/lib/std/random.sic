module std;

#include <time.h>
#include <errno.h>
#include <sys/random.h>

// Pseudorandom number generators.
//
// Usage:
//   auto g = std::random::rng();       // system-seeded default (SplitMix64)
//   u64 x = g.gen64();
//   u32 y = g.gen32();
//
//   auto p = std::random::pcg32(seed);
//   auto x = std::random::xoshiro256(seed);
//   auto c = std::random::chacha12(seed);
//
// Each RNG is a self-contained struct with no shared state: separate
// instances may be used from separate threads freely; one instance must not
// be shared between threads without a lock. Copying a generator copies its
// state, so both copies then produce the same sequence.
//
// The default is SplitMix64: fast, 64-bit state, good statistical quality.
// For heavier-duty needs, xoshiro256++ (large state, long period) or
// ChaCha12 are also provided. Only a system-seeded ChaCha12 (seed 0: a
// 256-bit key from getrandom) is suitable for secrets; an explicit u64 seed
// gives any generator at most 64 bits of entropy.

// -- Module-level bridge for getrandom (avoids name shadowing) --

// Fill buf with len bytes of system entropy, retrying short reads and
// EINTR. False on failure.
static bool FillRandom(u8 *buf, usize len) {
    usize done = 0;
    while (done < len) {
        isize n = getrandom(buf + done, len - done, 0);
        if (n < 0) {
            if (errno == EINTR) continue;
            return false;
        }
        done += n;
    }
    return true;
}

namespace random
{
    // ------------------------------------------------------------------
    // Internal helpers
    // ------------------------------------------------------------------

    // Quarter round for ChaCha (operates on u32 values through pointers).
    static void chacha_qr(u32 *a, u32 *b, u32 *c, u32 *d) {
        *a += *b; *d ^= *a; *d = *d <<< 16;
        *c += *d; *b ^= *c; *b = *b <<< 12;
        *a += *b; *d ^= *a; *d = *d <<< 8;
        *c += *d; *b ^= *c; *b = *b <<< 7;
    }

    // ------------------------------------------------------------------
    // SplitMix64 -- the default RNG (fast, 64-bit state, good quality)
    //   state += 0x9E3779B97F4A7C15;
    //   z = state; z = (z ^ (z >> 30)) * M1; z = (z ^ (z >> 27)) * M2; z ^= (z >> 31);
    // ------------------------------------------------------------------

    struct SplitMix64 {
        u64 state;

        u64 gen64(struct SplitMix64 *self) {
            self->state += 0x9E3779B97F4A7C15;
            u64 z = self->state;
            z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
            z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
            z = z ^ (z >> 31);
            return z;
        }

        u32 gen32(struct SplitMix64 *self) {
            return (u32)(self->gen64());
        }
    };

    // ------------------------------------------------------------------
    // PCG32 -- permuted congruential generator (32-bit output)
    //   state = state * 0x5851F42D4C957F2D + (inc | 1);
    //   output = xorshifted >> rot | xorshifted << ((0-rot) & 31)
    // ------------------------------------------------------------------

    struct PCG32 {
        u64 state;
        u64 inc;

        u32 gen32(struct PCG32 *self) {
            u64 old = self->state;
            self->state = old * 0x5851F42D4C957F2D + (self->inc | 1);
            u32 xorshifted = (u32)(((old >> 18) ^ old) >> 27);
            u32 rot = (u32)(old >> 59);
            return (xorshifted >> rot) | (xorshifted << ((0 - rot) & 31));
        }

        u64 gen64(struct PCG32 *self) {
            u32 lo = self->gen32();
            u32 hi = self->gen32();
            return ((u64)hi << 32) | (u64)lo;
        }
    };

    // ------------------------------------------------------------------
    // Xoshiro256++ -- xor/shift generator (256-bit state, long period)
    //   result = s0 + s3; t = s1 << 17; s2 ^= s0; s3 ^= s1;
    //   s1 ^= s2; s0 ^= s3; s2 ^= t; s3 = rotl(s3, 45);
    // ------------------------------------------------------------------

    struct Xoshiro256PP {
        u64 s0, s1, s2, s3;

        u64 gen64(struct Xoshiro256PP *self) {
            u64 result = self->s0 + self->s3;
            u64 t = self->s1 << 17;
            self->s2 ^= self->s0;
            self->s3 ^= self->s1;
            self->s1 ^= self->s2;
            self->s0 ^= self->s3;
            self->s2 ^= t;
            self->s3 = self->s3 <<< 45;
            return result;
        }

        u32 gen32(struct Xoshiro256PP *self) {
            return (u32)(self->gen64());
        }
    };

    // ------------------------------------------------------------------
    // ChaCha12 -- ChaCha stream cipher with 12 rounds as a PRNG
    //   State: constants + 8-word key + 2-word counter + 2-word nonce
    //   64 bytes / block; 12 rounds = 6 double rounds of quarter rounds
    // ------------------------------------------------------------------

    struct ChaCha12 {
        u32 key[8];
        u32 ctr_lo;
        u32 ctr_hi;
        u32 nonce_lo;
        u32 nonce_hi;
        u32 block[16];
        u32 index;

        void next_block(struct ChaCha12 *self) {
            u32 s[16];
            s[0] = 0x61707865; s[1] = 0x3320646e;
            s[2] = 0x79622d32; s[3] = 0x6b206574;
            for (int i = 0; i < 8; i++) s[4 + i] = self->key[i];
            s[12] = self->ctr_lo;
            s[13] = self->ctr_hi;
            s[14] = self->nonce_lo;
            s[15] = self->nonce_hi;

            u32 x[16];
            for (int i = 0; i < 16; i++) x[i] = s[i];

            for (int r = 0; r < 6; r++) {
                chacha_qr(&x[0], &x[4], &x[8], &x[12]);
                chacha_qr(&x[1], &x[5], &x[9], &x[13]);
                chacha_qr(&x[2], &x[6], &x[10], &x[14]);
                chacha_qr(&x[3], &x[7], &x[11], &x[15]);
                chacha_qr(&x[0], &x[5], &x[10], &x[15]);
                chacha_qr(&x[1], &x[6], &x[11], &x[12]);
                chacha_qr(&x[2], &x[7], &x[8], &x[13]);
                chacha_qr(&x[3], &x[4], &x[9], &x[14]);
            }

            for (int i = 0; i < 16; i++)
                self->block[i] = x[i] + s[i];

            self->ctr_lo++;
            if (self->ctr_lo == 0) self->ctr_hi++;
            self->index = 0;
        }

        u32 gen32(struct ChaCha12 *self) {
            if (self->index >= 16) self->next_block();
            u32 r = self->block[(int)self->index];
            self->index++;
            return r;
        }

        u64 gen64(struct ChaCha12 *self) {
            u32 lo = self->gen32();
            u32 hi = self->gen32();
            return ((u64)hi << 32) | (u64)lo;
        }
    };

    // Fill buf with len cryptographically secure random bytes (any length:
    // short reads are retried). Blocks until the kernel has enough entropy.
    // Some(len) on success, None on failure.
    Option<isize> getrandom(u8 *buf, usize len) {
        if (!FillRandom(buf, len))
            return None;
        return Option::Some((isize)len);
    }

    // ------------------------------------------------------------------
    // Factory functions
    //
    // Each returns Option<G>: Some(gen) on success, None on failure.
    // seed == 0 (the default) fills the generator's state from Linux
    // getrandom() -- cryptographically secure system entropy.  Any
    // non-zero seed reproduces the same sequence.
    // ------------------------------------------------------------------

    // Default RNG (SplitMix64) -- alias for splitmix64().
    Option<SplitMix64> rng() { return splitmix64(); }

    Option<SplitMix64> splitmix64(u64 seed = 0) {
        SplitMix64 g;
        if (seed == 0) {
            if (!FillRandom((u8 *)&g.state, sizeof(g.state)))
                return None;
        } else {
            g.state = seed;
        }
        g.gen64();
        return Option::Some(g);
    }

    Option<PCG32> pcg32(u64 seed = 0) {
        PCG32 g;
        if (seed == 0) {
            u64 r[2];
            if (!FillRandom((u8 *)r, sizeof(r))) return None;
            g.state = r[0];
            g.inc = r[1];
        } else {
            g.state = seed;
            g.inc = 0xDA3E39CB94B95BDB;
        }
        g.gen32();
        return Option::Some(g);
    }

    Option<Xoshiro256PP> xoshiro256(u64 seed = 0) {
        Xoshiro256PP g;
        if (seed == 0) {
            u64 r[4];
            if (!FillRandom((u8 *)r, sizeof(r))) return None;
            g.s0 = r[0];
            g.s1 = r[1];
            g.s2 = r[2];
            g.s3 = r[3];
        } else {
            SplitMix64 sm;
            sm.state = seed;
            g.s0 = sm.gen64();
            g.s1 = sm.gen64();
            g.s2 = sm.gen64();
            g.s3 = sm.gen64();
        }
        if (g.s0 == 0 && g.s1 == 0 && g.s2 == 0 && g.s3 == 0)
            g.s0 = 1;
        return Option::Some(g);
    }

    Option<ChaCha12> chacha12(u64 seed = 0) {
        ChaCha12 g;
        if (seed == 0) {
            if (!FillRandom((u8 *)g.key, sizeof(g.key))) return None;
        } else {
            SplitMix64 sm;
            sm.state = seed;
            sm.gen64();
            for (int i = 0; i < 8; i += 2) {
                u64 r = sm.gen64();
                g.key[i]     = (u32)(r);
                g.key[i + 1] = (u32)(r >> 32);
            }
        }
        g.ctr_lo   = 0;
        g.ctr_hi   = 0;
        g.nonce_lo = 0;
        g.nonce_hi = 0;
        g.index    = 16;
        return Option::Some(g);
    }
}
