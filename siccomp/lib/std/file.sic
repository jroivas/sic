module std;

#include <fcntl.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>
#include <string.h>

// File I/O through std::buffer.
//
// Usage:
//   auto st = std::file::Open("out.txt", std::file::OpenMode::Write);
//   match (st) { std::file::Status::Opened(f): ...; _: ...; }
//   std::file::WriteString(f, "hello\n");
//   std::file::ReadAll(f, buf);          // whole file, growing buf
//   while (std::file::ReadLine(f, buf) == std::file::Status::Read && buf->size > 0) ...
//   std::file::Close(f);
//
// Every call returns a std::file::Status (`==` compares only the variant:
// `st == std::file::Status::Read`; `match` to read the byte count). Read/Write move as many bytes as one
// call can (Read may return fewer than asked; 0 bytes means end of file, after
// which Eof() is true); Write and WriteString write everything or fail.

namespace file
{
    struct File {
        int fd;
        string name;
        u64 offset;
        bool stream;                // a standard stream: not seekable, never closed
        bool eof;                   // the last read hit end of file
        u8 *rbuf;                   // ReadLine read-ahead (allocated on first use)
        u64 rpos;                   // next unconsumed byte in rbuf
        u64 rlen;                   // bytes in rbuf
        File() { fd = -1; }
        ~File()
        {
            if (fd >= 0 && !stream)
                close(fd);
            del rbuf;
        }
    };

    enum OpenMode {
        Read,                       // read; the file must exist
        Write,                      // write; created if missing, truncated
        RW,                         // read and write; the file must exist
        Append,                     // write at the end; created if missing
    };

    enum Status {
        Success,
        Opened(File*),
        NotFound,
        InvalidObject,
        IO,
        InvalidFileHandle,
        Read(u64),
        Wrote(u64),
        ReadError,
        WriteError,
        OutOfMemory,
        Size(u64),
        InvalidOffset,
        PermissionDenied,
        IsDirectory,
        Error(int),                 // any other failure: the errno value
    };

    static File g_stdin = {
        .fd = 0,
        .name = "stdin",
        .stream = true,
    };

    static File g_stdout = {
        .fd = 1,
        .name = "stdout",
        .stream = true,
    };

    static File g_stderr = {
        .fd = 2,
        .name = "stderr",
        .stream = true,
    };

    File *Stdin(void)
    {
        return &g_stdin;
    }

    File *Stdout(void)
    {
        return &g_stdout;
    }

    File *Stderr(void)
    {
        return &g_stderr;
    }

    // An errno value as a Status; `fallback` for the generic read/write errors.
    static file::Status errno_status(int err, file::Status fallback)
    {
        if (err == ENOENT || err == ENOTDIR)
            return file::Status::NotFound;
        if (err == EACCES || err == EPERM || err == EROFS)
            return file::Status::PermissionDenied;
        if (err == EISDIR)
            return file::Status::IsDirectory;
        if (err == EIO)
            return file::Status::IO;
        if (err == EBADF)
            return file::Status::InvalidFileHandle;
        if (err == EINVAL || err == ESPIPE)
            return file::Status::InvalidOffset;
        if (err == ENOMEM)
            return file::Status::OutOfMemory;
        return fallback;
    }

    static const u64 RBUF_SIZE = 4096;

    // Append `n` bytes at `p` to `buf`'s contents, doubling its capacity as
    // needed. False if out of memory.
    static bool append(buffer::Buffer *buf, u8 *p, u64 n)
    {
        if (buf->size + n > buf->capacity)
        {
            u64 cap = buf->capacity < 128 ? 128 : buf->capacity;
            while (cap < buf->size + n)
                cap *= 2;
            if (!buffer::SetCapacity(buf, cap))
                return false;
        }
        if (n > 0)
            memcpy(buf->data + buf->size, p, n);
        buf->size += n;
        return true;
    }

    file::Status Open(string name, OpenMode mode)
    {
        File *tmp = new File() else return file::Status::OutOfMemory;
        int flags = 0;

        match (mode)
        {
            Read: flags |= O_RDONLY;
            Write: flags |= O_WRONLY | O_CREAT | O_TRUNC;
            RW: flags |= O_RDWR;
            Append: flags |= O_WRONLY | O_CREAT | O_APPEND;
        }

        do {
            tmp->fd = open(name.ptr, flags | O_CLOEXEC, 0644);
        } while (tmp->fd < 0 && errno == EINTR);
        if (tmp->fd < 0)
        {
            int err = errno;
            del tmp;
            return errno_status(err, file::Status::Error(err));
        }
        tmp->name = name;
        tmp->stream = false;
        if (mode == OpenMode::Append)
        {
            i64 end = lseek(tmp->fd, 0, SEEK_END);
            if (end > 0)
                tmp->offset = (u64)end;
        }

        return file::Status::Opened(tmp);
    }

    // Close the file and free it. The standard streams are left open.
    file::Status Close(File *f)
    {
        if (!f)
            return file::Status::InvalidObject;
        if (f == &g_stdin || f == &g_stdout || f == &g_stderr)
            return file::Status::Success;

        int res = close(f->fd);
        int err = errno;
        f->fd = -1;
        del f;
        if (res != 0 && err != EINTR)
            return errno_status(err, file::Status::Error(err));

        return file::Status::Success;
    }

    // Move to `offset` for the next unpositioned Read/Write. Not for streams.
    file::Status Seek(File *f, u64 offset)
    {
        if (!f)
            return file::Status::InvalidObject;
        if (f->stream)
            return file::Status::InvalidOffset;
        if (lseek(f->fd, offset, SEEK_SET) < 0)
            return errno_status(errno, file::Status::InvalidOffset);
        f->offset = offset;
        f->eof = false;
        f->rpos = 0;                // drop the read-ahead
        f->rlen = 0;
        return file::Status::Success;
    }

    // Read up to `size` bytes (at most the buffer's capacity) at `offset` into
    // `buf`, replacing its contents. Read(0) at end of file.
    file::Status ReadFrom(File *f, u64 offset, u64 size, buffer::Buffer *buf)
    {
        if (!f || !buf)
            return file::Status::InvalidObject;

        if (!f->stream && offset != f->offset)
        {
            file::Status st = Seek(f, offset);
            if (st != file::Status::Success)
                return st;
        }

        if (size > buf->capacity)
            size = buf->capacity;
        if (f->rpos < f->rlen)      // bytes ReadLine read ahead come first
        {
            u64 n = f->rlen - f->rpos;
            if (n > size)
                n = size;
            memcpy(buf->data, f->rbuf + f->rpos, n);
            f->rpos += n;
            f->offset += n;
            f->eof = false;
            buf->size = n;
            return file::Status::Read(n);
        }
        isize res;
        do {
            res = read(f->fd, buf->data, size);
        } while (res < 0 && errno == EINTR);
        if (res < 0)
            return errno_status(errno, file::Status::ReadError);
        f->offset += (u64)res;
        f->eof = res == 0 && size > 0;
        buf->size = (u64)res;

        return file::Status::Read((u64)res);
    }

    file::Status Read(File *f, u64 size, buffer::Buffer *buf)
    {
        if (!f)
            return file::Status::InvalidObject;
        return ReadFrom(f, f->offset, size, buf);
    }

    // Read from the current position to end of file into `buf`, growing its
    // capacity as needed. Read(total bytes).
    file::Status ReadAll(File *f, buffer::Buffer *buf)
    {
        if (!f || !buf)
            return file::Status::InvalidObject;
        buf->size = 0;
        if (f->rpos < f->rlen)      // the read-ahead first
        {
            if (!append(buf, f->rbuf + f->rpos, f->rlen - f->rpos))
                return file::Status::OutOfMemory;
            f->offset += f->rlen - f->rpos;
            f->rpos = f->rlen;
        }
        while (true)
        {
            if (buf->size == buf->capacity)
            {
                u64 cap = buf->capacity < 4096 ? 4096 : buf->capacity * 2;
                if (!buffer::SetCapacity(buf, cap))
                    return file::Status::OutOfMemory;
            }
            isize res;
            do {
                res = read(f->fd, buf->data + buf->size, buf->capacity - buf->size);
            } while (res < 0 && errno == EINTR);
            if (res < 0)
                return errno_status(errno, file::Status::ReadError);
            if (res == 0)
                break;
            buf->size += (u64)res;
            f->offset += (u64)res;
        }
        f->eof = true;
        return file::Status::Read(buf->size);
    }

    // Read one line into `buf` (growing it): the bytes up to and including the
    // next '\n', or to end of file for a last line without one. Read(bytes);
    // Read(0) once the file is exhausted. Lines may be any length.
    file::Status ReadLine(File *f, buffer::Buffer *buf)
    {
        if (!f || !buf)
            return file::Status::InvalidObject;
        if (!f->rbuf)
        {
            f->rbuf = new u8(RBUF_SIZE);
            if (!f->rbuf)
                return file::Status::OutOfMemory;
        }
        buf->size = 0;
        f->eof = false;
        while (true)
        {
            if (f->rpos == f->rlen)
            {
                isize res;
                do {
                    res = read(f->fd, f->rbuf, RBUF_SIZE);
                } while (res < 0 && errno == EINTR);
                if (res < 0)
                    return errno_status(errno, file::Status::ReadError);
                f->rpos = 0;
                f->rlen = (u64)res;
                if (res == 0)
                {
                    f->eof = true;
                    break;
                }
            }
            u64 end = f->rpos;
            bool newline = false;
            while (end < f->rlen)
            {
                u8 c = f->rbuf[end];
                end++;
                if (c == 10)        // '\n'
                {
                    newline = true;
                    break;
                }
            }
            u64 n = end - f->rpos;
            if (!append(buf, f->rbuf + f->rpos, n))
                return file::Status::OutOfMemory;
            f->rpos = end;
            f->offset += n;
            if (newline)
                break;
        }
        return file::Status::Read(buf->size);
    }

    // Write `n` bytes at `p`, retrying short writes. Wrote(n) or an error.
    static file::Status write_bytes(File *f, u64 offset, u8 *p, u64 n)
    {
        // A ReadLine read-ahead left the descriptor past the logical position:
        // move it back (dropping the read-ahead) before writing.
        if (!f->stream && f->rpos < f->rlen && offset == f->offset)
        {
            file::Status st = Seek(f, offset);
            if (st != file::Status::Success)
                return st;
        }
        if (!f->stream && offset != f->offset)
        {
            file::Status st = Seek(f, offset);
            if (st != file::Status::Success)
                return st;
        }

        u64 done = 0;
        while (done < n)
        {
            isize res = write(f->fd, p + done, n - done);
            if (res < 0)
            {
                if (errno == EINTR)
                    continue;
                return errno_status(errno, file::Status::WriteError);
            }
            done += (u64)res;
            f->offset += (u64)res;
        }

        return file::Status::Wrote(done);
    }

    // Write the buffer's contents at `offset` (ignored by Append files).
    file::Status WriteTo(File *f, u64 offset, buffer::Buffer *buf)
    {
        if (!f || !buf)
            return file::Status::InvalidObject;
        return write_bytes(f, offset, buf->data, buf->size);
    }

    file::Status Write(File *f, buffer::Buffer *buf)
    {
        if (!f || !buf)
            return file::Status::InvalidObject;
        return write_bytes(f, f->offset, buf->data, buf->size);
    }

    // Write a string's bytes at the current position.
    file::Status WriteString(File *f, string s)
    {
        if (!f)
            return file::Status::InvalidObject;
        return write_bytes(f, f->offset, (u8 *)s.ptr, s.size);
    }

    file::Status Size(File *f)
    {
        struct stat sb;

        if (!f)
            return file::Status::InvalidObject;

        if (fstat(f->fd, &sb) != 0)
            return errno_status(errno, file::Status::ReadError);

        return file::Status::Size((u64)sb.st_size);
    }

    // True after a read reached end of file (until a Seek or a read that
    // returns data).
    bool Eof(File *f)
    {
        if (!f)
            return true;
        return f->eof;
    }
}
