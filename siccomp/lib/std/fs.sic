module std;

#include <sys/stat.h>
#include <unistd.h>
#include <dirent.h>

// Filesystem operations.
//
// Usage:
//   std::fs::MkDir("/tmp/test", 0755);
//   auto names = std::fs::ReadDir("/tmp") else return 1;
//   for (string name : names.values) { ... }
//   std::fs::Exists("/tmp/file");

namespace fs
{
    // ------------------------------------------------------------------
    // Path / file operations
    // ------------------------------------------------------------------

    // Create a directory. Returns true on success.
    // mode is the permission bits (default 0755).
    bool MkDir(string path, u32 mode = 0755) {
        return mkdir(path.ptr, mode) == 0;
    }

    // Remove an empty directory. Returns true on success.
    bool RmDir(string path) {
        return rmdir(path.ptr) == 0;
    }

    // Delete a file (unlink). Returns true on success.
    bool Unlink(string path) {
        return unlink(path.ptr) == 0;
    }

    // Rename a file or directory. Returns true on success.
    bool Rename(string from, string to) {
        return rename(from.ptr, to.ptr) == 0;
    }

    // Change the current working directory. Returns true on success.
    bool ChDir(string path) {
        return chdir(path.ptr) == 0;
    }

    // Get the current working directory as a string.
    // Returns None if the path cannot be determined.
    Option<string> GetCwd() {
        char buf[4096];
        char *res = getcwd(buf, 4096);
        if (!res) return None;
        string s = buf;
        return Option::Some(s);
    }

    // ------------------------------------------------------------------
    // Directory listing — returns all entries in one shot
    // ------------------------------------------------------------------

    // List all entries in a directory (including . and ..), in the order
    // the filesystem returns them. None if the directory cannot be opened.
    Option<list<string>> ReadDir(string path) {
        list<string> entries;
        DIR *dp = opendir(path.ptr);
        if (!dp) return None;
        struct dirent *de;
        while ((de = readdir(dp)) != NULL) {
            entries.add(de->d_name);
        }
        closedir(dp);
        return Option::Some(entries);
    }

    // ------------------------------------------------------------------
    // Path queries
    // ------------------------------------------------------------------

    // Returns true if the path exists (any file type, including dirs).
    bool Exists(string path) {
        struct stat sb;
        return stat(path.ptr, &sb) == 0;
    }

    // Returns true if the path is a regular file.
    bool IsFile(string path) {
        struct stat sb;
        if (stat(path.ptr, &sb) != 0) return false;
        return (sb.st_mode & S_IFMT) == S_IFREG;
    }

    // Returns true if the path is a directory.
    bool IsDir(string path) {
        struct stat sb;
        if (stat(path.ptr, &sb) != 0) return false;
        return (sb.st_mode & S_IFMT) == S_IFDIR;
    }
}
