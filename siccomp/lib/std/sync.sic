module std;

#include <pthread.h>
#include <time.h>

// Thread synchronization primitives.
//
// Usage:
//   auto m = std::sync::CreateMutex() else return 1;
//   std::sync::Lock(m);
//   // critical section
//   std::sync::Unlock(m);
//
//   auto cv = std::sync::CreateCond() else return 1;
//   std::sync::Wait(cv, m);          // with m locked
//   std::sync::NotifyOne(cv);
//
//   std::sync::DestroyCond(cv);
//   std::sync::DestroyMutex(m);

namespace sync
{
    // ------------------------------------------------------------------
    // Mutex — wraps pthread_mutex_t (opaque storage)
    // ------------------------------------------------------------------

    // Opaque: holds a pthread_mutex_t (40 bytes on glibc x86-64) in
    // 8-byte-aligned storage. Always used through a pointer.
    struct Mutex {
        u64 data[8];
        bool live;                  // pthread_mutex_init succeeded

        ~Mutex()
        {
            if (live)
                pthread_mutex_destroy((pthread_mutex_t *)data);
        }
    };

    // Create a new mutex. Returns NULL on failure (out of memory/resources).
    Mutex *CreateMutex()
    {
        Mutex *m = new Mutex() else return NULL;
        if (pthread_mutex_init((pthread_mutex_t *)m->data, NULL) != 0) {
            del m;
            return NULL;
        }
        m->live = true;
        return m;
    }

    // Destroy a mutex and free its allocation.
    void DestroyMutex(Mutex *m)
    {
        if (!m) return;
        del m;
    }

    // Lock the mutex. Blocks until acquired.
    void Lock(Mutex *m)
    {
        if (!m) return;
        pthread_mutex_lock((pthread_mutex_t *)m->data);
    }

    // Unlock the mutex.
    void Unlock(Mutex *m)
    {
        if (!m) return;
        pthread_mutex_unlock((pthread_mutex_t *)m->data);
    }

    // Try to lock without blocking. Returns true if the lock was acquired.
    bool TryLock(Mutex *m)
    {
        if (!m) return false;
        return pthread_mutex_trylock((pthread_mutex_t *)m->data) == 0;
    }

    // ------------------------------------------------------------------
    // Cond — wraps pthread_cond_t (opaque storage)
    // ------------------------------------------------------------------

    // Opaque: holds a pthread_cond_t (48 bytes on glibc x86-64), 8-aligned.
    struct Cond {
        u64 data[8];
        bool live;                  // pthread_cond_init succeeded

        ~Cond()
        {
            if (live)
                pthread_cond_destroy((pthread_cond_t *)data);
        }
    };

    // Create a new condition variable. Returns NULL on failure. Its timed
    // waits run on CLOCK_MONOTONIC, so changing the wall clock does not
    // stretch or cut a TimedWait.
    Cond *CreateCond()
    {
        Cond *cv = new Cond() else return NULL;
        pthread_condattr_t attr;
        if (pthread_condattr_init(&attr) != 0) {
            del cv;
            return NULL;
        }
        pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
        int res = pthread_cond_init((pthread_cond_t *)cv->data, &attr);
        pthread_condattr_destroy(&attr);
        if (res != 0) {
            del cv;
            return NULL;
        }
        cv->live = true;
        return cv;
    }

    // Destroy a condition variable and free its allocation.
    void DestroyCond(Cond *cv)
    {
        if (!cv) return;
        del cv;
    }

    // Wait on a condition variable. Unlocks mutex, waits for signal, then
    // re-acquires the mutex before returning.
    void Wait(Cond *cv, Mutex *m)
    {
        if (!cv || !m) return;
        pthread_cond_wait(
            (pthread_cond_t *)cv->data,
            (pthread_mutex_t *)m->data
        );
    }

    // Wait with a timeout in milliseconds. Returns true if woken (a signal —
    // or, as with Wait, a spurious wakeup: re-check the condition), false on
    // timeout or error.
    bool TimedWait(Cond *cv, Mutex *m, u64 ms)
    {
        if (!cv || !m) return false;
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        ts.tv_sec += ms / 1000;
        ts.tv_nsec += (ms % 1000) * 1000000;
        if (ts.tv_nsec >= 1000000000) {
            ts.tv_sec += 1;
            ts.tv_nsec -= 1000000000;
        }
        int res = pthread_cond_timedwait(
            (pthread_cond_t *)cv->data,
            (pthread_mutex_t *)m->data,
            &ts
        );
        return res == 0;
    }

    // Wake one thread waiting on this condition variable.
    void NotifyOne(Cond *cv)
    {
        if (!cv) return;
        pthread_cond_signal((pthread_cond_t *)cv->data);
    }

    // Wake all threads waiting on this condition variable.
    void NotifyAll(Cond *cv)
    {
        if (!cv) return;
        pthread_cond_broadcast((pthread_cond_t *)cv->data);
    }
}
