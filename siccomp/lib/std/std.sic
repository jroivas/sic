// The sic standard library (`import std;`), written in SIC and shipped with the
// compiler. It is an ordinary sic module (`module std;`): built separately with
// `sic --emit-module`, installed into the compiler's module sysroot, and linked
// in only when a unit says `import std;` (dynamically by default, or statically
// under `-static`). Nothing here is special to the compiler — `std.Fmt(a, b)` is a
// normal call to the function below, and all formatting is done in SIC by matching
// on each argument's runtime kind and taking its native representation.
module std;

extern int snprintf(char *s, unsigned long n, char *fmt, ...);
extern long write(int fd, void *buf, unsigned long n);

// One argument as a `string` the caller can read, dispatched on its runtime type
// (RTTI + `any` — no hand-written kind table). A `string`/`char*` argument is
// BORROWED — returned as a descriptor over the caller's own bytes, never copied
// (move semantics: the wrapper travels, the contents don't). The other kinds have
// no persistent string to borrow, so they format into a scope-local buffer and
// return it directly: a `string` view of a buffer that dies with the frame (a
// local array, or a bigint/fixed `.str` heap buffer) is copied automatically on
// return — no explicit `.dup`. `int` matches any signed-int width, `float` any
// float (category matching).
static string arg_str(any x) {
    match (type(x)) {
        string:
            return (string)x;       // borrow — no content copy

        cstr: {
            string s = (char *)x;   // borrow (view) — no content copy
            return s;
        }

        bigint:
            return ((bigint)x).str; // `.str` freed at scope exit → copied on return
        fixed:
            return ((fixed)x).str;

        bool: {
            return ((bool)x) ? "true" : "false";
        }

        int: {
            char b[32];
            snprintf(b, 32, "%lld", (long long)(i64)x);
            return b;
        }

        uint: {
            char b[32];
            snprintf(b, 32, "%llu", (unsigned long long)(u64)x);
            return b;
        }

        float: {
            char b[64];
            snprintf(b, 64, "%g", (double)x);
            return b;
        }

        ptr: {
            char b[32];
            snprintf(b, 32, "%p", (void *)x);
            return b;
        }

        _:
            return "<?>";
    }
}

// `Fmt("… {} …", a, b)` — `{}` placeholders (Python/Rust-style; `{{`/`}}` are
// literal braces), each substituted by the next argument formatted by its type.
string Fmt(string fmt, va_array args) {
    string result = "";
    char *f = fmt.ptr;
    u64 n = fmt.size;   // byte length
    u64 i = 0;
    u64 ai = 0;
    while (i < n) {
        char c = f[i];
        if (c == 123 && i + 1 < n && f[i + 1] == 123) {         // `{{` → literal `{`
            result = result + "{";
            i = i + 2;
        } else if (c == 125 && i + 1 < n && f[i + 1] == 125) {  // `}}` → literal `}`
            result = result + "}";
            i = i + 2;
        } else if (c == 123 && i + 1 < n && f[i + 1] == 125) {  // `{}` → next argument
            if (ai < args.length) {
                result = result + arg_str(args[ai]);
                ai = ai + 1;
            }
            i = i + 2;
        } else {                                                // any other byte, verbatim
            char one[2];
            one[0] = c;
            one[1] = 0;
            char *op = one;
            result = result + op;
            i = i + 1;
        }
    }
    return result;
}
