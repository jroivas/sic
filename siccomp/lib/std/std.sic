// The sic standard library (`import std;`), written in SIC and shipped with the
// compiler. It is an ordinary sic module (`module std;`): built separately with
// `sic --emit-module`, installed into the compiler's module sysroot, and linked
// in only when a unit says `import std;` (dynamically by default, or statically
// under `-static`). Nothing here is special to the compiler — `std.Fmt(a, b)` is a
// normal call to the function below, and all formatting is done in SIC by matching
// on each argument's runtime kind and taking its native representation.
module std;

extern int snprintf(char *s, unsigned long n, char *fmt, ...);
extern long write(int fd, void *buf, unsigned long n);

// The runtime kind of a value's type (`type(x).kind`), in the compiler's order.
enum Kind { VOID, BOOL, INT, UINT, F32, F64, F80, PTR, CSTR, STR, FIXED, ARRAY, STRUCT, UNION, ENUM, TUPLE, BIGINT, TYPE };

// One boxed argument formatted as an OWNED native string. `.dup` makes an owned
// heap copy, so a result built in a local `char` buffer (or a `.str` that is freed
// at scope exit) safely outlives this function — returning the view would dangle.
static string arg_str(any x) {
    switch (type(x).kind) {
        case STR:    return ((string)x).dup;
        case CSTR:   return ((char *)x).dup;
        case BIGINT: return ((bigint)x).str.dup;   // `.str` is auto-freed at scope exit
        case FIXED:  return ((fixed)x).str.dup;
        case BOOL:   if ((bool)x) return "true"; return "false";
        case INT:  { char b[32]; snprintf(b, 32, "%lld", (long long)(i64)x); return b.dup; }
        case UINT: { char b[32]; snprintf(b, 32, "%llu", (unsigned long long)(u64)x); return b.dup; }
        case F32: fallthrough;
        case F64: fallthrough;
        case F80:  { char b[64]; snprintf(b, 64, "%g", (double)x); return b.dup; }
        case PTR:  { char b[32]; snprintf(b, 32, "%p", (void *)x); return b.dup; }
        default:     return "<?>";
    }
}

// `Fmt("… {} …", a, b)` — `{}` placeholders (Python/Rust-style; `{{`/`}}` are
// literal braces), each substituted by the next argument formatted by its type.
string Fmt(string fmt, va_array args) {
    string result = "";
    char *f = fmt.ptr;
    u64 n = fmt.size;      // byte length
    u64 i = 0;
    u64 ai = 0;
    while (i < n) {
        char c = f[i];
        if (c == 123 && i + 1 < n && f[i + 1] == 123) { result = result + "{"; i = i + 2; }       // {{
        else if (c == 125 && i + 1 < n && f[i + 1] == 125) { result = result + "}"; i = i + 2; }  // }}
        else if (c == 123 && i + 1 < n && f[i + 1] == 125) {                                        // {}
            if (ai < args.length) { result = result + arg_str(args[ai]); ai = ai + 1; }
            i = i + 2;
        } else {
            char one[2]; one[0] = c; one[1] = 0; char *op = one; result = result + op; i = i + 1;
        }
    }
    return result;
}

// `Print(a, b, …)` — format each argument (no format string) and write to stdout.
int Print(va_array args) {
    string s = "";
    u64 i = 0;
    while (i < args.length) { s = s + arg_str(args[i]); i = i + 1; }
    write(1, s.ptr, s.size);
    return 0;
}

int Println(va_array args) {
    string s = "";
    u64 i = 0;
    while (i < args.length) { s = s + arg_str(args[i]); i = i + 1; }
    s = s + "\n";
    write(1, s.ptr, s.size);
    return 0;
}
